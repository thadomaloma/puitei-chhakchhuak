<% content_for :title, t("measurements.index_title") %>
<% filters_active = params[:query].present? || params[:template_id].present? || params[:archived] == "1" %>

<%= render "shared/page_header",
  eyebrow: t("measurements.library"),
  title: t("measurements.title"),
  description: t("measurements.library_description"),
  action: (link_to(ui_icon("plus", size: 17) + t("measurements.choose_customer"), customers_path, class: "button-primary") if policy(Customer).index?) %>

<section class="mt-5 grid grid-cols-2 gap-2 lg:grid-cols-4" aria-label="<%= t('measurements.library') %>">
  <%= render "shared/stat_card", label: t("measurements.active_profiles"), value: @summary[:active_profiles], detail: t("measurements.profile_directory"), icon: "ruler", tone: "neutral" %>
  <%= render "shared/stat_card", label: t("measurements.measured_customers"), value: @summary[:measured_customers], detail: t("customers.title"), icon: "customers", tone: "info" %>
  <%= render "shared/stat_card", label: t("measurements.saved_versions"), value: @summary[:versions], detail: t("measurements.history"), icon: "reports", tone: "premium" %>
  <%= render "shared/stat_card", label: t("measurements.updated_this_month"), value: @summary[:updated_this_month], detail: l(Date.current, format: "%B %Y"), icon: "calendar", tone: "success" %>
</section>

<section class="mt-5" aria-labelledby="measurement-directory-title">
  <div class="flex flex-wrap items-end justify-between gap-2">
    <div>
      <p class="eyebrow"><%= t("measurements.directory_eyebrow") %></p>
      <h2 id="measurement-directory-title" class="section-title mt-1"><%= t("measurements.profile_directory") %></h2>
    </div>
    <p class="text-xs tabular text-ink-muted"><%= t("measurements.profiles_found", count: @pagy.count) %></p>
  </div>

  <%= form_with url: measurements_path, method: :get, class: "toolbar mt-3", data: { turbo_frame: "measurement_profiles" } do |form| %>
    <div class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_12rem] xl:grid-cols-[minmax(0,1fr)_14rem_auto_auto]">
      <div class="relative min-w-0"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("measurements.search_placeholder"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("measurements.search_placeholder"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div>
      <div><%= form.label :template_id, t("measurements.garment"), class: "sr-only" %><%= form.select :template_id, options_from_collection_for_select(@measurement_templates, :id, :name, params[:template_id]), { include_blank: t("measurements.all_garments") }, class: "form-input mt-0" %></div>
      <label class="flex min-h-10 items-center gap-2 rounded-lg border border-line bg-surface px-3 text-xs font-medium text-ink-muted"><%= form.check_box :archived, { checked: params[:archived] == "1", class: "size-4 rounded border-line text-brand" }, "1", "0" %><%= t("measurements.include_archived") %></label>
      <div class="flex gap-2">
        <% if filters_active %><%= link_to t("measurements.clear_filters"), measurements_path, class: "button-ghost flex-1", data: { turbo_frame: "measurement_profiles" } %><% end %>
        <%= form.submit t("forms.search"), class: "button-secondary flex-1" %>
      </div>
    </div>
  <% end %>

  <%= turbo_frame_tag "measurement_profiles" do %>
    <% if @profiles.any? %>
      <div class="mt-3 grid gap-2.5 md:grid-cols-2 xl:hidden">
        <% @profiles.each do |profile| %>
          <% latest = profile.latest_measurement %>
          <%= link_to customer_measurement_profile_path(profile.customer, profile), class: "card group min-w-0 p-3.5", data: { turbo_frame: "_top" } do %>
            <div class="flex items-start gap-3">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-surface-muted text-emerald-refined"><%= ui_icon("ruler", size: 18) %></span>
              <span class="min-w-0 flex-1">
                <span class="flex min-w-0 items-center gap-2"><span class="truncate text-sm font-semibold tracking-[-0.01em] text-ink"><%= profile.customer.full_name %></span><%= status_badge(profile.active? ? "active" : "archived", label: t("measurements.#{profile.active? ? 'active' : 'archived'}"), variant: profile.active? ? "success" : "neutral") %></span>
                <span class="mt-1 block truncate text-xs text-ink-muted"><%= profile.measurement_template.name %> · <%= profile.name %></span>
                <span class="mt-1 block font-mono text-[10px] tracking-wide text-ink-muted"><%= profile.customer.customer_code %></span>
              </span>
              <span class="mt-1 text-ink-muted transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-ink"><%= ui_icon("chevron-right", size: 16) %></span>
            </div>
            <span class="mt-4 grid grid-cols-2 gap-2 border-t border-line pt-3">
              <span class="min-w-0"><span class="detail-label"><%= t("measurements.latest_version") %></span><% if latest %><span class="mt-1 block text-xs font-semibold text-ink"><%= t("measurements.version", version: latest.version) %></span><span class="mt-0.5 block truncate text-[10px] text-ink-muted"><%= l(latest.measured_on, format: :long) %></span><% else %><span class="mt-1 block text-xs text-ink-muted"><%= t("measurements.awaiting_first") %></span><% end %></span>
              <span class="text-right"><span class="detail-label"><%= t("measurements.history") %></span><span class="mt-1 block text-xs font-semibold text-ink"><%= t("measurements.versions", count: profile.measurements.size) %></span><span class="mt-0.5 block text-[10px] text-ink-muted"><%= profile.unit.humanize %></span></span>
            </span>
          <% end %>
        <% end %>
      </div>

      <div class="table-shell mt-3 hidden xl:block">
        <table class="data-table">
          <thead><tr><th><%= t("customers.customer") %></th><th><%= t("measurements.profile") %></th><th><%= t("measurements.latest_version") %></th><th><%= t("customers.branch") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead>
          <tbody>
            <% @profiles.each do |profile| %>
              <% latest = profile.latest_measurement %>
              <tr>
                <td><div class="flex items-center gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-full bg-surface-muted text-xs font-semibold text-ink"><%= initials_for(profile.customer.full_name) %></span><div><p class="font-medium text-ink"><%= profile.customer.full_name %></p><p class="font-mono text-[10px] tracking-wide text-ink-muted"><%= profile.customer.customer_code %></p></div></div></td>
                <td><div class="flex items-center gap-2.5"><span class="grid size-8 shrink-0 place-items-center rounded-lg bg-surface-muted text-emerald-refined"><%= ui_icon("ruler", size: 14) %></span><div class="min-w-0"><p class="font-medium text-ink"><%= profile.measurement_template.name %> · <%= profile.name %></p><p class="text-xs text-ink-muted"><%= profile.unit.humanize %> · <%= t("measurements.versions", count: profile.measurements.size) %></p></div><%= status_badge(profile.active? ? "active" : "archived", label: t("measurements.#{profile.active? ? 'active' : 'archived'}"), variant: profile.active? ? "success" : "neutral") %></div></td>
                <td><% if latest %><p class="font-medium text-ink"><%= t("measurements.version", version: latest.version) %></p><p class="text-xs text-ink-muted"><%= l(latest.measured_on, format: :long) %></p><% else %><span class="text-xs text-ink-muted"><%= t("measurements.awaiting_first") %></span><% end %></td>
                <td class="text-ink-muted"><%= profile.customer.branch.name %></td>
                <td class="text-right"><%= link_to customer_measurement_profile_path(profile.customer, profile), class: "button-ghost button-icon button-sm", data: { turbo_frame: "_top" }, aria: { label: t("forms.view") } do %><%= ui_icon("chevron-right", size: 15) %><% end %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if @pagy.previous || @pagy.next %><nav class="mt-4 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), measurements_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm", data: { turbo_frame: "measurement_profiles" } %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), measurements_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm", data: { turbo_frame: "measurement_profiles" } %><% end %></nav><% end %>
    <% else %>
      <div class="mt-3"><%= render "shared/empty_state", title: t("measurements.empty_library"), description: t("measurements.empty_library_description"), icon: "ruler", action: (link_to(t("measurements.clear_filters"), measurements_path, class: "button-secondary", data: { turbo_frame: "measurement_profiles" }) if filters_active) %></div>
    <% end %>
  <% end %>
</section>
