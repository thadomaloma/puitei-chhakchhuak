<% content_for :title, t("measurements.version", version: @measurement.version) %>
<%= render "shared/back_link", path: customer_measurement_profile_path(@customer, @profile), label: @profile.name %>

<div class="mt-3"><%= render "shared/page_header", eyebrow: "#{@profile.measurement_template.name} · #{@profile.unit.humanize}", title: t("measurements.version", version: @measurement.version), description: "#{@customer.full_name} · #{l(@measurement.measured_on, format: :long)}", action: (link_to(t("measurements.copy_to_new"), new_customer_measurement_profile_measurement_path(@customer, @profile, copy_from_id: @measurement.id), class: "button-primary") if policy(@profile).create? && @profile.active?) %></div>

<div class="mt-4 flex gap-3 rounded-xl border border-line bg-surface-muted/60 p-3.5 text-xs text-ink-muted"><%= ui_icon("check", size: 17, class_name: "mt-0.5 text-emerald-refined") %><div><p class="font-semibold text-ink"><%= t("measurements.immutable_title") %></p><p class="mt-1"><%= @associated_order_items.any? ? t("measurements.immutable_used_description") : t("measurements.immutable_description") %></p></div></div>

<section class="mt-5 grid grid-cols-2 gap-2 lg:grid-cols-4" aria-label="<%= t('measurements.key_measurements') %>"><% @profile.measurement_template.measurement_fields.first(4).each do |field| %><article class="metric-card"><p class="text-xs font-medium text-ink-muted"><%= field.label %></p><p class="metric-value"><%= @measurement.values[field.key].presence || "—" %> <span class="text-xs font-medium text-ink-muted"><%= @profile.unit == "inches" ? "in" : "cm" %></span></p></article><% end %></section>

<div class="mt-5 grid gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-4">
    <% grouped_measurement_fields(@profile.measurement_template).each do |group, fields| %><section class="section-card"><h2 class="section-title"><%= t("measurements.field_groups.#{group}") %></h2><dl class="mt-4 grid grid-cols-2 gap-2.5 sm:grid-cols-3"><% fields.each do |field| %><div class="rounded-lg bg-surface-muted/55 p-3"><dt class="text-xs text-ink-muted"><%= field.label %></dt><dd class="mt-1 tabular text-lg font-semibold text-ink"><%= @measurement.values[field.key].presence || "—" %> <span class="text-[10px] font-medium text-ink-muted"><%= @profile.unit == "inches" ? "in" : "cm" %></span></dd></div><% end %></dl></section><% end %>

    <% if @value_changes.any? %><section class="section-card"><div><h2 class="section-title"><%= t("measurements.changed_values") %></h2><p class="supporting-text"><%= t("measurements.changed_values_description", version: @previous_measurement.version) %></p></div><div class="mt-4 divide-y divide-line"><% @value_changes.each do |change| %><div class="grid grid-cols-[minmax(0,1fr)_auto_auto] items-center gap-3 py-2.5 first:pt-0 last:pb-0"><p class="text-xs font-medium text-ink"><%= change[:label] %></p><span class="tabular text-xs text-ink-muted line-through"><%= change[:previous].presence || "—" %></span><span class="tabular text-xs font-semibold text-emerald-refined"><%= change[:current].presence || "—" %></span></div><% end %></div></section><% end %>

    <section class="section-card"><h2 class="section-title"><%= t("measurements.fitting_and_notes") %></h2><dl class="mt-4 grid gap-4 md:grid-cols-2"><div><dt class="detail-label"><%= t("measurement_profiles.fitting_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.fitting_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.posture_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.posture_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.preferences") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.preferences.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("customers.notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @measurement.notes.presence || "—" %></dd></div></dl></section>

    <% if @measurement.photos.attached? %><section><h2 class="section-title"><%= t("measurements.photos") %></h2><div class="mt-3 grid grid-cols-2 gap-2.5 md:grid-cols-4"><% @measurement.photos.each do |photo| %><%= image_tag photo.variant(:thumb), alt: t("measurements.reference_photo_alt"), class: "aspect-square w-full rounded-xl border border-line object-cover" %><% end %></div></section><% end %>
  </div>

  <aside class="space-y-4 self-start xl:sticky xl:top-20">
    <section class="section-card"><h2 class="section-title"><%= t("measurements.record_details") %></h2><dl class="mt-4 space-y-3"><div><dt class="detail-label"><%= t("measurements.taken_by_label") %></dt><dd class="detail-value"><%= @measurement.created_by.name %></dd></div><div><dt class="detail-label"><%= t("measurements.created_at") %></dt><dd class="detail-value tabular"><%= l(@measurement.created_at, format: :long) %></dd></div><div><dt class="detail-label"><%= t("measurements.source") %></dt><dd class="detail-value"><%= @measurement.copied_from ? t("measurements.version", version: @measurement.copied_from.version) : t("measurements.original_entry") %></dd></div></dl></section>
    <section class="section-card"><h2 class="section-title"><%= t("measurements.associated_orders") %></h2><% if @associated_order_items.any? %><div class="mt-3 divide-y divide-line"><% @associated_order_items.each do |item| %><%= link_to item.order, class: "flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0" do %><span><span class="block font-mono text-xs font-semibold text-brand"><%= item.order.order_number %></span><span class="mt-0.5 block text-[10px] text-ink-muted"><%= item.garment_name %></span></span><%= ui_icon("chevron-right", size: 14, class_name: "text-ink-muted") %><% end %><% end %></div><% else %><p class="mt-3 text-xs text-ink-muted"><%= t("measurements.not_used_in_order") %></p><% end %></section>
    <section class="section-card"><h2 class="section-title"><%= t("measurements.history") %></h2><div class="mt-3 divide-y divide-line"><% @history.each do |measurement| %><%= link_to customer_measurement_profile_measurement_path(@customer, @profile, measurement), class: "flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0" do %><span><span class="block text-xs font-semibold text-ink"><%= t("measurements.version", version: measurement.version) %></span><span class="mt-0.5 block text-[10px] text-ink-muted"><%= l(measurement.measured_on) %> · <%= measurement.created_by.name %></span></span><%= ui_icon("chevron-right", size: 14, class_name: "text-ink-muted") %><% end %><% end %></div></section>
  </aside>
</div>
