<% content_for :title, t("measurements.new") %>
<%= render "shared/back_link", path: customer_measurement_profile_path(@customer, @profile), label: @profile.name %>
<div class="mt-3 max-w-6xl"><%= render "shared/page_header", eyebrow: @profile.measurement_template.name, title: t("measurements.new"), description: "#{@customer.full_name} · #{@profile.name} · #{@profile.unit.humanize}" %></div>

<% if @source_measurement %><div class="mt-4 flex gap-3 rounded-xl border border-[#fedf89] bg-[#fffaeb] p-3.5 text-xs text-[#93370d]"><%= ui_icon("reports", size: 17, class_name: "mt-0.5") %><div><p class="font-semibold"><%= t("measurements.copied_from", version: @source_measurement.version) %></p><p class="mt-1 opacity-85"><%= t("measurements.copy_preserves_history") %></p></div></div><% end %>

<%= form_with model: [@customer, @profile, @measurement], class: "mt-5 max-w-6xl space-y-5" do |form| %>
  <%= render "shared/form_errors", record: @measurement %>
  <%= form.hidden_field :copied_from_id %>

  <section class="form-section">
    <div><p class="eyebrow"><%= t("measurements.steps.profile") %></p><h2 class="section-title mt-1"><%= t("measurements.profile_and_garment") %></h2><p class="supporting-text"><%= t("measurements.profile_and_garment_description") %></p></div>
    <dl class="mt-4 grid gap-4 rounded-xl bg-surface-muted/55 p-4 sm:grid-cols-2 lg:grid-cols-4"><div><dt class="detail-label"><%= t("customers.customer") %></dt><dd class="detail-value"><%= @customer.full_name %></dd></div><div><dt class="detail-label"><%= t("measurements.profile") %></dt><dd class="detail-value"><%= @profile.name %></dd></div><div><dt class="detail-label"><%= t("measurements.garment") %></dt><dd class="detail-value"><%= @profile.measurement_template.name %></dd></div><div><dt class="detail-label"><%= t("measurements.taken_by_label") %></dt><dd class="detail-value"><%= current_user.name %></dd></div></dl>
    <div class="mt-4 max-w-sm"><%= form.label :measured_on, class: "form-label" %><%= form.date_field :measured_on, required: true, max: Date.current, class: "form-input" %></div>
  </section>

  <% grouped_measurement_fields(@profile.measurement_template).each do |group, fields| %>
    <section class="form-section">
      <div><p class="eyebrow"><%= t("measurements.steps.values") %></p><h2 class="section-title mt-1"><%= t("measurements.field_groups.#{group}") %></h2><p class="supporting-text"><%= t("measurements.active_unit", unit: @profile.unit.humanize) %></p></div>
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <% fields.each do |field| %>
          <div><%= label_tag "measurement_values_#{field.key}", class: "form-label" do %><%= field.label %><% if field.required? %><span class="text-[#b42318]" aria-hidden="true"> *</span><span class="sr-only"><%= t("measurements.required") %></span><% end %><% end %><div class="relative"><%= number_field_tag "measurement[values][#{field.key}]", @measurement.values[field.key], id: "measurement_values_#{field.key}", required: field.required?, min: 0.01, max: 10000, step: "0.01", inputmode: "decimal", class: "form-input min-h-12 pr-14 text-lg font-semibold tabular" %><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-ink-muted"><%= @profile.unit == "inches" ? "in" : "cm" %></span></div><% if @source_measurement&.values&.key?(field.key) %><p class="form-hint"><%= t("measurements.previous_value", value: @source_measurement.values[field.key], unit: (@profile.unit == "inches" ? "in" : "cm")) %></p><% end %></div>
        <% end %>
      </div>
    </section>
  <% end %>

  <section class="form-section">
    <div><p class="eyebrow"><%= t("measurements.steps.fitting") %></p><h2 class="section-title mt-1"><%= t("measurements.fitting_preferences") %></h2><p class="supporting-text"><%= t("measurements.fitting_preferences_description") %></p></div>
    <dl class="mt-4 grid gap-4 sm:grid-cols-3"><div><dt class="detail-label"><%= t("measurement_profiles.fitting_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.fitting_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.posture_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.posture_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.preferences") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.preferences.presence || "—" %></dd></div></dl>
  </section>

  <section class="form-section" data-controller="image-preview">
    <div><p class="eyebrow"><%= t("measurements.steps.notes") %></p><h2 class="section-title mt-1"><%= t("measurements.notes_and_photos") %></h2><p class="supporting-text"><%= t("measurements.notes_and_photos_description") %></p></div>
    <div class="mt-4"><%= form.label :notes, class: "form-label" %><%= form.text_area :notes, rows: 4, class: "form-textarea", placeholder: t("measurements.notes_placeholder") %></div>
    <div class="mt-5"><%= form.label :photos, t("measurements.photos"), class: "form-label" %><%= form.file_field :photos, multiple: true, accept: "image/jpeg,image/png,image/webp", capture: "environment", class: "file-input", data: { image_preview_target: "input", action: "change->image-preview#preview" } %><p class="form-hint"><%= t("measurements.photo_hint") %></p><div class="mt-3 hidden grid-cols-2 gap-2.5 sm:grid-cols-4" data-image-preview-target="gallery" aria-live="polite"></div></div>
  </section>

  <div class="sticky-actions justify-end"><%= link_to t("forms.cancel"), customer_measurement_profile_path(@customer, @profile), class: "button-secondary flex-1 sm:flex-none" %><%= form.submit t("measurements.save_version"), class: "button-primary flex-1 sm:flex-none" %></div>
<% end %>
