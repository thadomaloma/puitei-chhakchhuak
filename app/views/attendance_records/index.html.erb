<% content_for :title, t("attendance.index_title") %>
<%= render "shared/page_header", eyebrow: t("staff.eyebrow"), title: t("attendance.title"), description: t("attendance.description"), action: (link_to(t("staff.directory"), staff_index_path, class: "button-secondary") if policy(User).index?) %>

<section class="section-card mt-5"><div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><div><h2 class="section-title"><%= t("attendance.today") %></h2><p class="supporting-text"><%= l(Date.current, format: :long) %></p></div><% if @today_record.nil? %><%= form_with url: check_in_attendance_records_path, class: "flex flex-wrap items-end gap-2" do |form| %><div><%= form.label :notes, t("attendance.note_optional"), class: "sr-only" %><%= form.text_field :notes, name: "attendance_record[notes]", class: "form-input mt-0", placeholder: t("attendance.note_optional") %></div><%= form.submit t("attendance.check_in"), class: "button-primary" %><% end %><% elsif !@today_record.checked_out? %><div class="flex flex-wrap items-center gap-2"><p class="text-xs text-ink-muted"><%= t("attendance.checked_in_at", time: l(@today_record.checked_in_at, format: :short)) %></p><%= button_to t("attendance.check_out"), check_out_attendance_record_path(@today_record), method: :patch, class: "button-primary", data: { turbo_confirm: t("attendance.checkout_confirm") } %></div><% else %><div class="text-right"><%= status_badge("completed", label: t("attendance.day_complete"), variant: "success") %><p class="mt-1 text-xs text-ink-muted"><%= t("attendance.hours", hours: number_with_precision(@today_record.duration_hours, precision: 1)) %></p></div><% end %></div></section>

<% if @staff_options %><%= form_with url: attendance_records_path, method: :get, class: "toolbar mt-4 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_auto]" do |form| %><%= form.select :user_id, @staff_options.map { |member| [ member.name, member.id ] }, { include_blank: t("staff.all_staff"), selected: params[:user_id] }, class: "form-select mt-0", aria: { label: t("staff.staff_member") } %><%= form.date_field :date, value: params[:date], class: "form-input mt-0", aria: { label: t("attendance.date") } %><%= form.submit t("forms.search"), class: "button-secondary" %><% end %><% end %>

<% if @attendance_records.any? %><div class="table-shell mt-4 hidden md:block"><table class="data-table"><thead><tr><th><%= t("staff.staff_member") %></th><th><%= t("attendance.date") %></th><th><%= t("attendance.check_in") %></th><th><%= t("attendance.check_out") %></th><th class="text-right"><%= t("attendance.duration") %></th></tr></thead><tbody><% @attendance_records.each do |record| %><tr><td><%= link_to record.user.name, staff_path(record.user), class: "font-semibold text-ink" %><p class="font-mono text-[10px] text-ink-muted"><%= record.user.employee_code %></p></td><td class="tabular text-ink-muted"><%= l(record.work_date) %></td><td class="tabular text-ink-muted"><%= l(record.checked_in_at, format: :short) %></td><td class="tabular text-ink-muted"><%= record.checked_out_at ? l(record.checked_out_at, format: :short) : t("attendance.in_progress") %></td><td class="tabular text-right font-semibold text-ink"><%= record.checked_out? ? t("attendance.hours", hours: number_with_precision(record.duration_hours, precision: 1)) : "—" %></td></tr><% end %></tbody></table></div><div class="mt-4 space-y-2 md:hidden"><% @attendance_records.each do |record| %><div class="card min-w-0 p-3.5"><div class="flex items-start justify-between gap-3"><div class="min-w-0"><%= link_to record.user.name, staff_path(record.user), class: "truncate text-sm font-semibold text-ink" %><p class="mt-0.5 text-[11px] text-ink-muted"><%= l(record.work_date, format: :long) %></p></div><%= status_badge(record.checked_out? ? "completed" : "in_progress", label: record.checked_out? ? t("attendance.day_complete") : t("attendance.in_progress"), variant: record.checked_out? ? "success" : "info") %></div><div class="mt-2.5 grid grid-cols-3 gap-2 border-t border-line pt-2.5 text-[11px]"><div><p class="text-ink-muted"><%= t("attendance.check_in") %></p><p class="mt-0.5 tabular font-medium text-ink"><%= l(record.checked_in_at, format: :short) %></p></div><div><p class="text-ink-muted"><%= t("attendance.check_out") %></p><p class="mt-0.5 tabular font-medium text-ink"><%= record.checked_out_at ? l(record.checked_out_at, format: :short) : "—" %></p></div><div class="text-right"><p class="text-ink-muted"><%= t("attendance.duration") %></p><p class="mt-0.5 tabular font-semibold text-ink"><%= record.checked_out? ? t("attendance.hours", hours: number_with_precision(record.duration_hours, precision: 1)) : "—" %></p></div></div></div><% end %></div><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("attendance.empty"), description: t("attendance.empty_description"), icon: "clock" %></div><% end %>
