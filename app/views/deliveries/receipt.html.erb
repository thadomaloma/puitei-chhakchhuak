<% content_for :title, "#{t('deliveries.delivery_receipt')} · #{@delivery.delivery_number}" %>
<main class="mx-auto max-w-2xl p-6 sm:p-10"><div class="print-hidden mb-6 flex justify-between"><%= link_to "← #{@delivery.delivery_number}", @delivery, class: "button-secondary" %><button type="button" data-controller="print" data-action="print#print" class="button-primary"><%= t("deliveries.print_receipt") %></button></div><header class="border-b-2 border-stone-900 pb-5 text-center"><p class="text-sm font-bold uppercase tracking-[0.2em]"><%= @delivery.branch.shop_setting.shop_name %></p><p class="mt-1 whitespace-pre-line text-xs text-stone-600"><%= @delivery.branch.shop_setting.address %></p><% if @delivery.branch.shop_setting.phone.present? %><p class="text-xs text-stone-600"><%= @delivery.branch.shop_setting.phone %></p><% end %><h1 class="mt-5 text-3xl font-black"><%= t("deliveries.delivery_receipt") %></h1><p class="mt-1 font-mono font-bold"><%= @delivery.delivery_number %></p></header><section class="grid grid-cols-2 gap-5 border-b border-stone-300 py-5 text-sm"><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("customers.customer") %></p><p class="mt-1 font-bold"><%= @delivery.customer.full_name %></p><p><%= @delivery.customer.phone_number %></p></div><div class="text-right"><p class="text-xs font-bold uppercase text-stone-500"><%= t("orders.title") %></p><p class="mt-1 font-mono font-bold"><%= @delivery.order.order_number %></p><p><%= t("orders.garments", count: @delivery.order.order_items.sum(&:quantity)) %></p></div></section><section class="border-b border-stone-300 py-5 text-sm"><h2 class="text-xs font-bold uppercase text-stone-500"><%= t("deliveries.items_delivered") %></h2><table class="mt-3 w-full border-collapse text-sm"><thead><tr class="border-b border-stone-300 text-left text-xs uppercase text-stone-500"><th class="py-1.5 font-bold"><%= t("deliveries.item_garment") %></th><th class="py-1.5 text-right font-bold"><%= t("deliveries.item_quantity") %></th></tr></thead><tbody><% @delivery.order.order_items.each do |item| %><tr class="border-b border-stone-100"><td class="py-1.5"><%= item.garment_name %></td><td class="py-1.5 text-right tabular font-semibold"><%= item.quantity %></td></tr><% end %></tbody></table></section><section class="py-5 text-sm"><h2 class="text-xs font-bold uppercase text-stone-500"><%= t("deliveries.handover_details") %></h2><dl class="mt-3 grid grid-cols-2 gap-4"><div><dt class="text-xs text-stone-500"><%= t("deliveries.recipient_name") %></dt><dd class="font-bold"><%= @delivery.recipient_name %></dd></div><div><dt class="text-xs text-stone-500"><%= t("deliveries.collection_method") %></dt><dd class="font-bold"><%= t("deliveries.collection_methods.#{@delivery.collection_method}") %></dd></div><div><dt class="text-xs text-stone-500"><%= t("deliveries.handed_over_at") %></dt><dd class="font-bold"><%= l(@delivery.handed_over_at, format: :long) %></dd></div><div><dt class="text-xs text-stone-500"><%= t("deliveries.acknowledged_by") %></dt><dd class="font-bold"><%= @delivery.acknowledged_by %></dd></div></dl></section><dl class="border-y border-stone-300 py-4 text-sm"><div class="flex justify-between"><dt><%= t("payments.total") %></dt><dd class="font-bold"><%= money(@delivery.total_amount_snapshot, @delivery.currency) %></dd></div><div class="mt-2 flex justify-between"><dt><%= t("payments.paid") %></dt><dd class="font-bold"><%= money(@delivery.paid_amount_snapshot, @delivery.currency) %></dd></div><div class="mt-2 flex justify-between"><dt><%= t("payments.balance") %></dt><dd class="font-bold"><%= money(@delivery.balance_due_snapshot, @delivery.currency) %></dd></div></dl><section class="mt-10 grid grid-cols-2 gap-10 text-sm"><div class="border-t border-stone-500 pt-2"><%= t("deliveries.recipient_signature") %></div><div class="border-t border-stone-500 pt-2"><%= t("deliveries.delivered_by") %>: <%= @delivery.delivered_by.name %></div></section><footer class="mt-6 border-t border-stone-200 pt-4 text-center"><p class="text-xs font-semibold text-stone-600"><%= t("deliveries.thank_you") %></p><p class="mt-1 text-[11px] text-stone-400"><%= @delivery.branch.name %></p></footer></main>
