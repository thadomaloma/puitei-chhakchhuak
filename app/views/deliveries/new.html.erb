<% content_for :title, t("deliveries.complete_handover") %>
<%= render "shared/back_link", path: deliveries_path, label: t("deliveries.desk") %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("deliveries.eyebrow"), title: t("deliveries.complete_handover"), description: t("deliveries.new_description", customer: @order.customer.full_name), action: link_to(t("orders.view_order"), @order, class: "button-secondary") %></div>

<section class="section-card mx-auto mt-5 max-w-5xl overflow-hidden p-0"><div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5"><div class="min-w-0"><p class="font-mono text-[11px] font-semibold text-brand"><%= @order.order_number %></p><h2 class="mt-1 truncate text-lg font-semibold text-ink"><%= @order.customer.full_name %></h2><p class="mt-1 text-xs text-ink-muted"><%= @order.customer.phone_number %> · <%= t("orders.garments", count: @order.order_items.sum(&:quantity)) %> · <%= @order.order_items.map(&:garment_name).join(", ") %></p></div><%= status_badge("ready", label: t("dashboard.order_states.ready"), variant: "success") %></div><dl class="grid grid-cols-3 gap-px border-t border-line bg-line"><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.total") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= money(@order.total_amount, @order.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.paid") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-emerald-refined"><%= money(@order.paid_amount, @order.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold <%= @order.balance_due.positive? ? 'text-[#b42318]' : 'text-emerald-refined' %>"><%= money(@order.balance_due, @order.currency) %></dd></div></dl></section>

<% if @order.balance_due.positive? %><div class="mx-auto mt-4 flex max-w-5xl gap-3 rounded-xl border border-[#fedf89] bg-[#fffaeb] p-4 text-xs text-[#93370d]"><%= ui_icon("warning", size: 18, class_name: "mt-0.5") %><p><strong><%= t("deliveries.outstanding_warning") %></strong><br><%= t("deliveries.outstanding_warning_description") %></p></div><% end %>

<%= form_with model: [@order, @delivery], url: order_delivery_path(@order), class: "mx-auto mt-4 max-w-5xl space-y-4", data: { controller: "handover-checklist image-preview" } do |form| %>
  <%= render "shared/form_errors", record: @delivery %>
  <section class="form-section"><div><p class="eyebrow"><%= t("deliveries.recipient_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.recipient_details") %></h2><p class="supporting-text mt-1"><%= t("deliveries.recipient_details_description") %></p></div><div class="mt-4 grid gap-4 sm:grid-cols-2"><div><%= form.label :recipient_name, t("deliveries.recipient_name"), class: "text-xs font-semibold text-ink" %><%= form.text_field :recipient_name, class: "form-input", required: true, autocomplete: "name" %></div><div><%= form.label :recipient_phone, t("deliveries.recipient_phone"), class: "text-xs font-semibold text-ink" %><%= form.telephone_field :recipient_phone, class: "form-input", autocomplete: "tel", inputmode: "tel" %></div><div><%= form.label :collection_method, t("deliveries.collection_method"), class: "text-xs font-semibold text-ink" %><%= form.select :collection_method, Delivery.collection_methods.keys.map { |method| [t("deliveries.collection_methods.#{method}"), method] }, {}, class: "form-input", required: true %></div><div><%= form.label :recipient_relationship, t("deliveries.recipient_relationship"), class: "text-xs font-semibold text-ink" %><%= form.text_field :recipient_relationship, class: "form-input", placeholder: t("deliveries.relationship_placeholder") %></div><div><%= form.label :handed_over_at, t("deliveries.handed_over_at"), class: "text-xs font-semibold text-ink" %><%= form.datetime_local_field :handed_over_at, class: "form-input", max: Time.current.strftime("%Y-%m-%dT%H:%M"), required: true %></div><div><%= form.label :acknowledged_by, t("deliveries.acknowledged_by"), class: "text-xs font-semibold text-ink" %><%= form.text_field :acknowledged_by, class: "form-input", required: true %><p class="mt-1 text-[11px] text-ink-muted"><%= t("deliveries.acknowledgement_hint") %></p></div></div></section>
  <section class="form-section"><div class="flex items-end justify-between gap-3"><div><p class="eyebrow"><%= t("deliveries.release_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.final_checklist") %></h2><p class="supporting-text mt-1"><%= t("deliveries.final_checklist_description") %></p></div><span class="status-badge status-info" data-handover-checklist-target="count">0/5</span></div><div class="mt-4 h-1.5 overflow-hidden rounded-full bg-surface-muted"><div class="h-full w-0 rounded-full bg-emerald-refined transition-[width] duration-200" data-handover-checklist-target="progress"></div></div><div class="mt-4 grid gap-2 sm:grid-cols-2"><% { quality_checked: "quality_checked", garment_count_verified: "garment_count_verified", payment_status_confirmed: "payment_status_confirmed", packaging_complete: "packaging_complete", recipient_acknowledged: "recipient_acknowledged" }.each do |attribute, key| %><label class="flex min-h-14 items-start gap-3 rounded-xl border border-line bg-surface-muted/45 p-3 text-xs font-medium text-ink transition has-[:checked]:border-[#abefc6] has-[:checked]:bg-[#ecfdf3]"><%= form.check_box attribute, class: "mt-0.5 size-4 rounded border-line text-brand", required: true, data: { handover_checklist_target: "item", action: "change->handover-checklist#update" } %><span><%= t("deliveries.checklist.#{key}") %></span></label><% end %></div></section>
  <section class="form-section"><div><p class="eyebrow"><%= t("deliveries.evidence_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.proof_notes") %></h2><p class="supporting-text mt-1"><%= t("deliveries.proof_notes_description") %></p></div><div class="mt-4"><%= form.label :proof_images, t("deliveries.proof_images"), class: "text-xs font-semibold text-ink" %><%= form.file_field :proof_images, multiple: true, accept: "image/jpeg,image/png,image/webp", capture: "environment", class: "file-input", data: { image_preview_target: "input", action: "change->image-preview#preview" } %><p class="mt-1 text-[11px] text-ink-muted"><%= t("deliveries.proof_hint") %></p><div class="mt-3 hidden grid-cols-2 gap-2 sm:grid-cols-4" data-image-preview-target="gallery"></div></div><div class="mt-4"><%= form.label :notes, t("customers.notes"), class: "text-xs font-semibold text-ink" %><%= form.text_area :notes, rows: 4, class: "form-input", placeholder: t("deliveries.notes_placeholder") %></div></section>
  <div class="sticky-actions"><%= link_to t("forms.cancel"), @order, class: "button-secondary flex-1 sm:flex-none" %><%= form.submit t("deliveries.confirm_delivery"), class: "button-primary flex-1 sm:flex-none", disabled: true, data: { handover_checklist_target: "submit", turbo_confirm: t("deliveries.confirm_prompt") } %></div>
<% end %>
