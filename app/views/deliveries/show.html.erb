<% content_for :title, @delivery.delivery_number %>
<%= render "shared/back_link", path: deliveries_path, label: t("deliveries.desk") %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("deliveries.completed_eyebrow"), title: @delivery.delivery_number, description: t("deliveries.record_description", customer: @delivery.customer.full_name, date: l(@delivery.handed_over_at, format: :long)), action: link_to(t("deliveries.print_receipt"), receipt_delivery_path(@delivery), class: "button-primary") %></div>

<section class="section-card mt-5 overflow-hidden border-[#abefc6] p-0"><div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f4f7f1_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><%= status_badge("delivered", label: t("orders.statuses.delivered"), variant: "success") %><span class="text-[11px] font-medium text-ink-muted"><%= t("deliveries.collection_methods.#{@delivery.collection_method}") %></span></div><h1 class="mt-3 truncate text-2xl font-semibold tracking-[-0.03em] text-ink"><%= @delivery.recipient_name %></h1><p class="mt-1 text-xs text-ink-muted"><%= t("deliveries.handed_to", name: @delivery.recipient_name, date: l(@delivery.handed_over_at, format: :long)) %></p></div><div class="sm:text-right"><p class="detail-label"><%= t("dashboard.order") %></p><%= link_to @delivery.order.order_number, @delivery.order, class: "mt-1 block font-mono text-xs font-semibold text-brand" %><p class="mt-2 text-sm font-semibold text-ink"><%= link_to @delivery.customer.full_name, @delivery.customer, class: "hover:text-emerald-refined" %></p><p class="text-xs text-ink-muted"><%= @delivery.customer.phone_number %></p></div></div><dl class="grid grid-cols-3 gap-px border-t border-line bg-line"><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.total") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= money(@delivery.total_amount_snapshot, @delivery.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.paid") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-emerald-refined"><%= money(@delivery.paid_amount_snapshot, @delivery.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold <%= @delivery.balance_due_snapshot.positive? ? 'text-[#b42318]' : 'text-emerald-refined' %>"><%= money(@delivery.balance_due_snapshot, @delivery.currency) %></dd></div></dl></section>

<% if @delivery.balance_due_snapshot.positive? %><div class="mt-4 rounded-xl border border-[#fedf89] bg-[#fffaeb] p-4 text-xs font-medium text-[#93370d]"><%= t("deliveries.manager_approved_balance") %></div><% end %>

<div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]"><div class="space-y-4"><section class="section-card"><div><p class="eyebrow"><%= t("deliveries.recipient_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.recipient_details") %></h2></div><dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="detail-label"><%= t("deliveries.recipient_name") %></dt><dd class="detail-value"><%= @delivery.recipient_name %></dd></div><div><dt class="detail-label"><%= t("deliveries.recipient_phone") %></dt><dd class="detail-value"><%= @delivery.recipient_phone.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("deliveries.collection_method") %></dt><dd class="detail-value"><%= t("deliveries.collection_methods.#{@delivery.collection_method}") %></dd></div><div><dt class="detail-label"><%= t("deliveries.recipient_relationship") %></dt><dd class="detail-value"><%= @delivery.recipient_relationship.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("deliveries.acknowledged_by") %></dt><dd class="detail-value"><%= @delivery.acknowledged_by %></dd></div><div><dt class="detail-label"><%= t("deliveries.delivered_by") %></dt><dd class="detail-value"><%= @delivery.delivered_by.name %></dd></div></dl></section>
<section class="section-card"><div><p class="eyebrow"><%= t("deliveries.release_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.final_checklist") %></h2></div><div class="mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-3"><% %w[quality_checked garment_count_verified payment_status_confirmed packaging_complete recipient_acknowledged].each do |key| %><div class="flex min-h-12 items-start gap-2 rounded-xl border border-[#abefc6] bg-[#ecfdf3] p-3 text-xs font-medium text-[#067647]"><%= ui_icon("check", size: 15, class_name: "mt-0.5") %><span><%= t("deliveries.checklist.#{key}") %></span></div><% end %></div></section>
<% if @delivery.proof_images.any? || @delivery.notes.present? %><section class="section-card"><div><p class="eyebrow"><%= t("deliveries.evidence_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.proof_notes") %></h2></div><% if @delivery.proof_images.any? %><div class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-4"><% @delivery.proof_images.each do |image| %><%= image_tag image, alt: t("deliveries.proof_image_alt"), class: "aspect-square w-full rounded-xl border border-line object-cover" %><% end %></div><% end %><% if @delivery.notes.present? %><p class="mt-4 whitespace-pre-line text-sm leading-6 text-ink-muted"><%= @delivery.notes %></p><% end %></section><% end %></div>
<aside class="space-y-4"><section class="form-section"><p class="eyebrow"><%= t("deliveries.record_eyebrow") %></p><h2 class="section-title mt-1"><%= t("deliveries.immutable_record") %></h2><p class="supporting-text mt-1"><%= t("deliveries.immutable_record_description") %></p><dl class="mt-4 space-y-3 border-t border-line pt-4"><div><dt class="detail-label"><%= t("deliveries.handed_over_at") %></dt><dd class="detail-value tabular"><%= l(@delivery.handed_over_at, format: :long) %></dd></div><div><dt class="detail-label"><%= t("deliveries.delivered_by") %></dt><dd class="detail-value"><%= @delivery.delivered_by.name %></dd></div><div><dt class="detail-label"><%= t("deliveries.delivery_record") %></dt><dd class="mt-1 font-mono text-xs font-semibold text-ink"><%= @delivery.delivery_number %></dd></div></dl></section></aside></div>
