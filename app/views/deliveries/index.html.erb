<% content_for :title, t("deliveries.index_title") %>
<%= render "shared/page_header", eyebrow: t("deliveries.eyebrow"), title: t("deliveries.desk"), description: t("deliveries.directory_description", ready: @ready_count) %>

<section class="mt-5 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <%= render "shared/stat_card", label: t("deliveries.ready"), value: @ready_count, detail: t("deliveries.ready_description"), icon: "check", tone: "success", href: deliveries_path(view: "ready") %>
  <%= render "shared/stat_card", label: t("deliveries.overdue"), value: @overdue_count, detail: t("deliveries.overdue_description"), icon: "warning", tone: (@overdue_count.positive? ? "danger" : "neutral"), href: deliveries_path(view: "overdue") %>
  <%= render "shared/stat_card", label: t("deliveries.completed_today"), value: @delivered_today_count, detail: l(Date.current), icon: "delivery", tone: "info", href: deliveries_path(view: "delivered", from: Date.current, to: Date.current) %>
  <%= render "shared/stat_card", label: t("deliveries.outstanding_ready"), value: money(@outstanding_ready), detail: t("deliveries.balance_review"), icon: "payments", tone: (@outstanding_ready.positive? ? "warning" : "success"), href: deliveries_path(view: "outstanding") %>
</section>

<%= render "desktop_filter_bar" %>
<%= form_with url: deliveries_path, method: :get, class: "toolbar mt-5 xl:hidden", data: { controller: "mobile-menu", action: "keydown.esc@window->mobile-menu#close" } do |form| %>
  <div class="grid gap-2"><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("deliveries.search"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("deliveries.search"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div><div class="grid grid-cols-2 gap-2"><button type="button" class="button-secondary" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="delivery-filter-panel" aria-expanded="false"><%= ui_icon("settings", size: 16) %><%= t("deliveries.filters") %></button><%= form.submit t("production.filter"), class: "button-primary" %></div></div>
  <div id="delivery-filter-panel" class="hidden" data-mobile-menu-target="panel" hidden aria-hidden="true"><button type="button" class="fixed inset-0 z-40 bg-ink/30 backdrop-blur-[2px]" aria-label="<%= t('forms.close') %>" data-action="mobile-menu#close"></button><section role="dialog" aria-modal="true" aria-label="<%= t('deliveries.filters') %>" class="fixed inset-x-0 bottom-0 z-50 max-h-[88vh] overflow-y-auto rounded-t-2xl border border-line bg-surface p-4 shadow-2xl"><div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong"></div><div class="flex items-center justify-between"><div><p class="eyebrow"><%= t("deliveries.eyebrow") %></p><h2 class="mt-1 text-lg font-semibold text-ink"><%= t("deliveries.filters") %></h2></div><button type="button" class="button-secondary button-icon" aria-label="<%= t('forms.close') %>" data-mobile-menu-target="close" data-action="mobile-menu#close"><%= ui_icon("x", size: 17) %></button></div><div class="mt-5 grid gap-4 sm:grid-cols-2"><%= render "filters", form: form, suffix: "mobile" %></div><div class="mt-5 grid grid-cols-2 gap-2"><%= link_to t("forms.clear"), deliveries_path, class: "button-secondary" %><%= form.submit t("deliveries.apply_filters"), class: "button-primary" %></div></section></div>
<% end %>

<% if @filters_active %><div class="mt-3 flex flex-wrap items-center gap-2 text-xs"><span class="mr-1 font-semibold text-ink-muted"><%= t("deliveries.active_filters") %></span><% if params[:query].present? %><%= render "shared/filter_chip", label: params[:query], path: deliveries_path(request.query_parameters.except("page", "query")), remove_label: t("deliveries.remove_filter", filter: params[:query]) %><% end %><% if params[:view].present? %><%= render "shared/filter_chip", label: t("deliveries.views.#{params[:view]}"), path: deliveries_path(request.query_parameters.except("page", "view")), remove_label: t("deliveries.remove_filter", filter: t("deliveries.views.#{params[:view]}")) %><% end %><% if params[:collection_method].present? %><%= render "shared/filter_chip", label: t("deliveries.collection_methods.#{params[:collection_method]}"), path: deliveries_path(request.query_parameters.except("page", "collection_method")), remove_label: t("deliveries.remove_filter", filter: t("deliveries.collection_methods.#{params[:collection_method]}")) %><% end %><% if params[:from].present? || params[:to].present? %><%= render "shared/filter_chip", label: filter_date_range_label(params[:from], params[:to], fallback: t("deliveries.date_range")), path: deliveries_path(request.query_parameters.except("page", "from", "to")), remove_label: t("deliveries.remove_filter", filter: t("deliveries.date_range")) %><% end %><%= link_to t("forms.clear"), deliveries_path, class: "button-ghost button-sm" %></div><% end %>

<% unless params[:view] == "delivered" %><section class="mt-6" aria-labelledby="ready-deliveries-title"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("deliveries.queue_eyebrow") %></p><h2 id="ready-deliveries-title" class="section-title mt-1"><%= t("deliveries.ready_for_handover") %></h2><p class="supporting-text mt-1"><%= t("deliveries.ready_results", count: @filtered_ready_count) %></p></div><span class="status-badge status-success"><%= t("deliveries.release_ready") %></span></div>
  <% if @ready_orders.any? %><div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "ready_card", collection: @ready_orders, as: :order %></div><div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("dashboard.order") %></th><th><%= t("customers.customer") %></th><th><%= t("orders.items") %></th><th><%= t("orders.delivery_date") %></th><th class="text-right"><%= t("payments.balance") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><% @ready_orders.each do |order| %><% candidate = Delivery.new(order: order, branch: order.branch, delivered_by: current_user) %><tr><td><%= link_to order.order_number, order, class: "font-mono text-xs font-semibold text-brand" %></td><td><p class="font-medium text-ink"><%= order.customer.full_name %></p><p class="text-[11px] text-ink-muted"><%= order.customer.phone_number %></p></td><td class="text-ink-muted"><%= t("orders.garments", count: order.order_items.sum(&:quantity)) %></td><td><p class="tabular font-medium <%= order.delivery_date < Date.current ? 'text-[#b42318]' : 'text-ink' %>"><%= l(order.delivery_date) %></p></td><td class="tabular text-right font-semibold <%= order.balance_due.positive? ? 'text-[#b54708]' : 'text-emerald-refined' %>"><%= money(order.balance_due, order.currency) %></td><td class="text-right"><% if policy(candidate).create? %><%= link_to t("deliveries.handover"), new_order_delivery_path(order), class: "button-primary button-sm" %><% else %><span class="text-[10px] text-ink-muted"><%= t("deliveries.manager_required") %></span><% end %></td></tr><% end %></tbody></table></div><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("deliveries.no_ready_orders"), description: t("deliveries.no_ready_orders_description"), icon: "delivery" %></div><% end %>
</section><% end %>

<% unless params[:view].in?(%w[ready overdue]) %><section class="mt-7" aria-labelledby="delivery-history-title"><div><p class="eyebrow"><%= t("deliveries.history_eyebrow") %></p><h2 id="delivery-history-title" class="section-title mt-1"><%= t("deliveries.history") %></h2><p class="supporting-text mt-1"><%= t("deliveries.history_results", count: @filtered_delivery_count) %></p></div>
  <% if @deliveries.any? %><div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "delivery_card", collection: @deliveries, as: :delivery %></div><div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("deliveries.delivery_record") %></th><th><%= t("customers.customer") %></th><th><%= t("deliveries.recipient") %></th><th><%= t("deliveries.handed_over_at") %></th><th class="text-right"><%= t("payments.balance") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><% @deliveries.each do |delivery| %><tr><td><%= link_to delivery.delivery_number, delivery, class: "font-mono text-xs font-semibold text-brand" %><p class="text-[10px] text-ink-muted"><%= delivery.order.order_number %></p></td><td><p class="font-medium text-ink"><%= delivery.customer.full_name %></p><p class="text-[11px] text-ink-muted"><%= delivery.branch.name %></p></td><td><p class="text-sm text-ink"><%= delivery.recipient_name %></p><p class="text-[10px] text-ink-muted"><%= t("deliveries.collection_methods.#{delivery.collection_method}") %></p></td><td class="tabular text-ink-muted"><%= l(delivery.handed_over_at, format: :short) %></td><td class="tabular text-right font-semibold <%= delivery.balance_due_snapshot.positive? ? 'text-[#b54708]' : 'text-emerald-refined' %>"><%= money(delivery.balance_due_snapshot, delivery.currency) %></td><td class="text-right"><%= link_to delivery, class: "button-ghost button-icon button-sm", aria: { label: t("forms.view") } do %><%= ui_icon("chevron-right", size: 15) %><% end %></td></tr><% end %></tbody></table></div><nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), deliveries_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), deliveries_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("deliveries.no_history"), description: t("deliveries.no_history_description"), icon: "reports" %></div><% end %>
</section><% end %>
