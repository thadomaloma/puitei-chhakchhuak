<%= link_to delivery, class: "card block min-w-0 p-4" do %><div class="flex min-w-0 items-start justify-between gap-3"><div class="min-w-0"><p class="truncate font-mono text-[11px] font-semibold text-brand"><%= delivery.delivery_number %></p><p class="mt-1 truncate text-sm font-semibold text-ink"><%= delivery.customer.full_name %></p><p class="mt-0.5 truncate text-[10px] text-ink-muted"><%= delivery.recipient_name %> · <%= t("deliveries.collection_methods.#{delivery.collection_method}") %></p></div><div class="shrink-0 text-right"><%= status_badge("delivered", label: t("orders.statuses.delivered"), variant: "success") %><p class="mt-1.5 tabular text-[10px] text-ink-muted"><%= l(delivery.handed_over_at, format: :short) %></p></div></div><div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[11px]"><span class="text-ink-muted"><%= delivery.order.order_number %></span><span class="tabular font-semibold <%= delivery.balance_due_snapshot.positive? ? 'text-[#b54708]' : 'text-emerald-refined' %>"><%= money(delivery.balance_due_snapshot, delivery.currency) %> <%= t("payments.balance").downcase %></span></div><% end %>
