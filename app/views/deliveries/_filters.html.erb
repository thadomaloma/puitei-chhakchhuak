<div><%= form.label :view, t("deliveries.view"), for: "delivery_view_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select :view, options_for_select([[t("deliveries.views.all"), ""], [t("deliveries.views.ready"), "ready"], [t("deliveries.views.overdue"), "overdue"], [t("deliveries.views.outstanding"), "outstanding"], [t("deliveries.views.delivered"), "delivered"]], params[:view]), {}, id: "delivery_view_#{suffix}", class: "form-input mt-0" %></div>
<div><%= form.label :collection_method, t("deliveries.collection_method"), for: "delivery_method_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select :collection_method, options_for_select([[t("deliveries.all_collection_methods"), ""]] + Delivery.collection_methods.keys.map { |method| [t("deliveries.collection_methods.#{method}"), method] }, params[:collection_method]), {}, id: "delivery_method_#{suffix}", class: "form-input mt-0" %></div>
<div><%= form.label :from, t("deliveries.from"), for: "delivery_from_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.date_field :from, value: params[:from], id: "delivery_from_#{suffix}", class: "form-input mt-0", max: Date.current %></div>
<div><%= form.label :to, t("deliveries.to"), for: "delivery_to_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.date_field :to, value: params[:to], id: "delivery_to_#{suffix}", class: "form-input mt-0", max: Date.current %></div>
