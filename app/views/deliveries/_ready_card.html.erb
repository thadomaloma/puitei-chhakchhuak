<% candidate = Delivery.new(order: order, branch: order.branch, delivered_by: current_user) %><article class="card min-w-0 p-4"><div class="flex min-w-0 items-start justify-between gap-3"><div class="min-w-0"><%= link_to order.order_number, order, class: "block truncate font-mono text-[11px] font-semibold text-brand" %><h3 class="mt-1 truncate text-sm font-semibold text-ink"><%= order.customer.full_name %></h3><p class="mt-0.5 truncate text-[11px] text-ink-muted"><%= t("orders.garments", count: order.order_items.sum(&:quantity)) %></p></div><%= status_badge(order.delivery_date < Date.current ? "overdue" : "ready", label: order.delivery_date < Date.current ? t("deliveries.overdue") : t("dashboard.order_states.ready"), variant: order.delivery_date < Date.current ? "danger" : "success") %></div><dl class="mt-4 grid grid-cols-2 gap-2 border-y border-line py-3"><div><dt class="detail-label"><%= t("orders.delivery_date") %></dt><dd class="mt-1 tabular text-xs font-semibold <%= order.delivery_date < Date.current ? 'text-[#b42318]' : 'text-ink' %>"><%= l(order.delivery_date) %></dd></div><div class="text-right"><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="mt-1 tabular text-xs font-semibold <%= order.balance_due.positive? ? 'text-[#b54708]' : 'text-emerald-refined' %>"><%= money(order.balance_due, order.currency) %></dd></div></dl><% if policy(candidate).create? %><%= link_to t("deliveries.complete_handover"), new_order_delivery_path(order), class: "button-primary mt-3 w-full" %><% else %><p class="mt-3 rounded-lg bg-[#fffaeb] p-2.5 text-[11px] font-medium text-[#93370d]"><%= t("deliveries.manager_required") %></p><% end %></article>
