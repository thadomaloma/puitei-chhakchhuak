<%= form_with model: [order, payment], class: "mx-auto max-w-4xl space-y-4", data: { controller: "payment-form", payment_form_outstanding_value: order.balance_due, payment_form_currency_value: order.currency } do |form| %>
  <%= render "shared/form_errors", record: payment %>
  <section class="form-section">
    <div><p class="eyebrow"><%= t("payments.collection_eyebrow") %></p><h2 class="section-title mt-1"><%= t("payments.collection_details") %></h2><p class="supporting-text mt-1"><%= t("payments.collection_description") %></p></div>
    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2"><div class="flex items-end justify-between gap-3"><%= form.label :amount, t("payments.amount"), class: "text-xs font-semibold text-ink" %><div class="flex gap-1.5"><button type="button" class="button-ghost button-sm" data-action="payment-form#payHalf"><%= t("payments.pay_half") %></button><button type="button" class="button-secondary button-sm" data-action="payment-form#payFull"><%= t("payments.pay_full") %></button></div></div><div class="relative mt-1.5"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm font-semibold text-ink-muted"><%= order.currency %></span><%= form.number_field :amount, min: 0.01, max: order.balance_due, step: "0.01", class: "form-input mt-0 pl-14 text-lg font-semibold tabular", inputmode: "decimal", required: true, autofocus: true, data: { payment_form_target: "amount", action: "input->payment-form#preview" } %></div></div>
      <div><%= form.label :payment_method, t("payments.method"), class: "text-xs font-semibold text-ink" %><%= form.select :payment_method, Payment.payment_methods.keys.map { |method| [t("payments.methods.#{method}"), method] }, {}, class: "form-input", required: true, data: { payment_form_target: "method", action: "change->payment-form#preview" } %></div>
      <div><%= form.label :paid_on, t("payments.paid_on"), class: "text-xs font-semibold text-ink" %><%= form.date_field :paid_on, max: Date.current, class: "form-input", required: true %></div>
      <div class="sm:col-span-2"><%= form.label :reference_number, t("payments.reference"), class: "text-xs font-semibold text-ink" %><%= form.text_field :reference_number, class: "form-input", autocomplete: "off", placeholder: t("payments.reference_hint"), data: { payment_form_target: "reference", action: "input->payment-form#preview" } %><p class="mt-1 text-[11px] text-ink-muted"><%= t("payments.reference_description") %></p></div>
      <div class="sm:col-span-2"><%= form.label :notes, t("customers.notes"), class: "text-xs font-semibold text-ink" %><%= form.text_area :notes, rows: 3, class: "form-input", placeholder: t("payments.notes_placeholder") %></div>
    </div>
  </section>
  <section class="rounded-2xl border border-line bg-[linear-gradient(135deg,#fffdf8_0%,#f4f7f1_100%)] p-4 shadow-sm sm:p-5"><p class="eyebrow"><%= t("payments.receipt_preview") %></p><dl class="mt-3 grid grid-cols-3 gap-px overflow-hidden rounded-xl border border-line bg-line"><div class="min-w-0 bg-surface p-3"><dt class="detail-label"><%= t("payments.balance_before") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= money(order.balance_due, order.currency) %></dd></div><div class="min-w-0 bg-surface p-3"><dt class="detail-label"><%= t("payments.this_receipt") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-emerald-refined"><%= money(payment.amount, order.currency) %></dd></div><div class="min-w-0 bg-surface p-3"><dt class="detail-label"><%= t("payments.balance_after") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink" data-payment-form-target="projected"></dd></div></dl><p class="mt-3 hidden rounded-lg border border-[#fecdca] bg-[#fef3f2] p-2.5 text-xs font-semibold text-[#b42318]" data-payment-form-target="warning"><%= t("payments.invalid_amount") %></p></section>
  <div class="sticky-actions"><%= link_to t("forms.cancel"), order, class: "button-secondary flex-1 sm:flex-none" %><%= form.submit t("payments.record"), class: "button-primary flex-1 sm:flex-none", data: { payment_form_target: "submit", turbo_confirm: t("payments.record_confirm") } %></div>
<% end %>
