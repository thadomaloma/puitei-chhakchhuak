<% content_for :title, t("payments.index_title") %>

<% payment_setup_action = if policy(current_branch.shop_setting).show?
  link_to(ui_icon("settings", size: 16) + t("payment_settings.short_title"), payment_setting_path, class: "button-secondary")
end %>
<%= render "shared/page_header", eyebrow: t("payments.eyebrow"), title: t("payments.dashboard"), description: t("payments.directory_description", count: @filtered_count), action: payment_setup_action %>

<section class="mt-5 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <%= render "shared/stat_card", label: t("payments.today"), value: money(@collected_today), detail: l(Date.current), icon: "calendar", tone: "success" %>
  <%= render "shared/stat_card", label: t("payments.this_month"), value: money(@collected_month), detail: t("payments.active_receipts"), icon: "payments", tone: "premium" %>
  <%= render "shared/stat_card", label: t("payments.outstanding"), value: money(@outstanding_total), detail: t("payments.receivable_orders", count: @receivable_count), icon: "warning", tone: (@outstanding_total.positive? ? "warning" : "success"), href: "#receivables" %>
  <%= render "shared/stat_card", label: t("payments.voided_receipts"), value: @voided_count, detail: t("payments.audit_history"), icon: "reports", tone: (@voided_count.positive? ? "danger" : "neutral"), href: payments_path(status: "voided") %>
</section>

<%= render "desktop_filter_bar" %>
<%= form_with url: payments_path, method: :get, class: "toolbar mt-5 xl:hidden", data: { controller: "mobile-menu", action: "keydown.esc@window->mobile-menu#close" } do |form| %>
  <div class="grid gap-2"><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("payments.search"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("payments.search"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div><div class="grid grid-cols-2 gap-2"><button type="button" class="button-secondary" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="payment-filter-panel" aria-expanded="false"><%= ui_icon("settings", size: 16) %><%= t("payments.filters") %></button><%= form.submit t("production.filter"), class: "button-primary" %></div></div>
  <div id="payment-filter-panel" class="hidden" data-mobile-menu-target="panel" hidden aria-hidden="true"><button type="button" class="fixed inset-0 z-40 bg-ink/30 backdrop-blur-[2px]" aria-label="<%= t('forms.close') %>" data-action="mobile-menu#close"></button><section role="dialog" aria-modal="true" aria-label="<%= t('payments.filters') %>" class="fixed inset-x-0 bottom-0 z-50 max-h-[88vh] overflow-y-auto rounded-t-2xl border border-line bg-surface p-4 shadow-2xl"><div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong"></div><div class="flex items-center justify-between"><div><p class="eyebrow"><%= t("payments.eyebrow") %></p><h2 class="mt-1 text-lg font-semibold text-ink"><%= t("payments.filters") %></h2></div><button type="button" class="button-secondary button-icon" aria-label="<%= t('forms.close') %>" data-mobile-menu-target="close" data-action="mobile-menu#close"><%= ui_icon("x", size: 17) %></button></div><div class="mt-5 grid gap-4 sm:grid-cols-2"><%= render "filters", form: form, suffix: "mobile" %></div><div class="mt-5 grid grid-cols-2 gap-2"><%= link_to t("forms.clear"), payments_path, class: "button-secondary" %><%= form.submit t("payments.apply_filters"), class: "button-primary" %></div></section></div>
<% end %>

<% if @filters_active %><div class="mt-3 flex flex-wrap items-center gap-2 text-xs"><span class="mr-1 font-semibold text-ink-muted"><%= t("payments.active_filters") %></span><% if params[:query].present? %><%= render "shared/filter_chip", label: params[:query], path: payments_path(request.query_parameters.except("page", "query")), remove_label: t("payments.remove_filter", filter: params[:query]) %><% end %><% if params[:status].present? %><%= render "shared/filter_chip", label: t("payments.statuses.#{params[:status]}"), path: payments_path(request.query_parameters.except("page", "status")), remove_label: t("payments.remove_filter", filter: t("payments.statuses.#{params[:status]}")) %><% end %><% if params[:payment_method].present? %><%= render "shared/filter_chip", label: t("payments.methods.#{params[:payment_method]}"), path: payments_path(request.query_parameters.except("page", "payment_method")), remove_label: t("payments.remove_filter", filter: t("payments.methods.#{params[:payment_method]}")) %><% end %><% if params[:from].present? || params[:to].present? %><%= render "shared/filter_chip", label: filter_date_range_label(params[:from], params[:to], fallback: t("payments.date_range")), path: payments_path(request.query_parameters.except("page", "from", "to")), remove_label: t("payments.remove_filter", filter: t("payments.date_range")) %><% end %><%= link_to t("forms.clear"), payments_path, class: "button-ghost button-sm" %></div><% end %>

<section id="receivables" class="mt-6 scroll-mt-6" aria-labelledby="receivables-title"><div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("payments.receivables_eyebrow") %></p><h2 id="receivables-title" class="section-title mt-1"><%= t("payments.receivables") %></h2><p class="supporting-text mt-1"><%= t("payments.receivables_description") %></p></div><span class="status-badge status-warning"><%= t("payments.receivable_orders", count: @receivable_count) %></span></div>
  <% if @receivable_orders.any? %><div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "receivable_card", collection: @receivable_orders, as: :order %></div><div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("dashboard.order") %></th><th><%= t("customers.customer") %></th><th><%= t("orders.delivery_date") %></th><th class="text-right"><%= t("payments.total") %></th><th class="text-right"><%= t("payments.paid") %></th><th class="text-right"><%= t("payments.balance") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><% @receivable_orders.each do |order| %><tr><td><%= link_to order.order_number, order, class: "font-mono text-xs font-semibold text-brand" %><p class="mt-0.5 text-[10px] text-ink-muted"><%= t("orders.garments", count: order.order_items.sum(&:quantity)) %></p></td><td><p class="font-medium text-ink"><%= order.customer.full_name %></p><p class="text-[11px] text-ink-muted"><%= order.customer.phone_number %></p></td><td class="tabular text-ink-muted"><%= l(order.delivery_date) %></td><td class="tabular text-right text-ink-muted"><%= money(order.total_amount, order.currency) %></td><td class="tabular text-right font-semibold text-emerald-refined"><%= money(order.paid_amount, order.currency) %></td><td class="tabular text-right font-semibold text-[#b54708]"><%= money(order.balance_due, order.currency) %></td><td class="text-right"><%= link_to t("payments.collect"), new_order_payment_path(order), class: "button-primary button-sm" %></td></tr><% end %></tbody></table></div><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("payments.no_receivables"), description: t("payments.no_receivables_description"), icon: "check" %></div><% end %>
</section>

<section class="mt-7" aria-labelledby="receipt-history-title"><div><p class="eyebrow"><%= t("payments.ledger_eyebrow") %></p><h2 id="receipt-history-title" class="section-title mt-1"><%= t("payments.receipt_history") %></h2><p class="supporting-text mt-1"><%= t("payments.results", count: @filtered_count) %></p></div>
  <% if @payments.any? %><div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "payment_card", collection: @payments, as: :payment %></div><div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("payments.receipt") %></th><th><%= t("customers.customer") %></th><th><%= t("payments.method") %></th><th><%= t("payments.paid_on") %></th><th class="text-right"><%= t("payments.amount") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><%= render partial: "payment_row", collection: @payments, as: :payment %></tbody></table></div><nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), payments_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), payments_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("payments.empty"), description: t("payments.empty_description"), icon: "payments" %></div><% end %>
</section>
