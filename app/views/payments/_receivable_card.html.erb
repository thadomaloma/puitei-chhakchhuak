<article class="card min-w-0 p-4">
  <div class="flex min-w-0 items-start justify-between gap-3"><div class="min-w-0"><%= link_to order.order_number, order, class: "block truncate font-mono text-[11px] font-semibold text-brand" %><h3 class="mt-1 truncate text-sm font-semibold text-ink"><%= order.customer.full_name %></h3><p class="mt-0.5 truncate text-[11px] text-ink-muted"><%= order.customer.phone_number %></p></div><%= status_badge(order.payment_status, label: t("payments.statuses.#{order.payment_status}")) %></div>
  <dl class="mt-4 grid grid-cols-3 gap-2 border-y border-line py-3"><div><dt class="detail-label"><%= t("payments.total") %></dt><dd class="mt-1 tabular text-xs font-semibold text-ink"><%= money(order.total_amount, order.currency) %></dd></div><div><dt class="detail-label"><%= t("payments.paid") %></dt><dd class="mt-1 tabular text-xs font-semibold text-emerald-refined"><%= money(order.paid_amount, order.currency) %></dd></div><div><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="mt-1 tabular text-xs font-semibold text-[#b54708]"><%= money(order.balance_due, order.currency) %></dd></div></dl>
  <div class="mt-3 flex items-center justify-between gap-3"><p class="text-[11px] text-ink-muted"><%= t("payments.due", date: l(order.delivery_date)) %></p><%= link_to t("payments.collect"), new_order_payment_path(order), class: "button-primary button-sm" %></div>
</article>
