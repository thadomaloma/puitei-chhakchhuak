<% content_for :title, t("payments.new_title") %>
<%= render "shared/back_link", path: payments_path, label: t("payments.dashboard") %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("payments.eyebrow"), title: t("payments.collect_payment"), description: t("payments.new_description", customer: @order.customer.full_name), action: link_to(t("orders.view_order"), @order, class: "button-secondary") %></div>
<section class="section-card mx-auto mt-5 max-w-4xl overflow-hidden p-0"><div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5"><div class="min-w-0"><p class="font-mono text-[11px] font-semibold text-brand"><%= @order.order_number %></p><h2 class="mt-1 truncate text-lg font-semibold text-ink"><%= @order.customer.full_name %></h2><p class="mt-1 text-xs text-ink-muted"><%= @order.customer.phone_number %> · <%= t("orders.garments", count: @order.order_items.sum(&:quantity)) %></p></div><%= status_badge(@order.payment_status, label: t("payments.statuses.#{@order.payment_status}")) %></div><dl class="grid grid-cols-3 gap-px border-t border-line bg-line"><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.total") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= money(@order.total_amount, @order.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.paid") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-emerald-refined"><%= money(@order.paid_amount, @order.currency) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-[#b54708]"><%= money(@order.balance_due, @order.currency) %></dd></div></dl></section>
<div class="mt-4"><%= render "form", payment: @payment, order: @order %></div>
