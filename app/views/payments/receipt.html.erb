<% content_for :title, "#{t('payments.receipt')} · #{@payment.payment_number}" %>
<main class="mx-auto max-w-2xl p-6 sm:p-10"><div class="print-hidden mb-6 flex justify-between"><%= link_to "← #{@payment.payment_number}", @payment, class: "button-secondary" %><button type="button" data-controller="print" data-action="print#print" class="button-primary"><%= t("payments.print_receipt") %></button></div><header class="border-b-2 border-stone-900 pb-5 text-center"><p class="text-sm font-bold uppercase tracking-[0.2em]"><%= @payment.branch.shop_setting.shop_name %></p><p class="mt-1 whitespace-pre-line text-xs text-stone-600"><%= @payment.branch.shop_setting.address %></p><h1 class="mt-5 text-3xl font-black"><%= t("payments.receipt") %></h1><p class="mt-1 font-mono font-bold"><%= @payment.payment_number %></p></header><% if @payment.voided? %><div class="mt-5 border-4 border-red-700 p-3 text-center text-2xl font-black uppercase text-red-700"><%= t("payments.void_label") %></div><% end %><section class="grid grid-cols-2 gap-5 border-b border-stone-300 py-5 text-sm"><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("customers.customer") %></p><p class="mt-1 font-bold"><%= @payment.customer.full_name %></p><p><%= @payment.customer.phone_number %></p></div><div class="text-right"><p class="text-xs font-bold uppercase text-stone-500"><%= t("orders.title") %></p><p class="mt-1 font-mono font-bold"><%= @payment.order.order_number %></p><p><%= l(@payment.paid_on) %></p></div></section><section class="py-8 text-center"><p class="text-sm font-bold uppercase text-stone-500"><%= t("payments.amount_received") %></p><p class="mt-2 text-4xl font-black"><%= money(@payment.amount, @payment.currency_snapshot) %></p><p class="mt-2 font-semibold"><%= t("payments.methods.#{@payment.payment_method}") %><% if @payment.reference_number.present? %> · <%= @payment.reference_number %><% end %></p></section><dl class="border-y border-stone-300 py-4 text-sm"><div class="flex justify-between"><dt><%= t("payments.order_total") %></dt><dd class="font-bold"><%= money(@payment.order_total_snapshot, @payment.currency_snapshot) %></dd></div><div class="mt-2 flex justify-between"><dt><%= t("payments.balance_before") %></dt><dd class="font-bold"><%= money(@payment.balance_before_snapshot, @payment.currency_snapshot) %></dd></div><div class="mt-2 flex justify-between border-t border-stone-200 pt-2"><dt><%= t("payments.balance_after") %></dt><dd class="font-bold"><%= money(@payment.balance_after_snapshot, @payment.currency_snapshot) %></dd></div></dl><p class="mt-4 text-center text-[10px] text-stone-500"><%= t("payments.historical_snapshot_note") %></p><footer class="mt-8 flex justify-between text-xs text-stone-500"><span><%= t("payments.received_by") %>: <%= @payment.received_by.name %></span><span><%= @payment.branch.name %></span></footer></main>
