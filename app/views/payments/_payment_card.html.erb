<%= link_to payment, class: "card block min-w-0 p-4" do %><div class="flex min-w-0 items-start justify-between gap-3"><div class="min-w-0"><p class="truncate font-mono text-[11px] font-semibold text-brand"><%= payment.payment_number %></p><p class="mt-1 truncate text-sm font-semibold text-ink"><%= payment.customer.full_name %></p><p class="mt-0.5 truncate text-[10px] text-ink-muted"><%= payment.order.order_number %> · <%= payment.received_by.name %></p></div><div class="shrink-0 text-right"><p class="tabular text-sm font-semibold <%= payment.voided? ? 'text-ink-muted line-through' : 'text-ink' %>"><%= money(payment.amount, payment.currency_snapshot) %></p><div class="mt-1"><%= payment.voided? ? status_badge("void", label: t("payments.void_label"), variant: "danger") : status_badge("completed", label: t("payments.statuses.active"), variant: "success") %></div></div></div><div class="mt-3 flex items-center justify-between border-t border-line pt-3 text-[11px] text-ink-muted"><span><%= t("payments.methods.#{payment.payment_method}") %></span><span class="tabular"><%= l(payment.paid_on) %></span></div><% end %>
