<% content_for :title, @payment.payment_number %>
<%= render "shared/back_link", path: payments_path, label: t("payments.dashboard") %>
<% receipt_actions = capture do %><%= link_to t("payments.print_receipt"), receipt_payment_path(@payment), class: "button-primary" %><% if @payment.order.balance_due.positive? && policy(Payment.new(order: @payment.order, branch: @payment.branch)).create? %><%= link_to t("payments.collect_balance"), new_order_payment_path(@payment.order), class: "button-secondary" %><% end %><% end %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("payments.receipt_workspace"), title: @payment.payment_number, description: t("payments.receipt_description", date: l(@payment.paid_on, format: :long)), action: receipt_actions %></div>

<section class="section-card mt-5 overflow-hidden p-0 <%= @payment.voided? ? 'border-[#fecdca]' : 'border-[#abefc6]' %>">
  <div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f4f7f1_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><%= @payment.voided? ? status_badge("void", label: t("payments.void_label"), variant: "danger") : status_badge("completed", label: t("payments.statuses.active"), variant: "success") %><span class="text-[11px] font-medium text-ink-muted"><%= t("payments.methods.#{@payment.payment_method}") %></span></div><h1 class="mt-3 tabular text-3xl font-semibold tracking-[-0.035em] <%= @payment.voided? ? 'text-ink-muted line-through' : 'text-ink' %>"><%= money(@payment.amount, @payment.currency_snapshot) %></h1><p class="mt-1 text-xs text-ink-muted"><%= t("payments.received_by") %> <strong class="text-ink"><%= @payment.received_by.name %></strong></p></div><div class="sm:text-right"><p class="detail-label"><%= t("dashboard.order") %></p><%= link_to @payment.order.order_number, @payment.order, class: "mt-1 block font-mono text-xs font-semibold text-brand" %><p class="mt-2 text-sm font-semibold text-ink"><%= @payment.customer.full_name %></p><p class="text-xs text-ink-muted"><%= @payment.customer.phone_number %></p></div></div>
  <dl class="grid grid-cols-3 gap-px border-t border-line bg-line"><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.balance_before") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= money(@payment.balance_before_snapshot, @payment.currency_snapshot) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.this_receipt") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-emerald-refined"><%= money(@payment.amount, @payment.currency_snapshot) %></dd></div><div class="min-w-0 bg-surface p-4"><dt class="detail-label"><%= t("payments.balance_after") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold <%= @payment.balance_after_snapshot.positive? ? 'text-[#b54708]' : 'text-emerald-refined' %>"><%= money(@payment.balance_after_snapshot, @payment.currency_snapshot) %></dd></div></dl>
</section>

<% if @payment.voided? %><div role="alert" class="mt-4 rounded-xl border border-[#fecdca] bg-[#fef3f2] p-4 text-xs text-[#b42318]"><p class="font-semibold"><%= t("payments.voided_notice") %></p><p class="mt-1"><%= @payment.void_reason %></p><p class="mt-2 text-[10px]"><%= @payment.voided_by.name %> · <%= l(@payment.voided_at, format: :short) %></p></div><% end %>

<div class="mt-4 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]"><section class="section-card"><h2 class="section-title"><%= t("payments.transaction_details") %></h2><p class="supporting-text"><%= t("payments.transaction_details_description") %></p><dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="detail-label"><%= t("payments.paid_on") %></dt><dd class="detail-value tabular"><%= l(@payment.paid_on, format: :long) %></dd></div><div><dt class="detail-label"><%= t("payments.method") %></dt><dd class="detail-value"><%= t("payments.methods.#{@payment.payment_method}") %></dd></div><div><dt class="detail-label"><%= t("payments.reference") %></dt><dd class="detail-value"><%= @payment.reference_number.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("payments.order_total") %></dt><dd class="detail-value tabular"><%= money(@payment.order_total_snapshot, @payment.currency_snapshot) %></dd></div></dl><% if @payment.notes.present? %><div class="mt-4 border-t border-line pt-4"><h3 class="detail-label"><%= t("customers.notes") %></h3><p class="mt-1 whitespace-pre-line text-sm leading-5 text-ink-muted"><%= @payment.notes %></p></div><% end %></section>
  <aside class="space-y-4"><section class="form-section"><p class="eyebrow"><%= t("payments.audit_eyebrow") %></p><h2 class="section-title mt-1"><%= t("payments.immutable_receipt") %></h2><p class="supporting-text mt-1"><%= t("payments.immutable_receipt_description") %></p></section><% if policy(@payment).void? %><section class="form-section border-[#fecdca]"><h2 class="text-sm font-semibold text-[#b42318]"><%= t("payments.void_action") %></h2><p class="mt-1 text-xs text-ink-muted"><%= t("payments.void_description") %></p><%= form_with url: void_payment_path(@payment), method: :patch, class: "mt-4 space-y-3" do |form| %><div><%= form.label :void_reason, t("payments.void_reason"), class: "text-xs font-semibold text-[#b42318]" %><%= form.text_area :void_reason, name: "payment[void_reason]", rows: 3, class: "form-input", required: true %></div><%= form.submit t("payments.void_action"), class: "button-danger w-full", data: { turbo_confirm: t("payments.void_confirm") } %><% end %></section><% end %></aside>
</div>
