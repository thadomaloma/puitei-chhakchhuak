<tr><td><div class="flex items-center gap-2"><%= link_to payment.payment_number, payment, class: "font-mono text-xs font-semibold text-brand" %><% if payment.voided? %><%= status_badge("void", label: t("payments.void_label"), variant: "danger") %><% end %></div><p class="text-[10px] text-ink-muted"><%= payment.order.order_number %></p></td><td><p class="font-medium text-ink"><%= payment.customer.full_name %></p><p class="text-[11px] text-ink-muted"><%= payment.received_by.name %></p></td><td class="text-ink-muted"><%= t("payments.methods.#{payment.payment_method}") %></td><td class="tabular whitespace-nowrap text-ink-muted"><%= l(payment.paid_on) %></td><td class="tabular whitespace-nowrap text-right font-semibold <%= payment.voided? ? 'text-ink-muted line-through' : 'text-ink' %>"><%= money(payment.amount, payment.currency_snapshot) %></td><td class="text-right"><%= link_to payment, class: "button-ghost button-icon button-sm", aria: { label: t("forms.view") } do %><%= ui_icon("chevron-right", size: 15) %><% end %></td></tr>
