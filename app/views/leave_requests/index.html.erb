<% content_for :title, t("leave_requests.index_title") %>
<%= render "shared/page_header", eyebrow: t("staff.eyebrow"), title: t("leave_requests.title"), description: t("leave_requests.description"), action: link_to(ui_icon("plus", size: 17) + t("leave_requests.new"), new_leave_request_path, class: "button-primary"), secondary_action: (link_to(t("staff.directory"), staff_index_path, class: "button-secondary") if policy(User).index?) %>
<section class="mt-5 grid grid-cols-2 gap-2"><%= render "shared/stat_card", label: t("leave_requests.pending"), value: @pending_count, detail: t("leave_requests.awaiting_review"), icon: "clock", tone: (@pending_count.positive? ? "warning" : "neutral") %><%= render "shared/stat_card", label: t("leave_requests.approved_upcoming"), value: @approved_upcoming_count, detail: t("leave_requests.current_and_future"), icon: "calendar", tone: "success" %></section>
<%= form_with url: leave_requests_path, method: :get, class: "toolbar mt-4 flex flex-wrap items-center gap-2" do |form| %><%= form.select :status, LeaveRequest.statuses.keys.map { |status| [ t("leave_requests.statuses.#{status}"), status ] }, { include_blank: t("leave_requests.all_statuses"), selected: params[:status] }, class: "form-select mt-0 min-w-44 flex-1", aria: { label: t("leave_requests.status") } %><%= form.submit t("forms.search"), class: "button-secondary" %><% end %>

<% if @leave_requests.any? %>
  <div class="mt-4 space-y-2">
    <% @leave_requests.each do |request| %>
      <article class="card min-w-0 p-4">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h2 class="text-sm font-semibold text-ink"><%= request.user.name %></h2><%= leave_status_badge(request) %></div><p class="mt-1 text-xs font-semibold text-emerald-refined"><%= t("leave_requests.types.#{request.leave_type}") %> · <%= t("leave_requests.days", count: request.duration_days) %></p><p class="mt-1 text-xs text-ink-muted"><%= l(request.starts_on, format: :long) %> – <%= l(request.ends_on, format: :long) %></p><p class="mt-2 whitespace-pre-line text-sm text-ink"><%= request.reason %></p><% if request.review_notes.present? %><p class="mt-2 rounded-lg bg-surface-muted p-2.5 text-xs text-ink-muted"><strong class="text-ink"><%= t("leave_requests.review_notes") %>:</strong> <%= request.review_notes %></p><% end %></div><div class="shrink-0 text-left sm:text-right"><p class="text-[10px] text-ink-muted"><%= t("leave_requests.requested", date: l(request.created_at, format: :short)) %></p><% if request.reviewed_by %><p class="mt-1 text-[10px] text-ink-muted"><%= t("leave_requests.reviewed_by", name: request.reviewed_by.name) %></p><% end %></div></div>
        <% if policy(request).review? %><div class="mt-3 flex flex-col gap-2 border-t border-line pt-3 sm:flex-row"><%= form_with url: approve_leave_request_path(request), method: :patch, class: "flex min-w-0 flex-1 gap-2" do |form| %><%= form.label :review_notes, t("leave_requests.review_note_optional"), class: "sr-only" %><%= form.text_field :review_notes, name: "leave_request[review_notes]", class: "form-input mt-0 min-w-0", placeholder: t("leave_requests.review_note_optional") %><%= form.submit t("leave_requests.approve"), class: "button-primary shrink-0" %><% end %><%= button_to t("leave_requests.reject"), reject_leave_request_path(request), method: :patch, class: "button-danger w-full sm:w-auto", data: { turbo_confirm: t("leave_requests.reject_confirm") } %></div><% elsif policy(request).cancel? %><div class="mt-3 border-t border-line pt-3"><%= button_to t("leave_requests.cancel"), cancel_leave_request_path(request), method: :patch, class: "button-ghost button-sm text-[#b42318]", data: { turbo_confirm: t("leave_requests.cancel_confirm") } %></div><% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <div class="mt-4"><%= render "shared/empty_state", title: t("leave_requests.empty"), description: t("leave_requests.empty_description"), icon: "calendar" %></div>
<% end %>
