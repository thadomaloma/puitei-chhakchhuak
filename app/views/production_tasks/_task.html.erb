<% order = task.order %>
<% item = task.order_item %>
<% workflow = item.production_tasks.sort_by(&:position) %>
<% snapshot = item.readonly_snapshot %>
<% blocked = task.blocked? %>
<% available_assignees = (local_assigns[:assignees] || task.branch.users.active.to_a).select { |user| task.eligible_user?(user) } %>

<article id="production-task-<%= task.id %>" class="section-card overflow-hidden p-0">
  <header class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2"><span class="rounded-lg bg-brand px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-white"><%= t("production.stage_step", current: task.position + 1, total: workflow.length) %> · <%= t("production.stages.#{task.stage}") %></span><%= status_badge(task.status, label: t("production.statuses.#{task.status}")) %><% if blocked %><%= status_badge("blocked", label: t("production.blocked_short"), variant: "danger") %><% end %></div>
      <h3 class="mt-3 text-lg font-semibold tracking-[-0.02em] text-ink"><%= item.garment_name %> <span class="text-sm font-medium text-ink-muted">× <%= item.quantity %></span></h3>
      <% if local_assigns.fetch(:show_order, false) %><p class="mt-1 truncate text-xs text-ink-muted"><%= link_to order.order_number, order, class: "font-mono font-semibold text-emerald-refined" %> · <%= order.customer.full_name %> · <%= order.branch.code %></p><% end %>
    </div>
    <div class="sm:text-right"><p class="text-xs font-semibold <%= order_delivery_state(order) == 'overdue' ? 'text-[#b42318]' : 'text-ink' %>"><%= order_delivery_label(order) %></p><p class="mt-1 text-[11px] text-ink-muted"><%= t("production.due", date: l(order.delivery_date, format: :long)) %></p></div>
  </header>

  <div class="border-t border-line bg-surface px-4 py-3 sm:px-5">
    <ol class="flex gap-1.5" aria-label="<%= t('production.garment_workflow') %>">
      <% workflow.each do |step| %><% finished = step.completed? || step.skipped? %><li class="min-w-0 flex-1"><div class="h-1.5 rounded-full <%= finished ? 'bg-[#12b76a]' : (step.in_progress? ? 'bg-[#2e90fa]' : (step == task ? 'bg-brand' : 'bg-line')) %>"></div><p class="mt-1 truncate text-[9px] font-semibold uppercase tracking-[0.06em] <%= step == task ? 'text-brand' : 'text-ink-muted' %>"><%= t("production.stages.#{step.stage}") %></p></li><% end %>
    </ol>
  </div>

  <div class="p-4 sm:p-5">
    <dl class="grid grid-cols-2 gap-3 lg:grid-cols-4">
      <div class="rounded-xl border border-line bg-surface-muted/45 p-3"><dt class="detail-label"><%= t("production.assignee") %></dt><dd class="mt-1 text-sm font-semibold text-ink"><%= task.assigned_to&.name || t("production.unassigned") %></dd></div>
      <div class="rounded-xl border border-line bg-surface-muted/45 p-3"><dt class="detail-label"><%= t("production.measurement_reference") %></dt><dd class="mt-1 text-sm font-semibold text-ink"><%= snapshot[:profile_name] %> · v<%= snapshot[:version] %></dd></div>
      <div class="rounded-xl border border-line bg-surface-muted/45 p-3"><dt class="detail-label"><%= t("production.started_label") %></dt><dd class="mt-1 text-sm font-semibold text-ink"><%= task.started_at ? l(task.started_at, format: :short) : "—" %></dd></div>
      <div class="rounded-xl border border-line bg-surface-muted/45 p-3"><dt class="detail-label"><%= t("production.completed_label") %></dt><dd class="mt-1 text-sm font-semibold text-ink"><%= task.completed_at ? l(task.completed_at, format: :short) : "—" %></dd></div>
    </dl>

    <% reference_images = item.design_references.to_a.presence || item.fabric_photos.to_a %>
    <% if reference_images.any? %><div class="mt-4 flex items-center gap-2"><% reference_images.first(3).each do |image| %><%= image_tag image.variant(:thumb), alt: "", class: "size-14 shrink-0 rounded-lg border border-line object-cover" %><% end %><% if reference_images.size > 3 %><span class="text-[11px] font-medium text-ink-muted">+<%= reference_images.size - 3 %></span><% end %></div><% end %>
    <% if blocked %><div class="mt-4 flex gap-3 rounded-xl border border-[#fecdca] bg-[#fef3f2] p-3 text-[#912018]"><%= ui_icon("warning", size: 17, class_name: "mt-0.5") %><div><p class="text-xs font-semibold"><%= t("production.blocked") %></p><p class="mt-0.5 text-[11px] leading-4"><%= t("production.blocked_description") %></p></div></div><% end %>
    <% if item.special_instructions.present? %><div class="mt-4 rounded-xl border border-line bg-surface-muted/45 p-3"><h4 class="detail-label"><%= t("orders.instructions") %></h4><p class="mt-1 whitespace-pre-line text-xs leading-5 text-ink-muted"><%= item.special_instructions %></p></div><% end %>
    <% if task.notes.present? %><div class="mt-4 rounded-xl border border-[#abefc6] bg-[#ecfdf3]/55 p-3"><h4 class="detail-label text-[#067647]"><%= t("production.stage_notes") %></h4><p class="mt-1 whitespace-pre-line text-xs leading-5 text-ink-muted"><%= task.notes %></p></div><% end %>

    <div class="mt-4 flex flex-col gap-3 border-t border-line pt-4 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-wrap gap-2">
        <% if policy(task).claim? %><%= button_to t("production.claim"), claim_production_task_path(task), method: :patch, class: "button-secondary" %><% end %>
        <% if policy(task).start? && !blocked %><%= button_to t("production.start"), start_production_task_path(task), method: :patch, class: "button-primary" %><% end %>
        <% if policy(task).skip? %><%= button_to t("production.skip"), skip_production_task_path(task), method: :patch, params: { production_task: { notes: t("production.skipped_by_manager") } }, class: "button-ghost", form: { data: { turbo_confirm: t("production.skip_confirm") } } %><% end %>
        <% if policy(task).reopen? %><%= button_to t("production.reopen"), reopen_production_task_path(task), method: :patch, class: "button-secondary", form: { data: { turbo_confirm: t("production.reopen_confirm") } } %><% end %>
        <%= link_to t("production.open_order"), order, class: "button-ghost" %>
      </div>
      <% if policy(task).complete? %><%= form_with url: complete_production_task_path(task), method: :patch, class: "grid gap-2 sm:grid-cols-[minmax(12rem,1fr)_auto] lg:min-w-[28rem]" do |form| %><div><%= form.label :notes, t("production.completion_notes"), for: "production_task_#{task.id}_notes", class: "sr-only" %><%= form.text_field :notes, id: "production_task_#{task.id}_notes", name: "production_task[notes]", placeholder: t("production.completion_notes"), class: "form-input mt-0" %></div><%= form.submit t("production.complete"), class: "button-primary" %><% end %><% end %>
    </div>

    <% if policy(task).assign? && !task.completed? && !task.skipped? %><div class="mt-3 rounded-xl border border-line bg-surface-muted/45 p-3"><%= form_with url: assign_production_task_path(task), method: :patch, class: "grid gap-2 sm:grid-cols-[minmax(12rem,1fr)_auto] sm:items-end" do |form| %><div><%= form.label :assigned_to_id, t("production.assign_to"), for: "production_task_#{task.id}_assigned_to_id", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.collection_select :assigned_to_id, available_assignees, :id, :name, { prompt: t("production.assign_to") }, id: "production_task_#{task.id}_assigned_to_id", name: "production_task[assigned_to_id]", class: "form-input mt-0", required: true %></div><%= form.submit t("production.assign"), class: "button-secondary" %><% end %></div><% end %>

    <% if task.production_events.any? %><details class="mt-4 border-t border-line pt-4"><summary class="cursor-pointer text-xs font-semibold text-brand"><%= t("production.activity_history", count: task.production_events.size) %></summary><ol class="mt-3 space-y-2 border-l border-line pl-4"><% task.production_events.first(5).each do |event| %><li><p class="text-xs font-semibold text-ink"><%= t("production.events.#{event.event_type}", actor: event.actor.name) %></p><p class="mt-0.5 text-[10px] text-ink-muted"><%= l(event.created_at, format: :long) %><% if event.notes.present? %> · <%= event.notes %><% end %></p></li><% end %></ol></details><% end %>
  </div>
</article>
