<% if @orders_with_balance.any? %>
  <section class="mb-6">
    <div><p class="eyebrow"><%= t("payments.eyebrow") %></p><h2 class="section-title mt-1"><%= t("customers.orders_with_balance") %></h2></div>
    <div class="mt-3 space-y-2"><% @orders_with_balance.each do |order| %><%= link_to order, class: "card flex items-center justify-between gap-3 p-3.5" do %><div class="min-w-0"><p class="font-mono text-[11px] font-semibold text-brand"><%= order.order_number %></p><p class="mt-0.5 truncate text-xs text-ink-muted"><%= order.order_items.map(&:garment_name).join(", ") %></p></div><p class="tabular shrink-0 text-sm font-semibold text-[#b54708]"><%= money(order.balance_due, order.currency) %></p><% end %><% end %></div>
  </section>
<% end %>

<section>
  <div><p class="eyebrow"><%= t("payments.eyebrow") %></p><h2 class="section-title mt-1"><%= t("payments.dashboard") %></h2><p class="supporting-text"><%= t("customers.payment_history_description") %></p></div>
  <% if @payments.any? %><div class="table-shell mt-3 hidden md:block"><table class="data-table"><thead><tr><th><%= t("payments.receipt") %></th><th><%= t("orders.title") %></th><th><%= t("payments.paid_on") %></th><th class="text-right"><%= t("payments.amount") %></th></tr></thead><tbody><% @payments.each do |payment| %><tr><td><%= link_to payment.payment_number, payment, class: "font-mono text-xs font-semibold text-brand" %></td><td><%= link_to payment.order.order_number, payment.order, class: "text-xs font-medium text-ink" %></td><td class="tabular text-ink-muted"><%= l(payment.paid_on) %></td><td class="tabular text-right font-semibold"><%= money(payment.amount, payment.order.currency) %></td></tr><% end %></tbody></table></div><div class="mt-3 space-y-2 md:hidden"><% @payments.each do |payment| %><%= link_to payment, class: "card flex items-center justify-between gap-3 p-3.5" do %><div><p class="font-mono text-[11px] font-semibold text-brand"><%= payment.payment_number %></p><p class="mt-1 text-xs text-ink-muted"><%= payment.order.order_number %> · <%= l(payment.paid_on) %></p></div><p class="tabular text-sm font-semibold text-ink"><%= money(payment.amount, payment.order.currency) %></p><% end %><% end %></div><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("customers.no_payments"), description: t("customers.no_payments_description"), icon: "payments" %></div><% end %>
</section>
