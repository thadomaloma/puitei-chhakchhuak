<section>
  <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("measurements.library") %></p><h2 class="section-title mt-1"><%= t("measurement_profiles.title") %></h2><p class="supporting-text"><%= t("measurement_profiles.description") %></p></div><% if policy(MeasurementProfile.new(customer: @customer)).create? && @customer.active? %><%= link_to t("measurement_profiles.new"), new_customer_measurement_profile_path(@customer), class: "button-primary" %><% end %></div>
  <% if @measurement_profiles.any? %>
    <div class="mt-3 grid gap-3 lg:grid-cols-2">
      <% @measurement_profiles.each do |profile| %><% latest = profile.latest_measurement %><article class="section-card min-w-0"><div class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-lg bg-surface-muted text-emerald-refined"><%= ui_icon("ruler", size: 18) %></span><div class="min-w-0 flex-1"><div class="flex flex-wrap items-center gap-2"><h3 class="truncate text-sm font-semibold text-ink"><%= profile.name %></h3><%= status_badge(profile.active? ? "active" : "archived", label: profile.active? ? t("measurements.active") : t("measurements.archived"), variant: profile.active? ? "success" : "neutral") %></div><p class="mt-1 text-xs text-ink-muted"><%= profile.measurement_template.name %> · <%= profile.unit.humanize %></p></div></div>
        <% if latest %><dl class="mt-4 grid grid-cols-2 gap-2 border-t border-line pt-3 sm:grid-cols-4"><% latest.values.first(4).each do |key, value| %><div><dt class="detail-label"><%= key.humanize %></dt><dd class="mt-1 tabular text-xs font-semibold text-ink"><%= value %></dd></div><% end %></dl><div class="mt-3 grid gap-2 text-[11px] text-ink-muted sm:grid-cols-2"><p><%= t("measurement_profiles.latest", version: latest.version, date: l(latest.measured_on)) %></p><p class="sm:text-right"><%= t("measurements.taken_by", name: latest.created_by.name) %><% if latest.order_items.any? %> · <%= t("measurements.used_in_orders", count: latest.order_items.size) %><% end %></p></div><% else %><p class="mt-4 border-t border-line pt-3 text-xs text-[#b54708]"><%= t("measurement_profiles.no_measurement") %></p><% end %>
        <% if profile.fitting_notes.present? %><p class="mt-3 line-clamp-2 text-xs leading-5 text-ink-muted"><%= profile.fitting_notes %></p><% end %>
        <div class="mt-4 flex flex-wrap justify-end gap-2"><%= link_to t("forms.view"), customer_measurement_profile_path(@customer, profile), class: "button-secondary button-sm" %><% if latest && profile.active? %><%= link_to t("measurements.copy"), new_customer_measurement_profile_measurement_path(@customer, profile, copy_from_id: latest.id), class: "button-ghost button-sm" %><%= link_to t("measurements.new_version"), new_customer_measurement_profile_measurement_path(@customer, profile), class: "button-primary button-sm" %><% end %></div></article><% end %>
    </div>
  <% else %><div class="mt-3"><%= render "shared/empty_state", title: t("measurement_profiles.empty"), description: t("measurement_profiles.description"), icon: "ruler", action: (link_to(t("measurement_profiles.new"), new_customer_measurement_profile_path(@customer), class: "button-primary") if @customer.active? && policy(MeasurementProfile.new(customer: @customer)).create?) %></div><% end %>
</section>
