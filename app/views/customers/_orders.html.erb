<section>
  <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("orders.eyebrow") %></p><h2 class="section-title mt-1"><%= t("orders.title") %></h2><p class="supporting-text"><%= t("orders.customer_description") %></p></div><% if policy(Order).create? && @customer.active? %><%= link_to t("orders.new"), new_order_path(customer_id: @customer.id), class: "button-primary" %><% end %></div>
  <% if @orders.any? %><div class="card mt-3 overflow-hidden"><% @orders.each do |order| %><%= link_to order, class: "flex items-center justify-between gap-4 border-b border-line p-4 transition-colors last:border-0 hover:bg-surface-muted/45" do %><div><p class="font-mono text-xs font-semibold text-ink"><%= order.order_number %></p><p class="mt-1 text-xs text-ink-muted"><%= t("orders.garments", count: order.order_items.sum(&:quantity)) %></p></div><div class="flex items-center gap-3"><div class="text-right"><%= status_badge(order.status, label: t("orders.statuses.#{order.status}")) %><p class="mt-1 tabular text-[11px] text-ink-muted"><%= l(order.delivery_date) %></p></div><%= ui_icon("chevron-right", size: 15, class_name: "text-ink-muted") %></div><% end %><% end %></div><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("orders.customer_empty"), icon: "orders" %></div><% end %>
</section>
