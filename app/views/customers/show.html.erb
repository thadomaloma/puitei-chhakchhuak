<% content_for :title, @customer.full_name %>

<%= render "shared/back_link", path: customers_path, label: t("customers.title") %>

<section class="section-card mt-3">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
    <%= render "avatar", customer: @customer, size_class: "size-20 sm:size-24" %>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2"><h1 class="page-title"><%= @customer.full_name %></h1><%= status_badge(@customer.active? ? "active" : "archived", label: @customer.active? ? t("customers.active_label") : t("customers.archived_label"), variant: @customer.active? ? "success" : "neutral") %></div>
      <p class="mt-1 font-mono text-[11px] font-semibold text-emerald-refined"><%= @customer.customer_code %></p>
      <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-ink-muted"><%= link_to @customer.phone_number, "tel:#{@customer.phone_number}", class: "font-medium text-ink" %><span><%= @customer.branch.name %></span><% if @customer.whatsapp_number.present? %><%= link_to t("customers.open_whatsapp"), "https://wa.me/#{@customer.whatsapp_number}", class: "font-semibold text-emerald-refined", target: "_blank", rel: "noreferrer" %><% end %></div>
    </div>
    <div class="flex w-full flex-wrap justify-end gap-2 sm:w-auto" data-page-actions>
      <% if policy(@customer).update? %><%= link_to t("forms.edit"), edit_customer_path(@customer), class: "button-secondary" %><% end %>
      <% if @measurement_access && @customer.active? && policy(MeasurementProfile.new(customer: @customer)).create? %><%= link_to t("customers.new_measurement"), new_customer_measurement_profile_path(@customer), class: "button-secondary" %><% end %>
      <% if policy(Order).create? && @customer.active? %><%= link_to t("orders.new"), new_order_path(customer_id: @customer.id), class: "button-primary" %><% end %>
    </div>
  </div>
</section>

<section class="mt-4 grid grid-cols-2 gap-2 lg:grid-cols-3 xl:grid-cols-6" aria-label="<%= t('customers.summary') %>">
  <%= render "shared/stat_card", label: t("customers.total_orders"), value: @customer_summary[:total_orders], detail: t("customers.order_history"), icon: "orders", tone: "neutral", href: customer_path(@customer, tab: "orders") %>
  <%= render "shared/stat_card", label: t("customers.total_spent"), value: (@financial_access ? money(@customer_summary[:total_spent]) : "—"), detail: (@financial_access ? t("customers.recorded_payments") : t("dashboard.restricted_metric")), icon: "payments", tone: "success", href: (@financial_access ? customer_path(@customer, tab: "payments") : nil) %>
  <%= render "shared/stat_card", label: t("customers.outstanding_balance"), value: (@financial_access ? money(@customer_summary[:outstanding_balance]) : "—"), detail: t("customers.confirmed_orders"), icon: "warning", tone: (@financial_access && @customer_summary[:outstanding_balance].positive? ? "warning" : "neutral") %>
  <%= render "shared/stat_card", label: t("customers.last_order"), value: (@customer_summary[:last_order]&.order_number || "—"), detail: (@customer_summary[:last_order] ? l(@customer_summary[:last_order].ordered_on) : t("customers.no_orders")), icon: "calendar", tone: "info" %>
  <%= render "shared/stat_card", label: t("customers.upcoming_delivery"), value: (@customer_summary[:upcoming_delivery] ? l(@customer_summary[:upcoming_delivery]) : "—"), detail: t("customers.next_commitment"), icon: "delivery", tone: "premium" %>
  <%= render "shared/stat_card", label: t("customers.measurement_profiles"), value: (@measurement_access ? @customer_summary[:measurement_profiles] : "—"), detail: t("measurement_profiles.description"), icon: "ruler", tone: "neutral", href: (@measurement_access ? customer_path(@customer, tab: "measurements") : nil) %>
</section>

<% tabs = [["overview", t("customers.tabs.overview")], ["measurements", t("customers.tabs.measurements")], ["orders", t("customers.tabs.orders")], ["payments", t("customers.tabs.payments")], ["gallery", t("customers.tabs.gallery")], ["notes", t("customers.tabs.notes")]] %>
<% tabs.reject! { |key, _| key == "measurements" && !@measurement_access } %>
<% tabs.reject! { |key, _| key == "gallery" && !(@measurement_access || @design_selection_access) } %>
<% tabs.reject! { |key, _| key == "payments" && !@financial_access } %>
<nav class="mt-5 overflow-x-auto border-b border-line" aria-label="<%= t('customers.profile_sections') %>">
  <div class="flex min-w-max gap-1"><% tabs.each do |key, label| %><%= link_to label, customer_path(@customer, tab: key), class: "min-h-10 border-b-2 px-3 py-2 text-xs font-semibold transition-colors #{@tab == key ? 'border-gold text-ink' : 'border-transparent text-ink-muted hover:text-ink'}", aria: (@tab == key ? { current: "page" } : {}) %><% end %></div>
</nav>

<div class="mt-4">
  <% if @tab == "measurements" %><%= render "measurements" %>
  <% elsif @tab == "orders" %><%= render "orders" %>
  <% elsif @tab == "payments" %><%= render "payments" %>
  <% elsif @tab == "gallery" %><%= render "gallery" %>
  <% elsif @tab == "notes" %><section class="section-card"><h2 class="section-title"><%= t("customers.tabs.notes") %></h2><p class="mt-3 whitespace-pre-line text-sm leading-6 text-ink-muted"><%= @customer.notes.presence || t("customers.no_notes") %></p></section>
  <% else %><%= render "overview" %>
  <% end %>
</div>
