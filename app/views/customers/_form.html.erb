<%= form_with model: customer, class: "max-w-5xl space-y-5" do |form| %>
  <%= render "shared/form_errors", record: customer %>

  <section class="form-section" data-controller="image-preview">
    <div><h2 class="section-title"><%= t("customers.basic_details") %></h2><p class="supporting-text"><%= t("customers.basic_details_description") %></p></div>
    <div class="mt-4 grid gap-5 md:grid-cols-[9rem_minmax(0,1fr)]">
      <div>
        <div class="grid aspect-square w-28 place-items-center overflow-hidden rounded-2xl border border-line bg-surface-muted text-xl font-semibold text-brand sm:w-32">
          <% if customer.profile_photo.attached? %><%= image_tag customer.profile_photo.variant(:thumb), alt: "", class: "size-full object-cover", data: { image_preview_target: "preview" } %><% else %><%= image_tag "", alt: "", class: "hidden size-full object-cover", data: { image_preview_target: "preview" } %><span data-image-preview-target="placeholder"><%= customer.persisted? ? customer.initials : ui_icon("user", size: 26) %></span><% end %>
        </div>
        <%= form.label :profile_photo, class: "form-label mt-3 block" %>
        <%= form.file_field :profile_photo, accept: "image/jpeg,image/png,image/webp", capture: "user", class: "file-input", data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
        <p class="form-hint"><%= t("customers.photo_hint") %></p>
        <% if customer.profile_photo.attached? %><label class="mt-2 flex min-h-9 items-center gap-2 text-xs font-medium text-ink-muted"><%= check_box_tag "customer[remove_profile_photo]", "1", false, class: "size-4 rounded border-line text-brand" %><%= t("customers.remove_photo") %></label><% end %>
      </div>
      <div class="grid content-start gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2"><%= form.label :full_name, class: "form-label" %><%= form.text_field :full_name, required: true, autocomplete: "name", class: "form-input" %></div>
        <div><%= form.label :gender, class: "form-label" %><%= form.select :gender, Customer.genders.keys.map { |gender| [gender.humanize, gender] }, {}, class: "form-select" %></div>
        <div><%= form.label :date_of_birth, class: "form-label" %><%= form.date_field :date_of_birth, max: Date.current, autocomplete: "bday", class: "form-input" %></div>
        <div><%= form.label :preferred_language, class: "form-label" %><%= form.select :preferred_language, [["English", "en"], ["Mizo", "lus"], ["Hindi", "hi"]], {}, class: "form-select" %></div>
        <% if current_user.owner? && defined?(@available_branches) && @available_branches.many? %><div><%= form.label :branch_id, class: "form-label" %><%= form.collection_select :branch_id, @available_branches, :id, :name, {}, class: "form-select" %></div><% end %>
        <% if customer.persisted? %><div class="sm:col-span-2 rounded-lg bg-surface-muted p-3"><p class="detail-label"><%= t("customers.customer_code") %></p><p class="mt-1 font-mono text-xs font-semibold text-ink"><%= customer.customer_code %></p></div><% else %><p class="form-hint sm:col-span-2"><%= t("customers.code_generated_hint") %></p><% end %>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div><h2 class="section-title"><%= t("customers.contact_details") %></h2><p class="supporting-text"><%= t("customers.contact_description") %></p></div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div><%= form.label :phone_number, class: "form-label" %><%= form.telephone_field :phone_number, required: true, autocomplete: "tel", inputmode: "tel", class: "form-input" %></div>
      <div><%= form.label :whatsapp_number, class: "form-label" %><%= form.telephone_field :whatsapp_number, autocomplete: "tel", inputmode: "tel", class: "form-input" %><p class="form-hint"><%= t("customers.whatsapp_hint") %></p></div>
      <div class="sm:col-span-2"><%= form.label :email, class: "form-label" %><%= form.email_field :email, autocomplete: "email", inputmode: "email", class: "form-input" %></div>
    </div>
  </section>

  <section class="form-section">
    <div><h2 class="section-title"><%= t("customers.address_preferences") %></h2><p class="supporting-text"><%= t("customers.address_preferences_description") %></p></div>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div><%= form.label :city, class: "form-label" %><%= form.text_field :city, autocomplete: "address-level2", class: "form-input" %></div>
      <div class="sm:col-span-2"><%= form.label :address, class: "form-label" %><%= form.text_area :address, rows: 3, autocomplete: "street-address", class: "form-textarea" %></div>
      <div class="sm:col-span-2"><%= form.label :notes, class: "form-label" %><%= form.text_area :notes, rows: 4, class: "form-textarea", placeholder: t("customers.notes_placeholder") %><p class="form-hint"><%= t("customers.notes_hint") %></p></div>
    </div>
  </section>

  <div class="sticky-actions justify-end">
    <%= link_to t("forms.cancel"), customer.persisted? ? customer_path(customer) : customers_path, class: "button-secondary flex-1 sm:flex-none" %>
    <%= form.submit customer.persisted? ? t("customers.save_changes") : t("customers.save_customer"), class: "button-primary flex-1 sm:flex-none" %>
  </div>
<% end %>
