<div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_22rem]">
  <div class="space-y-4">
    <section class="section-card">
      <div><h2 class="section-title"><%= t("customers.contact_information") %></h2><p class="supporting-text"><%= t("customers.contact_information_description") %></p></div>
      <dl class="mt-4 grid gap-4 sm:grid-cols-2"><div><dt class="detail-label"><%= t("customers.phone") %></dt><dd class="detail-value"><%= link_to @customer.phone_number, "tel:#{@customer.phone_number}", class: "text-emerald-refined" %></dd></div><div><dt class="detail-label">WhatsApp</dt><dd class="detail-value"><%= @customer.whatsapp_number.presence || "—" %></dd></div><div><dt class="detail-label">Email</dt><dd class="detail-value break-all"><%= @customer.email.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("customers.language") %></dt><dd class="detail-value"><%= @customer.preferred_language.upcase %></dd></div><div><dt class="detail-label"><%= t("customers.gender") %></dt><dd class="detail-value"><%= @customer.gender.humanize %></dd></div><div><dt class="detail-label"><%= t("customers.date_of_birth") %></dt><dd class="detail-value"><%= @customer.date_of_birth ? l(@customer.date_of_birth) : "—" %></dd></div></dl>
    </section>
    <section class="section-card"><h2 class="section-title"><%= t("customers.address_preferences") %></h2><div class="mt-4 grid gap-5 md:grid-cols-2"><div><h3 class="detail-label"><%= t("customers.address") %></h3><p class="mt-1 whitespace-pre-line text-sm leading-5 text-ink-muted"><%= [@customer.address, @customer.city].compact_blank.join("\n").presence || "—" %></p></div><div><h3 class="detail-label"><%= t("customers.general_preferences") %></h3><p class="mt-1 whitespace-pre-line text-sm leading-5 text-ink-muted"><%= @customer.notes.presence || t("customers.no_notes") %></p></div></div></section>
  </div>
  <aside class="section-card self-start"><h2 class="section-title"><%= t("customers.recent_activity") %></h2><p class="supporting-text"><%= t("customers.recent_activity_description") %></p><ol class="mt-4 space-y-0"><% @activity.each do |event| %><li class="relative border-l border-line pb-4 pl-5 last:pb-0"><span class="absolute -left-1 top-1 size-2 rounded-full bg-gold" aria-hidden="true"></span><p class="text-xs font-medium text-ink"><%= event[:label] %></p><p class="mt-1 tabular text-[10px] text-ink-muted"><%= l(event[:occurred_at], format: :short) %></p></li><% end %></ol></aside>
</div>
