<% metric = @customer_metrics.fetch(customer.id) %>
<article class="card min-w-0 p-3.5">
  <div class="flex min-w-0 items-start gap-3"><%= render "avatar", customer: customer, size_class: "size-11" %><div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><h2 class="truncate text-sm font-semibold text-ink"><%= customer.full_name %></h2><p class="font-mono text-[10px] text-ink-muted"><%= customer.customer_code %></p></div><%= status_badge(customer.active? ? "active" : "archived", label: customer.active? ? t("customers.active_label") : t("customers.archived_label"), variant: customer.active? ? "success" : "neutral") %></div><p class="mt-1 text-xs text-ink-muted"><%= customer.phone_number %></p></div></div>
  <dl class="mt-3 grid grid-cols-3 gap-2 border-t border-line pt-2.5"><div><dt class="detail-label"><%= t("customers.last_order") %></dt><dd class="mt-1 tabular text-xs font-medium text-ink"><%= metric[:last_order_on] ? l(metric[:last_order_on]) : "—" %></dd></div><div><dt class="detail-label"><%= t("customers.orders_count") %></dt><dd class="mt-1 tabular text-xs font-semibold text-ink"><%= metric[:order_count] %></dd></div><div class="text-right"><dt class="detail-label"><%= t("customers.balance") %></dt><dd class="mt-1 truncate tabular text-xs font-semibold <%= metric[:outstanding_balance].positive? ? 'text-[#b54708]' : 'text-ink-muted' %>"><%= money(metric[:outstanding_balance]) %></dd></div></dl>
  <div class="mt-3 flex items-center justify-end gap-2"><%= link_to t("forms.view"), customer_path(customer), class: "button-secondary button-sm", data: { turbo_frame: "_top" } %><%= render "row_actions", customer: customer %></div>
</article>
