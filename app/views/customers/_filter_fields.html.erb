<% mobile = local_assigns.fetch(:mobile, false) %>
<% suffix = mobile ? "mobile" : "desktop" %>
<div><%= form.label :status, t("customers.status"), for: "customer_status_#{suffix}", class: (mobile ? "form-label" : "sr-only") %><%= form.select :status, [[t("customers.status_filters.active"), ""], [t("customers.status_filters.archived"), "archived"], [t("customers.status_filters.all"), "all"]], { selected: params[:status] }, class: "form-select mt-0", id: "customer_status_#{suffix}" %></div>
<div><%= form.label :activity, t("customers.activity"), for: "customer_activity_#{suffix}", class: (mobile ? "form-label" : "sr-only") %><%= form.select :activity, [[t("customers.activity_filters.any"), ""], [t("customers.activity_filters.recently_added"), "recently_added"], [t("customers.activity_filters.recently_ordered"), "recently_ordered"]], { selected: params[:activity] }, class: "form-select mt-0", id: "customer_activity_#{suffix}" %></div>
<div><%= form.label :gender, t("customers.gender"), for: "customer_gender_#{suffix}", class: (mobile ? "form-label" : "sr-only") %><%= form.select :gender, [[t("customers.all_genders"), ""]] + Customer.genders.keys.map { |gender| [gender.humanize, gender] }, { selected: params[:gender] }, class: "form-select mt-0", id: "customer_gender_#{suffix}" %></div>
<label class="flex min-h-10 items-center gap-2 rounded-lg border border-line px-3 text-xs font-medium text-ink-muted <%= 'mt-1.5' if mobile %>"><%= form.check_box :outstanding, { checked: params[:outstanding] == "1", class: "size-4 rounded border-line text-brand", id: "customer_outstanding_#{suffix}" }, "1", "0" %><%= t("customers.with_outstanding") %></label>
