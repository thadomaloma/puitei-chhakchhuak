<% content_for :title, t("customers.index_title") %>

<%= render "shared/page_header",
  eyebrow: t("customers.directory"),
  title: t("customers.title"),
  description: t("customers.directory_description", count: @total_customer_count),
  action: (link_to(ui_icon("plus", size: 17) + t("customers.new"), new_customer_path, class: "button-primary") if policy(Customer).create?) %>

<div class="mt-5" data-controller="mobile-menu" data-action="keydown.esc@window->mobile-menu#close">
  <%= form_with url: customers_path, method: :get, class: "toolbar grid gap-2 xl:grid-cols-[minmax(14rem,1fr)_10rem_11rem_9rem_auto_auto]", data: { turbo_frame: "customers" } do |form| %>
    <div class="relative min-w-0"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("customers.search_placeholder"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("customers.search_placeholder"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div>
    <div class="hidden xl:contents"><%= render "filter_fields", form: form %><%= form.submit t("forms.search"), class: "button-secondary" %></div>
    <%= form.submit t("forms.search"), class: "button-secondary xl:hidden" %>
    <button type="button" class="button-outline xl:hidden" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="customer-filter-panel" aria-expanded="false"><%= ui_icon("more", size: 16) %><%= t("customers.filters") %></button>
  <% end %>

  <% if @filters_active %>
    <div class="mt-2 flex flex-wrap items-center gap-1.5" aria-label="<%= t('customers.active_filters') %>">
      <% if params[:query].present? %><%= link_to customers_path(request.query_parameters.except(:query, :page)), class: "status-badge status-neutral" do %><%= params[:query] %><span aria-hidden="true">×</span><% end %><% end %>
      <% if params[:status].present? %><%= link_to customers_path(request.query_parameters.except(:status, :page)), class: "status-badge status-neutral" do %><%= t("customers.status_filters.#{params[:status]}") %><span aria-hidden="true">×</span><% end %><% end %>
      <% if params[:activity].present? %><%= link_to customers_path(request.query_parameters.except(:activity, :page)), class: "status-badge status-neutral" do %><%= t("customers.activity_filters.#{params[:activity]}") %><span aria-hidden="true">×</span><% end %><% end %>
      <% if params[:gender].present? %><%= link_to customers_path(request.query_parameters.except(:gender, :page)), class: "status-badge status-neutral" do %><%= params[:gender].humanize %><span aria-hidden="true">×</span><% end %><% end %>
      <% if params[:outstanding] == "1" %><%= link_to customers_path(request.query_parameters.except(:outstanding, :page)), class: "status-badge status-warning" do %><%= t("customers.with_outstanding") %><span aria-hidden="true">×</span><% end %><% end %>
      <%= link_to t("customers.clear_filters"), customers_path, class: "button-ghost button-sm", data: { turbo_frame: "customers" } %>
    </div>
  <% end %>

  <div id="customer-filter-panel" class="hidden fixed inset-0 z-50 xl:hidden" hidden aria-hidden="true" data-mobile-menu-target="panel">
    <button type="button" class="absolute inset-0 bg-brand/30 backdrop-blur-[2px]" data-action="mobile-menu#close" aria-label="<%= t('forms.cancel') %>"></button>
    <section role="dialog" aria-modal="true" aria-labelledby="customer-filter-title" class="safe-bottom absolute inset-x-0 bottom-0 rounded-t-2xl border-t border-line bg-surface p-4 shadow-overlay">
      <div class="flex items-center justify-between gap-3"><div><p class="eyebrow"><%= t("customers.directory") %></p><h2 id="customer-filter-title" class="section-title mt-1"><%= t("customers.filters") %></h2></div><button type="button" class="button-ghost button-icon" data-mobile-menu-target="close" data-action="mobile-menu#close" aria-label="<%= t('forms.cancel') %>"><%= ui_icon("x", size: 18) %></button></div>
      <%= form_with url: customers_path, method: :get, class: "mt-4 space-y-3" do |form| %>
        <%= form.hidden_field :query, value: params[:query] if params[:query].present? %>
        <%= render "filter_fields", form: form, mobile: true %>
        <div class="grid grid-cols-2 gap-2 pt-2"><%= link_to t("customers.clear_filters"), customers_path, class: "button-secondary" %><%= form.submit t("customers.apply_filters"), class: "button-primary" %></div>
      <% end %>
    </section>
  </div>
</div>

<%= turbo_frame_tag "customers" do %>
  <% if @customers.any? %>
    <div class="mt-4 grid gap-2 md:grid-cols-2 xl:hidden">
      <%= render partial: "directory_card", collection: @customers, as: :customer %>
    </div>

    <div class="table-shell mt-4 hidden overflow-visible xl:block">
      <table class="data-table">
        <thead><tr><th><%= t("customers.customer") %></th><th><%= t("customers.contact") %></th><th><%= t("customers.last_order") %></th><th class="text-right"><%= t("customers.orders_count") %></th><th class="text-right"><%= t("customers.outstanding_balance") %></th><th><%= t("customers.status") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead>
        <tbody><%= render partial: "directory_row", collection: @customers, as: :customer %></tbody>
      </table>
    </div>

    <% if @pagy.previous || @pagy.next %><nav class="mt-4 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), customers_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm", data: { turbo_frame: "customers" } %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), customers_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm", data: { turbo_frame: "customers" } %><% end %></nav><% end %>
  <% else %>
    <% empty_title = @total_customer_count.zero? ? t("customers.empty_first_title") : (@filters_active ? t("customers.empty_filtered_title") : t("customers.empty_title")) %>
    <% empty_description = @total_customer_count.zero? ? t("customers.empty_first_description") : t("customers.empty_description") %>
    <div class="mt-4"><%= render "shared/empty_state", title: empty_title, description: empty_description, icon: "customers", action: (link_to(t("customers.new"), new_customer_path, class: "button-primary") if @total_customer_count.zero? && policy(Customer).create?) %></div>
  <% end %>
<% end %>
