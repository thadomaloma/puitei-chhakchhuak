<% content_for :title, @design_share.title.presence || t("design_shares.share") %>
<%= render "shared/back_link", path: design_shares_path, label: t("design_shares.title") %>
<% actions = (button_to(t("design_shares.revoke"), design_share_path(@design_share), method: :delete, class: "button-danger", form: { data: { turbo_confirm: t("design_shares.revoke_confirm") } }) if policy(@design_share).destroy?) %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("design_shares.eyebrow"), title: @design_share.title.presence || t("design_shares.untitled"), description: t("design_shares.for_customer", customer: @design_share.customer.full_name), action: actions %></div>

<% if @share_url %><section class="mt-5 rounded-2xl border border-[#fedf89] bg-[#fffcf5] p-4"><p class="text-xs font-semibold text-[#93370d]"><%= t("design_shares.copy_now") %></p><p class="mt-1 text-[11px] leading-5 text-[#b54708]"><%= t("design_shares.copy_once_description") %></p><div class="mt-3 flex gap-2"><input value="<%= @share_url %>" readonly class="form-input mt-0 min-w-0 flex-1 font-mono text-[11px]" aria-label="<%= t('design_shares.share_link') %>"><%= link_to t("design_shares.open_preview"), @share_url, class: "button-secondary", target: "_blank", rel: "noopener noreferrer" %></div></section><% end %>

<div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_20rem]">
  <section><div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4"><% @design_share.design_share_items.each do |item| %><article class="overflow-hidden rounded-2xl border border-line bg-surface shadow-card"><% if (image = item.design.primary_image_attachment) %><%= image_tag image.variant(:thumb), alt: item.design.title, class: "aspect-[4/5] w-full object-cover", width: 480, height: 600 %><% end %><div class="p-3"><h2 class="text-xs font-semibold text-ink"><%= item.design.title %></h2><p class="mt-1 text-[10px] text-ink-muted"><%= item.design.garment_type.humanize %></p><% unless item.customer_reaction_no_response? %><div class="mt-2"><%= status_badge(item.customer_reaction, label: t("public_design_shares.reactions.#{item.customer_reaction}"), variant: item.customer_reaction_liked? || item.customer_reaction_shortlisted? ? "success" : "neutral") %></div><% end %><% if item.customer_comment.present? %><p class="mt-2 text-[11px] leading-4 text-ink-muted"><%= item.customer_comment %></p><% end %></div></article><% end %></div></section>
  <aside class="space-y-4"><section class="section-card"><h2 class="section-title"><%= t("design_shares.details") %></h2><dl class="mt-3 divide-y divide-line text-xs"><div class="flex justify-between gap-3 py-2"><dt class="text-ink-muted"><%= t("design_shares.status") %></dt><dd><%= status_badge(@design_share.active? ? "active" : "inactive", label: t("design_shares.statuses.#{@design_share.active? ? 'active' : (@design_share.revoked_at? ? 'revoked' : 'expired')}"), variant: @design_share.active? ? "success" : "neutral") %></dd></div><div class="flex justify-between gap-3 py-2"><dt class="text-ink-muted"><%= t("design_shares.expires") %></dt><dd class="font-semibold"><%= l(@design_share.expires_at.to_date) %></dd></div><div class="flex justify-between gap-3 py-2"><dt class="text-ink-muted"><%= t("design_shares.last_viewed") %></dt><dd class="font-semibold"><%= @design_share.viewed_at ? l(@design_share.viewed_at.to_date) : t("design_shares.not_viewed") %></dd></div><div class="flex justify-between gap-3 py-2"><dt class="text-ink-muted"><%= t("design_shares.created_by") %></dt><dd class="font-semibold"><%= @design_share.created_by.name %></dd></div></dl></section><% if @design_share.message.present? %><section class="section-card"><h2 class="section-title"><%= t("design_shares.message") %></h2><p class="mt-2 whitespace-pre-line text-xs leading-5 text-ink-muted"><%= @design_share.message %></p></section><% end %></aside>
</div>
