<% content_for :title, t("design_shares.new") %>
<%= render "shared/back_link", path: design_shares_path, label: t("design_shares.title") %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("design_shares.eyebrow"), title: t("design_shares.new"), description: t("design_shares.new_description") %></div>

<%= form_with model: @design_share, class: "mt-5 grid items-start gap-5 lg:grid-cols-[minmax(0,1fr)_24rem]" do |form| %>
  <section class="section-card space-y-4">
    <%= render "shared/form_errors", record: @design_share %>
    <div><%= form.label :customer_id, t("design_shares.customer"), class: "form-label" %><%= form.collection_select :customer_id, @customers, :id, :full_name, { prompt: t("design_shares.choose_customer"), selected: @selected_customer&.id }, { class: "form-input", required: true } %></div>
    <div><%= form.label :title, t("design_shares.share_title"), class: "form-label" %><%= form.text_field :title, class: "form-input", placeholder: t("design_shares.title_placeholder") %></div>
    <div><%= form.label :message, t("design_shares.message"), class: "form-label" %><%= form.text_area :message, rows: 4, class: "form-input", placeholder: t("design_shares.message_placeholder") %></div>
    <div class="grid gap-4 sm:grid-cols-2"><div><%= form.label :expires_at, t("design_shares.expires"), class: "form-label" %><%= form.datetime_local_field :expires_at, class: "form-input", required: true %></div><div><%= form.label :design_collection_id, t("design_shares.collection"), class: "form-label" %><%= form.collection_select :design_collection_id, @collections, :id, :name, { include_blank: t("design_shares.no_collection"), selected: @selected_collection&.id }, class: "form-input" %></div></div>
    <label class="flex items-start gap-3 rounded-xl border border-line bg-surface-muted p-3"><%= form.check_box :allow_feedback, class: "mt-0.5 size-4 rounded border-line text-brand" %><span><span class="block text-xs font-semibold text-ink"><%= t("design_shares.allow_feedback") %></span><span class="mt-0.5 block text-[11px] text-ink-muted"><%= t("design_shares.allow_feedback_description") %></span></span></label>
  </section>
  <aside class="section-card lg:sticky lg:top-24">
    <p class="eyebrow"><%= t("design_shares.shared_designs") %></p><h2 class="mt-1 section-title"><%= t("design_shares.choose_designs") %></h2><p class="supporting-text"><%= t("design_shares.choose_designs_description") %></p>
    <div class="mt-4 max-h-[30rem] space-y-2 overflow-y-auto pr-1"><% @designs.each do |design| %><label class="flex cursor-pointer items-center gap-3 rounded-xl border border-line p-2.5 has-[:checked]:border-gold has-[:checked]:bg-gold-soft/50"><%= check_box_tag "design_ids[]", design.id, params[:design_ids]&.include?(design.id.to_s), class: "size-4 rounded border-line text-brand" %><% if (image = design.primary_image_attachment) %><%= image_tag image.variant(:thumb), alt: "", class: "size-14 rounded-lg object-cover", width: 56, height: 56 %><% end %><span class="min-w-0"><span class="block truncate text-xs font-semibold"><%= design.title %></span><span class="text-[10px] text-ink-muted"><%= design.garment_type.humanize %></span></span></label><% end %></div>
    <p class="mt-3 text-[11px] leading-5 text-ink-muted"><%= t("design_shares.security_note") %></p>
    <%= form.submit t("design_shares.create"), class: "button-primary mt-4 w-full" %>
  </aside>
<% end %>
