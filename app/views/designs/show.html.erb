<% content_for :title, "#{@design.title} · #{t('designs.title')}" %>
<%= render "shared/back_link", path: designs_path, label: t("designs.title") %>
<% actions = [] %>
<% actions << render("design_favourites/button", design: @design, favourite: @favourite, compact: false) %>
<% if policy(DesignSelection).create? && @design.active? %><% actions << link_to(t("design_selections.attach_to_customer"), new_design_selection_path(design_id: @design.id), class: "button-secondary") %><% end %>
<% if policy(DesignShare).create? && @design.active? && @design.visibility_customer_shareable? %><% actions << link_to(t("design_shares.share"), new_design_share_path(design_ids: [@design.id]), class: "button-secondary") %><% end %>
<% if policy(@design).update? %><% actions << link_to(ui_icon("settings", size: 16) + t("forms.edit"), edit_design_path(@design), class: "button-primary") %><% end %>
<% actions = safe_join(actions) %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: @design.garment_type.humanize, title: @design.title, description: @design.description.presence || t("designs.private_reference"), action: actions %></div>

<div class="mt-5 grid items-start gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
  <section aria-label="<%= t('designs.images') %>">
    <% if (primary = @design.primary_image_attachment) %>
      <div class="overflow-hidden rounded-2xl border border-line bg-surface shadow-card"><%= image_tag primary.variant(:detail), alt: @design.title, class: "max-h-[76dvh] w-full object-contain", width: 1600, height: 2000 %></div>
    <% elsif @design.instagram_reference? %>
      <div class="overflow-hidden rounded-2xl border border-line bg-surface-muted p-6 text-center">
        <% if @instagram_preview&.success? && @instagram_preview.thumbnail_url.present? %>
          <%= image_tag @instagram_preview.thumbnail_url, alt: @design.title, class: "mx-auto max-h-[60dvh] rounded-xl object-contain" %>
          <% if @instagram_preview.author_name.present? %><p class="mt-3 text-xs text-ink-muted"><%= t("designs.instagram_credit", author: @instagram_preview.author_name) %></p><% end %>
        <% else %>
          <span class="grid size-16 mx-auto place-items-center rounded-full bg-surface text-ink-muted"><%= ui_icon("designs", size: 28) %></span>
          <p class="mt-3 text-sm font-semibold text-ink"><%= t("designs.instagram_preview_unavailable") %></p>
        <% end %>
        <%= link_to t("designs.open_on_instagram"), @design.source_url, target: "_blank", rel: "noopener noreferrer", class: "button-secondary button-sm mt-4" %>
      </div>
    <% end %>
    <% if @design.images.attachments.many? %><div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6"><% @design.images.attachments.each do |attachment| %><%= link_to url_for(attachment), class: "overflow-hidden rounded-xl border #{attachment.id == primary&.id ? 'border-brand ring-2 ring-brand/15' : 'border-line'} bg-surface", target: "_blank", rel: "noopener", aria: { label: t("designs.open_image") } do %><%= image_tag attachment.variant(:thumb), alt: "", class: "aspect-[4/5] w-full object-cover", loading: "lazy", width: 160, height: 200 %><% end %><% end %></div><% end %>
  </section>

  <aside class="space-y-4">
    <section class="section-card"><div class="flex items-center justify-between gap-3"><div><p class="eyebrow"><%= t("designs.reference_profile") %></p><h2 class="mt-1 section-title"><%= t("designs.design_specification") %></h2></div><%= status_badge(@design.active? ? "active" : "archived", label: t(@design.active? ? "designs.active" : "designs.archived_label"), variant: @design.active? ? "success" : "neutral") %></div><dl class="mt-4 divide-y divide-line text-xs">
      <% { garment_type: @design.garment_type.humanize, colour_family: @design.colour_family, fabric_type: @design.fabric_type, embroidery_style: @design.embroidery_style, sleeve_style: @design.sleeve_style, neck_style: @design.neck_style, occasion: @design.occasion }.each do |label, value| %><% if value.present? %><div class="flex items-start justify-between gap-4 py-2.5"><dt class="text-ink-muted"><%= t("designs.#{label}") %></dt><dd class="text-right font-semibold text-ink"><%= value %></dd></div><% end %><% end %>
      <% if @design.estimated_price.present? %><div class="flex items-start justify-between gap-4 py-2.5"><dt class="text-ink-muted"><%= t("designs.estimated_price") %></dt><dd class="font-semibold tabular text-ink"><%= money(@design.estimated_price, current_branch.shop_setting.currency) %></dd></div><% end %>
      <% if @design.estimated_minutes.present? %><div class="flex items-start justify-between gap-4 py-2.5"><dt class="text-ink-muted"><%= t("designs.estimated_minutes") %></dt><dd class="font-semibold tabular text-ink"><%= t("designs.minutes", count: @design.estimated_minutes) %></dd></div><% end %>
    </dl></section>
    <% if @design.tags.any? %><section class="section-card"><h2 class="section-title"><%= t("designs.tags") %></h2><div class="mt-3 flex flex-wrap gap-2"><% @design.tags.each do |tag| %><span class="status-badge status-neutral"><%= tag %></span><% end %></div></section><% end %>
    <section class="section-card"><div class="flex items-center justify-between"><div><p class="eyebrow"><%= t("designs.usage") %></p><h2 class="mt-1 section-title"><%= t("designs.customer_connections") %></h2></div><span class="text-2xl font-semibold tabular text-ink"><%= @design.usage_count %></span></div><% if @design_selections.any? %><div class="mt-3 space-y-2"><% @design_selections.first(5).each do |selection| %><%= link_to customer_path(selection.customer, tab: "gallery"), class: "flex items-center justify-between gap-3 rounded-xl border border-line p-2.5 hover:border-line-strong" do %><span class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-muted text-[10px] font-semibold text-ink"><%= selection.customer.initials %></span><span class="min-w-0 flex-1"><span class="block truncate text-xs font-semibold text-ink"><%= selection.customer.full_name %></span><span class="block text-[10px] text-ink-muted"><%= t("design_selections.selected_date", date: l(selection.selected_at.to_date)) %></span></span><%= status_badge(selection.status, label: t("design_selections.statuses.#{selection.status}"), variant: selection.approved? || selection.shortlisted? ? "success" : "neutral") %><% end %><% end %></div><% else %><p class="mt-2 text-xs text-ink-muted"><%= t("designs.no_customer_connections") %></p><% end %></section>
    <% if @design.internal_notes.present? && policy(DesignSelection).index? %><section class="section-card"><h2 class="section-title"><%= t("designs.internal_notes") %></h2><p class="mt-2 whitespace-pre-line text-xs leading-5 text-ink-muted"><%= @design.internal_notes %></p></section><% end %>
    <section class="section-card"><h2 class="section-title"><%= t("designs.provenance") %></h2><dl class="mt-3 space-y-2 text-xs"><% if @design.instagram_reference? %><div class="flex justify-between gap-3"><dt class="text-ink-muted"><%= t("designs.reference_source") %></dt><dd><span class="status-badge status-info"><%= t("designs.instagram_reference") %></span></dd></div><% end %><div class="flex justify-between gap-3"><dt class="text-ink-muted"><%= t("designs.source_type") %></dt><dd class="font-semibold text-ink"><%= t("designs.sources.#{@design.source_type}") %></dd></div><div class="flex justify-between gap-3"><dt class="text-ink-muted"><%= t("designs.uploaded_by") %></dt><dd class="font-semibold text-ink"><%= @design.uploaded_by.name %></dd></div><div class="flex justify-between gap-3"><dt class="text-ink-muted"><%= t("designs.rights_confirmed_on") %></dt><dd class="font-semibold text-ink"><%= l(@design.rights_confirmed_at.to_date) %></dd></div><% if @design.source_name.present? %><div class="flex justify-between gap-3"><dt class="text-ink-muted"><%= t("designs.source_name") %></dt><dd class="font-semibold text-ink"><%= @design.source_name %></dd></div><% end %></dl><% if @design.source_url.present? %><%= link_to t("designs.open_source"), @design.source_url, target: "_blank", rel: "noopener noreferrer", class: "button-ghost button-sm mt-3" %><% end %></section>
    <% if policy(@design).archive? %><section class="rounded-2xl border border-[#fecdca] bg-[#fffafa] p-4"><h2 class="text-sm font-semibold text-[#912018]"><%= t("designs.archive_design") %></h2><p class="mt-1 text-xs text-[#b42318]"><%= t("designs.archive_description") %></p><%= button_to t("designs.archive"), archive_design_path(@design), method: :patch, class: "button-danger button-sm mt-3", form: { data: { turbo_confirm: t("designs.archive_confirm") } } %></section><% end %>
  </aside>
</div>
