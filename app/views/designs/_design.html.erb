<article class="group overflow-hidden rounded-2xl border border-line bg-surface shadow-card transition hover:-translate-y-0.5 hover:border-line-strong hover:shadow-card-hover">
  <%= link_to design_path(design), class: "block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
    <div class="relative aspect-[4/5] overflow-hidden bg-surface-muted">
      <% if (image = design.primary_image_attachment) %>
        <%= image_tag image.variant(:thumb), alt: design.title, class: "size-full object-cover transition duration-300 group-hover:scale-[1.02]", loading: "lazy", width: 480, height: 600 %>
      <% else %>
        <span class="grid size-full place-items-center text-ink-muted"><%= ui_icon("designs", size: 34) %></span>
      <% end %>
      <span class="absolute left-3 top-3 rounded-full border border-white/35 bg-white/90 px-2.5 py-1 text-[10px] font-semibold text-ink shadow-sm backdrop-blur"><%= design.garment_type.humanize %></span>
      <% if local_assigns[:design_collection] && local_assigns[:cover_design]&.id == design.id %><span class="absolute right-3 top-3 status-badge <%= design_collection.cover_design_id == design.id ? 'status-warning' : 'status-neutral' %>"><%= t(design_collection.cover_design_id == design.id ? "design_collections.current_cover" : "design_collections.automatic_cover") %></span><% end %>
      <% unless design.active? %><span class="absolute inset-x-3 bottom-3 rounded-lg bg-ink/80 px-3 py-2 text-center text-[11px] font-semibold text-white"><%= t("designs.archived_label") %></span><% end %>
    </div>
    <div class="p-3.5">
      <div class="flex items-start justify-between gap-3"><h2 class="line-clamp-2 text-sm font-semibold leading-5 text-ink"><%= design.title %></h2><% if design.estimated_price.present? %><span class="shrink-0 text-xs font-semibold tabular text-ink"><%= money(design.estimated_price, current_branch.shop_setting.currency) %></span><% end %></div>
      <p class="mt-1.5 line-clamp-1 text-[11px] text-ink-muted"><%= [design.colour_family, design.fabric_type, design.occasion].compact_blank.join(" · ").presence || t("designs.private_reference") %></p>
    </div>
  <% end %>
  <% if @favourites_by_design_id %><div class="border-t border-line p-2.5"><%= render "design_favourites/button", design: design, favourite: @favourites_by_design_id[design.id], compact: true %></div><% end %>
  <% if local_assigns[:collection_item] && local_assigns[:design_collection] && (policy(design_collection).set_cover? || policy(design_collection).manage_items?) %><div class="grid gap-2 border-t border-line p-2.5"><% if policy(design_collection).set_cover? %><% if design_collection.cover_design_id == design.id %><span class="button-secondary button-sm w-full cursor-default" aria-current="true"><%= ui_icon("check", size: 14) %><%= t("design_collections.current_cover") %></span><% else %><%= button_to t("design_collections.set_as_cover"), set_cover_design_collection_path(design_collection, design_id: design.id), method: :patch, class: "button-secondary button-sm w-full", aria: { label: t("design_collections.set_cover_for", design: design.title) } %><% end %><% end %><% if policy(design_collection).manage_items? %><%= button_to t("design_collections.remove_design"), design_collection_design_collection_item_path(design_collection, collection_item), method: :delete, class: "button-ghost button-sm w-full text-[#b42318]", form: { data: { turbo_confirm: t("design_collections.remove_confirm", name: design.title) } } %><% end %></div><% end %>
</article>
