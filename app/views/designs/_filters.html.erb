<div><%= form.label :garment_type, t("designs.garment_type"), for: "design_garment_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select :garment_type, options_for_select([[t("designs.all_garments"), ""]] + @garment_templates.map { |template| [template.name, template.garment_type] }, params[:garment_type]), {}, id: "design_garment_#{suffix}", class: "form-input mt-0" %></div>
<div><%= form.label :visibility, t("designs.visibility"), for: "design_visibility_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select :visibility, options_for_select([[t("designs.all_visibility"), ""]] + %w[private customer_shareable].map { |value| [t("designs.visibilities.#{value}"), value] }, params[:visibility]), {}, id: "design_visibility_#{suffix}", class: "form-input mt-0" %></div>
<div><%= form.label :source_type, t("designs.source_type"), for: "design_source_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select :source_type, options_for_select([[t("designs.all_sources"), ""]] + Design.source_types.keys.map { |value| [t("designs.sources.#{value}"), value] }, params[:source_type]), {}, id: "design_source_#{suffix}", class: "form-input mt-0" %></div>
<% %i[colour_family fabric_type occasion tag].each do |attribute| %><div><%= form.label attribute, t("designs.#{attribute}"), for: "design_#{attribute}_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %><%= form.select attribute, options_for_select([[t("designs.any_option"), ""]] + @advanced_filter_options.fetch(attribute).map { |value| [value, value] }, params[attribute]), {}, id: "design_#{attribute}_#{suffix}", class: "form-input mt-0" %></div><% end %>
<label class="flex min-h-11 items-center gap-2 rounded-xl border border-line bg-surface px-3 text-xs font-medium text-ink-muted"><%= form.check_box :favourites, { checked: params[:favourites] == "1", class: "size-4 rounded border-line text-brand", id: "design_favourites_#{suffix}" }, "1", "0" %><%= t("design_favourites.only_saved") %></label>
<label class="flex min-h-11 items-center gap-2 rounded-xl border border-line bg-surface px-3 text-xs font-medium text-ink-muted"><%= form.check_box :archived, { checked: params[:archived] == "1", class: "size-4 rounded border-line text-brand", id: "design_archived_#{suffix}" }, "1", "0" %><%= t("designs.include_archived") %></label>
