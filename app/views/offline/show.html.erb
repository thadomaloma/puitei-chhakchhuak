<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#00142a">
    <meta name="robots" content="noindex,nofollow">
    <title>You're Offline &mdash; Puitei Chhakchhuak</title>
    <link rel="icon" href="/puitei-mark.svg?v=1" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/favicon-32.png?v=4" type="image/png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=4" sizes="180x180">
    <link rel="stylesheet" href="/offline.css">
  </head>
  <body>
    <main class="offline-card">
      <div class="offline-brand">
        <img class="offline-mark" src="/puitei-mark.svg" alt="" width="28" height="28">
        <span class="offline-brand-name">Puitei Chhakchhuak</span>
      </div>

      <div class="offline-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <line x1="2" y1="2" x2="22" y2="22"></line>
          <path d="M8.5 16.5a5 5 0 0 1 7 0"></path>
          <path d="M2 8.82a15 15 0 0 1 4.18-2.65"></path>
          <path d="M10.66 5c4.02-.36 8.14.9 11.34 3.76"></path>
          <path d="M16.85 11.25a10 10 0 0 1 2.22 1.68"></path>
          <path d="M5 13a10 10 0 0 1 5.24-2.76"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>

      <h1>You're offline</h1>
      <p class="offline-copy">Puitei Chhakchhuak can't connect right now. Check your internet connection and try again.</p>

      <div class="offline-actions">
        <form id="offline-retry-form" method="get" action="">
          <button type="submit" id="offline-retry" class="offline-retry">Try Again</button>
        </form>
      </div>

      <p class="offline-reassurance">Once your connection is back, you can continue where you left off.</p>

      <p id="offline-status" class="offline-status" role="status" aria-live="polite">
        <span class="offline-status-dot"></span>
        <span id="offline-status-text">No internet connection</span>
      </p>
      <p id="offline-recovery" class="offline-recovery" hidden>
        You're back online.
        <button type="button" id="offline-continue" class="offline-continue">Continue</button>
      </p>
    </main>

    <script src="/offline.js" defer></script>
  </body>
</html>
