<details class="relative" data-controller="popover" data-action="toggle->popover#keepOneOpen click@window->popover#closeOnOutside keydown.esc@window->popover#closeOnEscape">
  <summary class="button-secondary min-w-36 cursor-pointer list-none justify-between" aria-label="<%= t("#{translation_scope}.date_range") %>">
    <span class="flex min-w-0 items-center gap-2"><%= ui_icon("calendar", size: 16) %><span class="truncate"><%= filter_date_range_label(params[:from], params[:to], fallback: t("#{translation_scope}.date_range")) %></span></span>
    <%= ui_icon("chevron-down", size: 14, class_name: "text-ink-muted") %>
  </summary>
  <div class="filter-popover right-0 w-80">
    <div><p class="eyebrow"><%= t("#{translation_scope}.date_filter_eyebrow") %></p><h2 class="mt-1 text-sm font-semibold text-ink"><%= t("#{translation_scope}.date_range") %></h2></div>
    <div class="mt-3 grid grid-cols-2 gap-2">
      <%= link_to t("#{translation_scope}.today_filter"), today_path, class: "button-ghost button-sm justify-start" %>
      <%= link_to t("#{translation_scope}.this_month_filter"), month_path, class: "button-ghost button-sm justify-start" %>
    </div>
    <%= form_with url: path, method: :get, class: "mt-3 border-t border-line pt-3" do |form| %>
      <% hidden_fields.each do |name, value| %><%= form.hidden_field name, value: value if value.present? %><% end %>
      <div class="grid grid-cols-2 gap-3">
        <div><%= form.label :from, t("#{translation_scope}.from"), class: "form-label" %><%= form.date_field :from, value: params[:from], class: "form-input mt-1", max: Date.current %></div>
        <div><%= form.label :to, t("#{translation_scope}.to"), class: "form-label" %><%= form.date_field :to, value: params[:to], class: "form-input mt-1", max: Date.current %></div>
      </div>
      <div class="mt-3 flex items-center justify-between gap-2"><%= link_to t("forms.clear"), clear_path, class: "button-ghost button-sm" %><%= form.submit t("#{translation_scope}.apply_dates"), class: "button-primary button-sm" %></div>
    <% end %>
  </div>
</details>
