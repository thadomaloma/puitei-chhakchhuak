<% tone ||= "neutral" %>
<% tone_classes = { "neutral" => "bg-surface-muted text-ink-muted", "success" => "bg-[#ecfdf3] text-[#067647]", "warning" => "bg-[#fffaeb] text-[#b54708]", "info" => "bg-[#eff8ff] text-[#175cd3]", "premium" => "bg-[#fef7e8] text-[#854a0e]", "danger" => "bg-[#fef3f2] text-[#b42318]" } %>
<% content = capture do %>
  <div class="flex items-start justify-between gap-2">
    <p class="min-w-0 text-xs font-medium leading-4 text-ink-muted"><%= label %></p>
    <% if local_assigns[:icon].present? %><span class="grid size-7 shrink-0 place-items-center rounded-lg <%= tone_classes.fetch(tone) %>"><%= ui_icon(icon, size: 15) %></span><% end %>
  </div>
  <p class="metric-value"><%= value %></p>
  <% if local_assigns[:detail].present? %><p class="mt-1 hidden truncate text-[11px] leading-4 text-ink-muted sm:block"><%= detail %></p><% end %>
  <% if local_assigns[:trend].present? %><p class="mt-1.5 text-[11px] font-semibold text-emerald-refined"><%= trend %></p><% end %>
<% end %>
<% if local_assigns[:href].present? %><%= link_to href, class: "metric-card block" do %><%= content %><% end %><% else %><article class="metric-card"><%= content %></article><% end %>
