<% size ||= "md" %>
<% size_classes = { "sm" => "size-8 text-[11px]", "md" => "size-10 text-xs", "lg" => "size-14 text-sm" } %>
<span class="relative inline-grid <%= size_classes.fetch(size) %> shrink-0 place-items-center overflow-hidden rounded-full border border-line bg-surface-muted font-semibold text-brand" aria-label="<%= name %>">
  <% if local_assigns[:image].present? %><%= image_tag image, alt: "", class: "size-full object-cover" %><% else %><%= initials_for(name) %><% end %>
  <% if local_assigns[:status].present? %><span class="absolute bottom-0 right-0 size-2.5 rounded-full border-2 border-surface <%= status == :online ? 'bg-emerald-refined' : 'bg-ink-muted' %>" aria-hidden="true"></span><% end %>
</span>
