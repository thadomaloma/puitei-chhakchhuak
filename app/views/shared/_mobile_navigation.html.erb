<div class="lg:hidden" data-controller="mobile-menu" data-action="keydown.esc@window->mobile-menu#close keydown.tab@window->mobile-menu#trapFocus">
  <nav class="safe-bottom fixed inset-x-0 bottom-0 z-40 grid grid-cols-5 border-t border-line bg-surface/94 px-1 pt-1 shadow-[0_-4px_16px_rgb(16_24_40/0.05)] backdrop-blur-xl" aria-label="<%= t("navigation.mobile") %>">
    <%= link_to root_path, class: "flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-[10px] font-medium #{nav_active?('dashboard') ? 'text-brand' : 'text-ink-muted'}", aria: (nav_active?("dashboard") ? { current: "page" } : {}) do %><%= ui_icon("dashboard", size: 20) %><span><%= t("navigation.dashboard") %></span><% end %>
    <%= link_to orders_path, class: "flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-[10px] font-medium #{nav_active?('orders') ? 'text-brand' : 'text-ink-muted'}", aria: (nav_active?("orders") ? { current: "page" } : {}) do %><%= ui_icon("orders", size: 20) %><span><%= t("navigation.orders") %></span><% end %>
    <% if policy(Customer).index? %><%= link_to customers_path, class: "flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-[10px] font-medium #{nav_active?('customers') ? 'text-brand' : 'text-ink-muted'}", aria: (nav_active?("customers") ? { current: "page" } : {}) do %><%= ui_icon("customers", size: 20) %><span><%= t("navigation.customers") %></span><% end %><% else %><span class="flex min-h-14 flex-col items-center justify-center gap-1 text-[10px] text-ink-muted/45"><%= ui_icon("customers", size: 20) %><span><%= t("navigation.customers") %></span></span><% end %>
    <% if policy(Payment).index? %><%= link_to payments_path, class: "flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-[10px] font-medium #{nav_active?('payments') ? 'text-brand' : 'text-ink-muted'}", aria: (nav_active?("payments") ? { current: "page" } : {}) do %><%= ui_icon("payments", size: 20) %><span><%= t("navigation.payments") %></span><% end %><% else %><span class="flex min-h-14 flex-col items-center justify-center gap-1 text-[10px] text-ink-muted/45"><%= ui_icon("payments", size: 20) %><span><%= t("navigation.payments") %></span></span><% end %>
    <button type="button" class="flex min-h-14 flex-col items-center justify-center gap-1 rounded-lg text-[10px] font-medium <%= nav_active?('measurement_profiles', 'measurements', 'designs', 'design_collections', 'design_collection_items', 'productions', 'production_tasks', 'inventory_items', 'stock_movements', 'deliveries', 'expenses', 'reports', 'staff', 'attendance_records', 'leave_requests', 'work_shifts', 'staff_invitations', 'payment_settings') ? 'text-brand' : 'text-ink-muted' %>" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="mobile-more-menu" aria-expanded="false"><%= ui_icon("more", size: 20) %><span><%= t("navigation.more") %></span></button>
  </nav>
  <%= render "shared/mobile_more_menu" %>
</div>
