<% if local_assigns[:full] || !user_signed_in? %>
  <%= link_to root_path, class: "group mx-auto flex w-fit flex-col items-center rounded-xl text-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2", aria: { label: t("app.name") } do %>
    <%= image_tag "/puitei-mark.svg", alt: "", width: 512, height: 512, class: "auth-brand-logo size-16 rounded-2xl shadow-card ring-1 ring-[#d9a441]/25" %>
    <span class="mt-3 text-[17px] font-semibold tracking-[-0.025em] text-ink"><%= t("app.name") %></span>
    <span class="mt-0.5 text-[10px] font-semibold uppercase tracking-[0.16em] text-gold"><%= t("app.tagline") %></span>
  <% end %>
<% else %>
  <%= link_to root_path, class: "group flex min-w-0 items-center gap-2.5", aria: { label: t("app.name") } do %>
    <span class="grid size-10 shrink-0 place-items-center overflow-hidden rounded-[11px] bg-[#00142a] shadow-sm ring-1 ring-[#d9a441]/25">
      <%= image_tag "/puitei-mark.svg", alt: "", width: 512, height: 512, class: "size-full object-cover" %>
    </span>
    <span class="min-w-0">
      <span class="block truncate text-[14px] font-semibold leading-5 tracking-[-0.025em] text-ink"><%= t("app.name") %></span>
      <span class="block truncate text-[10px] leading-4 text-ink-muted"><%= t("app.tagline") %></span>
    </span>
  <% end %>
<% end %>
