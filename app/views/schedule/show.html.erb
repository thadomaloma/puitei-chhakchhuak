<% content_for :title, t("schedule.title") %>

<%= render "shared/page_header",
  eyebrow: t("schedule.eyebrow"),
  title: (@my_schedule ? t("schedule.my_schedule") : t("schedule.title")),
  description: t("schedule.description") %>

<div class="mt-5 flex flex-wrap items-center gap-2" role="tablist" aria-label="<%= t('schedule.title') %>">
  <%= link_to t("schedule.today"), schedule_path(request.query_parameters.except("view", "date")),
    class: "button-#{@view == 'today' ? 'primary' : 'secondary'} button-sm", role: "tab",
    aria: (@view == "today" ? { selected: "true" } : { selected: "false" }) %>
  <%= link_to t("schedule.week"), schedule_path(request.query_parameters.merge(view: "week")),
    class: "button-#{@view == 'week' ? 'primary' : 'secondary'} button-sm", role: "tab",
    aria: (@view == "week" ? { selected: "true" } : { selected: "false" }) %>
</div>

<%= form_with url: schedule_path, method: :get, class: "toolbar mt-4" do |form| %>
  <%= form.hidden_field :view, value: @view %>
  <div class="grid gap-3 sm:grid-cols-[minmax(14rem,1fr)_9rem_9rem_auto] sm:items-end">
    <div>
      <%= form.label :query, t("schedule.search"), class: "mb-1.5 block text-xs font-semibold text-ink" %>
      <div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, value: params[:query], placeholder: t("schedule.search"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div>
    </div>
    <div>
      <%= form.label :type, t("schedule.types.all"), class: "mb-1.5 block text-xs font-semibold text-ink" %>
      <%= form.select :type, [ [ t("schedule.types.all"), "" ], [ t("schedule.types.fitting"), "fitting" ], [ t("schedule.types.delivery"), "delivery" ] ], { selected: @type }, class: "form-input mt-0" %>
    </div>
    <% if @can_filter_staff %>
      <div>
        <%= form.label :staff_id, t("navigation.staff"), class: "mb-1.5 block text-xs font-semibold text-ink" %>
        <%= form.select :staff_id, @staff_options.map { |staff| [ staff.name, staff.id ] }, { include_blank: t("schedule.all_staff"), selected: @staff_id }, class: "form-input mt-0" %>
      </div>
    <% end %>
    <%= form.submit t("forms.search"), class: "button-primary" %>
  </div>
<% end %>

<% if @view == "today" %>
  <% if @query.fitting_entries.empty? && @query.delivery_entries.empty? && @query.overdue_entries.empty? %>
    <div class="mt-5"><%= render "shared/empty_state", title: t("schedule.empty_today"), description: t("schedule.empty_today_description"), icon: "calendar" %></div>
  <% else %>
    <div class="mt-5 space-y-6">
      <% if @type != "delivery" %>
        <section aria-labelledby="schedule-fittings-title">
          <h2 id="schedule-fittings-title" class="section-title"><%= t("schedule.trials_today") %> · <%= @query.fitting_entries.size %></h2>
          <% if @query.fitting_entries.any? %>
            <div class="mt-3 grid gap-3 md:grid-cols-2"><%= render partial: "schedule/entry", collection: @query.fitting_entries, as: :entry %></div>
          <% else %>
            <div class="mt-3"><%= render "shared/empty_state", title: t("schedule.empty_fittings"), icon: "ruler" %></div>
          <% end %>
        </section>
      <% end %>

      <% if @type != "fitting" %>
        <section aria-labelledby="schedule-deliveries-title">
          <h2 id="schedule-deliveries-title" class="section-title"><%= t("schedule.deliveries_today") %> · <%= @query.delivery_entries.size %></h2>
          <% if @query.delivery_entries.any? %>
            <div class="mt-3 grid gap-3 md:grid-cols-2"><%= render partial: "schedule/entry", collection: @query.delivery_entries, as: :entry %></div>
          <% else %>
            <div class="mt-3"><%= render "shared/empty_state", title: t("schedule.empty_deliveries"), icon: "delivery" %></div>
          <% end %>
        </section>
      <% end %>

      <% if @query.overdue_entries.any? %>
        <section aria-labelledby="schedule-overdue-title">
          <h2 id="schedule-overdue-title" class="section-title text-[#b42318]"><%= t("schedule.overdue") %> · <%= @query.overdue_entries.size %></h2>
          <p class="supporting-text"><%= t("schedule.overdue_description") %></p>
          <div class="mt-3 grid gap-3 md:grid-cols-2"><%= render partial: "schedule/entry", collection: @query.overdue_entries, as: :entry %></div>
        </section>
      <% end %>
    </div>
  <% end %>
<% else %>
  <div class="mt-5 flex items-center justify-between gap-2">
    <%= link_to t("schedule.previous_week"), schedule_path(request.query_parameters.merge(view: "week", date: (@anchor - 7).iso8601)), class: "button-secondary button-sm" %>
    <p class="text-sm font-semibold text-ink"><%= l(@from, format: :short) %> – <%= l(@to, format: :short) %></p>
    <%= link_to t("schedule.next_week"), schedule_path(request.query_parameters.merge(view: "week", date: (@anchor + 7).iso8601)), class: "button-secondary button-sm" %>
  </div>
  <% if @anchor != Date.current %><div class="mt-2 text-center"><%= link_to t("schedule.back_to_today"), schedule_path(request.query_parameters.except("date").merge(view: "week")), class: "text-xs font-semibold text-brand" %></div><% end %>

  <% grouped = @query.grouped_by_date %>
  <% if grouped.empty? %>
    <div class="mt-5"><%= render "shared/empty_state", title: t("schedule.empty_week"), icon: "calendar" %></div>
  <% else %>
    <div class="mt-5 space-y-6">
      <% grouped.each do |date, day_entries| %>
        <section>
          <h2 class="section-title"><%= l(date, format: :long) %></h2>
          <div class="mt-3 grid gap-3 md:grid-cols-2"><%= render partial: "schedule/entry", collection: day_entries, as: :entry %></div>
        </section>
      <% end %>
    </div>
  <% end %>

  <% if @query.overdue_entries.any? %>
    <section class="mt-6" aria-labelledby="schedule-overdue-title">
      <h2 id="schedule-overdue-title" class="section-title text-[#b42318]"><%= t("schedule.overdue") %> · <%= @query.overdue_entries.size %></h2>
      <p class="supporting-text"><%= t("schedule.overdue_description") %></p>
      <div class="mt-3 grid gap-3 md:grid-cols-2"><%= render partial: "schedule/entry", collection: @query.overdue_entries, as: :entry %></div>
    </section>
  <% end %>
<% end %>
