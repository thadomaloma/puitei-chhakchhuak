<article class="card p-4">
  <div class="flex items-start justify-between gap-3">
    <div class="flex min-w-0 items-start gap-2.5">
      <span class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-lg bg-surface-muted text-emerald-refined"><%= ui_icon(schedule_entry_icon(entry), size: 16) %></span>
      <div class="min-w-0">
        <p class="font-mono text-[11px] font-semibold text-brand"><%= entry.order.order_number %></p>
        <%= link_to entry.customer.full_name, entry.customer, class: "mt-0.5 block truncate text-base font-semibold tracking-[-0.01em] text-ink" %>
        <p class="mt-0.5 truncate text-xs text-ink-muted"><%= entry.order.order_items.map(&:garment_name).to_sentence %></p>
      </div>
    </div>
    <%= order_status_badge(entry.order) %>
  </div>
  <div class="mt-3 border-t border-line pt-3">
    <p class="text-xs <%= entry.overdue ? 'font-semibold text-[#b42318]' : 'text-ink-muted' %>"><%= schedule_entry_label(entry) %></p>
    <% if entry.delivery? && policy(Payment).index? && entry.order.balance_due.positive? %>
      <p class="mt-1 text-xs font-semibold text-[#b42318]"><%= t("schedule.balance_due", amount: money(entry.order.balance_due, entry.order.currency)) %></p>
    <% end %>
    <div class="mt-3 flex flex-wrap items-center gap-1.5">
      <% if entry.customer.phone_number.present? %><%= link_to t("schedule.call"), "tel:#{entry.customer.phone_number}", class: "button-ghost button-sm" %><% end %>
      <% if (url = whatsapp_url(entry.customer.whatsapp_number)) %><%= link_to t("schedule.whatsapp"), url, class: "button-ghost button-sm", target: "_blank", rel: "noreferrer" %><% end %>
      <%= link_to t("schedule.view_order"), entry.order, class: "button-secondary button-sm ml-auto" %>
    </div>
  </div>
</article>
