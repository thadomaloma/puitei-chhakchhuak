<%= form_with model: design_collection, class: "space-y-5" do |form| %>
  <%= render "shared/form_errors", record: design_collection %>
  <section class="form-section"><div><p class="eyebrow"><%= t("design_collections.details_eyebrow") %></p><h2 class="section-title mt-1"><%= t("design_collections.details") %></h2><p class="supporting-text mt-1"><%= t("design_collections.details_description") %></p></div>
    <div class="mt-5 space-y-4"><div><%= form.label :name, t("design_collections.name"), class: "form-label" %><%= form.text_field :name, class: "form-input", required: true, maxlength: 120, autofocus: true, placeholder: t("design_collections.name_placeholder") %></div><div><%= form.label :description, t("design_collections.collection_description"), class: "form-label" %><%= form.text_area :description, class: "form-input min-h-28", rows: 4, maxlength: 1000, placeholder: t("design_collections.description_placeholder") %></div><div><%= form.label :visibility, t("design_collections.visibility"), class: "form-label" %><%= form.select :visibility, DesignCollection.visibilities.keys.map { |visibility| [t("design_collections.visibilities.#{visibility}"), visibility] }, {}, class: "form-input" %><p class="mt-1 text-[11px] leading-5 text-ink-muted"><%= t("design_collections.visibility_hint") %></p></div></div>
  </section>
  <% if design_collection.persisted? %>
    <section class="form-section"><div><p class="eyebrow"><%= t("design_collections.cover_preview") %></p><h2 class="section-title mt-1"><%= t("design_collections.cover_section") %></h2><p class="supporting-text mt-1"><%= t("design_collections.cover_section_description") %></p></div>
      <div class="mt-4 grid gap-4 sm:grid-cols-[13rem_minmax(0,1fr)] sm:items-center"><div class="aspect-[16/10] overflow-hidden rounded-xl border border-line bg-surface-muted"><%= render "design_collections/cover_image", cover_design: @cover_design, alt: t("design_collections.cover_alt", collection: design_collection.name, design: @cover_design&.title || design_collection.name) %></div><div><p class="text-sm font-semibold text-ink"><%= @cover_design&.title || t("design_collections.cover_placeholder") %></p><p class="mt-1 text-xs leading-5 text-ink-muted"><%= t("design_collections.automatic_cover_hint") %></p><div class="mt-3 flex flex-wrap gap-2"><%= link_to t("design_collections.choose_cover_from_designs"), design_collection_path(design_collection, anchor: "collection-designs"), class: "button-secondary button-sm" %><% if policy(design_collection).set_cover? && design_collection.cover_design_id.present? %><%= link_to t("design_collections.use_automatic_cover"), set_cover_design_collection_path(design_collection), class: "button-ghost button-sm", data: { turbo_method: :patch } %><% end %></div></div></div>
    </section>
  <% end %>
  <div class="flex flex-col-reverse gap-2 sm:flex-row sm:justify-end"><%= link_to t("forms.cancel"), (design_collection.persisted? ? design_collection : design_collections_path), class: "button-secondary" %><%= form.submit t("design_collections.save"), class: "button-primary" %></div>
<% end %>
