<% content_for :title, t("design_collections.index_title") %>
<% current_collection_filters = collection_filter_params(@filter_params) %>
<% collection_active_filters = active_collection_filters(current_collection_filters) %>
<% secondary_filter_count = active_collection_filter_count(current_collection_filters) %>
<%= render "shared/page_header", eyebrow: t("design_collections.eyebrow"), title: t("design_collections.collections"), description: t("design_collections.description", count: @total_count), action: (link_to(ui_icon("plus", size: 17) + t("design_collections.create"), new_design_collection_path, class: "button-primary") if @can_create_collection) %>
<%= render "shared/design_studio_navigation" %>

<nav class="mt-4 segmented-control w-max" aria-label="<%= t('design_collections.status_filter') %>"><% [["active", nil], ["archived", "archived"], ["all", "all"]].each do |label, value| %><% selected = @status == label %><%= link_to t("design_collections.statuses.#{label}"), design_collections_path(current_collection_filters.except(:status).merge(status: value).compact), class: "segmented-item #{'segmented-item-active' if selected}", aria: (selected ? { current: "page" } : {}) %><% end %></nav>

<%= form_with url: design_collections_path, method: :get, class: "filter-command-bar mt-5 hidden md:!flex" do |form| %>
  <%= form.hidden_field :status, value: @status unless @status == "active" %>
  <div class="relative min-w-0 flex-1"><%= form.label :query, t("design_collections.search"), for: "collection_query_desktop", class: "sr-only" %><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, id: "collection_query_desktop", value: @query, maxlength: SearchQueryNormalization::SEARCH_QUERY_MAX_LENGTH, class: "form-input mt-0 pl-9", placeholder: t("design_collections.search_placeholder") %></div>
  <%= form.label :visibility, t("design_collections.visibility_filter"), for: "collection_visibility_desktop", class: "sr-only" %><%= form.select :visibility, DesignCollection.visibilities.keys.map { |visibility| [t("design_collections.visibilities.#{visibility}"), visibility] }, { include_blank: t("design_collections.all_visibilities"), selected: @visibility }, id: "collection_visibility_desktop", class: "form-input mt-0 w-full sm:w-auto sm:min-w-44" %>
  <%= form.button class: "button-secondary button-icon", aria: { label: t("design_collections.search") } do %><%= ui_icon("search", size: 16) %><% end %>
  <% if @filters_active %><%= link_to t("design_collections.clear_filters"), clear_collection_filters_path, class: "button-ghost button-sm shrink-0", data: { testid: "desktop-clear-collection-filters" } %><% end %>
<% end %>

<%= form_with url: design_collections_path, method: :get, class: "mt-5 md:hidden", data: { controller: "mobile-menu", action: "keydown.esc@window->mobile-menu#close keydown.tab@window->mobile-menu#trapFocus" } do |form| %>
  <div class="relative"><%= form.label :query, t("design_collections.search"), for: "collection_query_mobile", class: "sr-only" %><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, id: "collection_query_mobile", value: @query, maxlength: SearchQueryNormalization::SEARCH_QUERY_MAX_LENGTH, class: "form-input mt-0 pl-9 #{@query.present? ? 'pr-12' : ''}", placeholder: t("design_collections.search_placeholder") %><% if @query.present? %><%= link_to ui_icon("x", size: 15), remove_collection_filter_path(:query, current_collection_filters), class: "absolute inset-y-0 right-0 grid w-11 place-items-center rounded-r-lg text-ink-muted transition-colors hover:text-ink", aria: { label: t("design_collections.clear_search") } %><% end %></div>
  <div class="mt-2 grid grid-cols-2 gap-2"><button id="collection-filter-button" type="button" class="button-secondary" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="collection-filter-panel" aria-haspopup="dialog" aria-expanded="false"><%= ui_icon("settings", size: 16) %><span><%= secondary_filter_count.positive? ? t("design_collections.filters_with_count", count: secondary_filter_count) : t("design_collections.filters") %></span></button><%= form.submit t("design_collections.search"), class: "button-primary" %></div>
  <div id="collection-filter-panel" class="hidden" data-mobile-menu-target="panel" hidden aria-hidden="true"><button type="button" class="fixed inset-0 z-40 bg-ink/30 backdrop-blur-[2px]" aria-label="<%= t('forms.close') %>" data-action="mobile-menu#close"></button><section role="dialog" aria-modal="true" aria-labelledby="collection-filter-title" aria-describedby="collection-filter-description" class="safe-bottom-sheet fixed inset-x-0 bottom-0 z-50 max-h-[88dvh] overflow-y-auto rounded-t-2xl border border-line bg-surface p-4 shadow-2xl"><div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong"></div><div class="flex items-start justify-between gap-4"><div><p class="eyebrow"><%= t("design_collections.eyebrow") %></p><h2 id="collection-filter-title" class="mt-1 text-lg font-semibold text-ink"><%= t("design_collections.filter_collections") %></h2><p id="collection-filter-description" class="mt-1 text-xs leading-5 text-ink-muted"><%= t("design_collections.filter_description") %></p></div><button type="button" class="button-secondary button-icon" aria-label="<%= t('forms.close') %>" data-mobile-menu-target="close" data-action="mobile-menu#close"><%= ui_icon("x", size: 17) %></button></div><div class="mt-5 space-y-4"><div><%= form.label :status, t("design_collections.status_filter"), for: "collection_status_mobile", class: "form-label" %><%= form.select :status, [[t("design_collections.statuses.active"), ""], [t("design_collections.statuses.archived"), "archived"], [t("design_collections.statuses.all"), "all"]], { selected: (@status == "active" ? "" : @status) }, id: "collection_status_mobile", class: "form-input" %></div><div><%= form.label :visibility, t("design_collections.visibility_filter"), for: "collection_visibility_mobile", class: "form-label" %><%= form.select :visibility, DesignCollection.visibilities.keys.map { |visibility| [t("design_collections.visibilities.#{visibility}"), visibility] }, { include_blank: t("design_collections.all_visibilities"), selected: @visibility }, id: "collection_visibility_mobile", class: "form-input" %></div></div><div class="mt-5 grid grid-cols-2 gap-2"><%= link_to t("design_collections.reset_filter_options"), reset_collection_secondary_filters_path(current_collection_filters), class: "button-secondary" %><%= form.submit t("design_collections.apply_filters"), class: "button-primary" %></div></section></div>
<% end %>

<%= render "active_filters",
  active_filters: collection_active_filters,
  clear_all_path: clear_collection_filters_path,
  label: t("design_collections.active_collection_filters") %>

<p class="<%= @filters_active ? 'mt-3' : 'mt-4' %> text-xs font-semibold text-ink-muted" data-testid="collection-result-summary"><%= design_collection_results_summary(count: @filtered_count, query: @query) %></p>

<% if @design_collections.any? %>
  <div class="collection-grid mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><% @design_collections.each do |collection| %><%= render "collection_card", collection: collection, cover_design: @cover_designs[collection.id] %><% end %></div>
  <% if @pagy.previous || @pagy.next %><nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), design_collections_path(current_collection_filters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), design_collections_path(current_collection_filters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% end %>
<% else %>
  <% if @query.present? %><% empty_title = t("design_collections.no_results", query: @query) %><% empty_description = t("design_collections.no_results_description", query: @query) %><% empty_action = link_to(t("design_collections.clear_filters"), clear_collection_filters_path, class: "button-secondary") %>
  <% elsif !@collections_exist %><% empty_title = t("design_collections.empty") %><% empty_description = t("design_collections.empty_description") %><% empty_action = link_to(t("design_collections.create"), new_design_collection_path, class: "button-primary") if @can_create_collection %>
  <% elsif @status == "archived" && @visibility.blank? %><% empty_title = t("design_collections.empty_archived") %><% empty_description = t("design_collections.empty_archived_description") %><% empty_action = link_to(t("design_collections.clear_filters"), clear_collection_filters_path, class: "button-secondary") %>
  <% elsif @status == "active" && @visibility.blank? %><% empty_title = t("design_collections.empty_active") %><% empty_description = t("design_collections.empty_active_description") %><% empty_action = link_to(t("design_collections.statuses.archived"), design_collections_path(status: "archived"), class: "button-secondary") %>
  <% else %><% empty_title = t("design_collections.no_filtered_results") %><% empty_description = t("design_collections.no_filtered_results_description") %><% empty_action = link_to(t("design_collections.clear_filters"), clear_collection_filters_path, class: "button-secondary") %><% end %>
  <div class="mt-5"><%= render "shared/empty_state", title: empty_title, description: empty_description, icon: "designs", action: empty_action %></div>
<% end %>
