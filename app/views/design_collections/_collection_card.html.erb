<article class="group relative z-0 flex h-full flex-col rounded-2xl border border-line bg-surface shadow-card transition hover:z-20 hover:-translate-y-0.5 hover:border-line-strong hover:shadow-card-hover focus-within:z-20 motion-reduce:transition-none motion-reduce:hover:transform-none">
  <%= link_to design_collection_path(collection), class: "block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand" do %>
    <div class="relative aspect-[16/10] overflow-hidden rounded-t-2xl bg-surface-muted">
      <%= render "design_collections/cover_image", cover_design: cover_design, alt: t("design_collections.cover_alt", collection: collection.name, design: cover_design&.title || collection.name), class_name: "transition duration-300 group-hover:scale-[1.02] motion-reduce:transition-none motion-reduce:group-hover:transform-none" %>
      <span class="absolute left-3 top-3 status-badge status-neutral"><%= t("design_collections.visibilities.#{collection.visibility}") %></span>
      <% unless collection.active? %><span class="absolute bottom-3 left-3 status-badge status-neutral"><%= t("design_collections.statuses.archived") %></span><% end %>
      <% if collection.cover_design_id.present? && collection.cover_design_id == cover_design&.id %><span class="absolute right-3 top-3 status-badge status-warning"><%= t("design_collections.manual_cover") %></span><% end %>
    </div>
  <% end %>
  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-start justify-between gap-3"><div class="min-w-0"><%= link_to collection.name, design_collection_path(collection), class: "line-clamp-1 text-base font-semibold text-ink hover:text-brand" %><p class="mt-1 text-[11px] font-medium text-ink-muted"><%= t("design_collections.design_count", count: collection.design_collection_items_count) %> · <%= t(collection.active? ? "design_collections.updated_at" : "design_collections.archived_at", date: l((collection.archived_at || collection.updated_at).to_date)) %></p></div>
      <% if policy(collection).update? || policy(collection).archive? || policy(collection).restore? %><details class="relative shrink-0" data-controller="popover" data-action="toggle->popover#keepOneOpen click@window->popover#closeOnOutside keydown.esc@window->popover#closeOnEscape"><summary class="button-ghost button-icon button-sm cursor-pointer list-none" aria-label="<%= t('design_collections.actions') %>"><%= ui_icon("more", size: 17) %></summary><div class="filter-popover right-0 w-48 p-2"><%= link_to t("forms.view"), collection, class: "block rounded-lg px-3 py-2 text-xs font-semibold text-ink hover:bg-surface-muted" %><% if policy(collection).update? %><%= link_to t("forms.edit"), edit_design_collection_path(collection), class: "block rounded-lg px-3 py-2 text-xs font-semibold text-ink hover:bg-surface-muted" %><%= link_to t("design_collections.add_designs"), new_design_collection_design_collection_item_path(collection), class: "block rounded-lg px-3 py-2 text-xs font-semibold text-ink hover:bg-surface-muted" %><% end %><% if policy(collection).archive? %><%= button_to t("design_collections.archive"), archive_design_collection_path(collection), method: :patch, class: "block w-full rounded-lg px-3 py-2 text-left text-xs font-semibold text-[#b42318] hover:bg-[#fff5f4]", form: { data: { turbo_confirm: t("design_collections.archive_confirm") } } %><% elsif policy(collection).restore? %><%= button_to t("design_collections.restore"), restore_design_collection_path(collection), method: :patch, class: "block w-full rounded-lg px-3 py-2 text-left text-xs font-semibold text-ink hover:bg-surface-muted" %><% end %></div></details><% end %>
    </div>
    <p class="mt-3 line-clamp-2 min-h-10 text-xs leading-5 text-ink-muted"><%= collection.description.presence || t("design_collections.no_description") %></p>
  </div>
</article>
