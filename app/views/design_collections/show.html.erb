<% content_for :title, t("design_collections.show_title", name: @design_collection.name) %>
<%= render "shared/back_link", path: design_collections_path, label: t("design_collections.collections") %>
<% actions = [] %>
<% actions << link_to(t("forms.edit"), edit_design_collection_path(@design_collection), class: "button-secondary") if policy(@design_collection).update? %>
<% actions << button_to(t("design_collections.archive"), archive_design_collection_path(@design_collection), method: :patch, class: "button-secondary", form: { data: { turbo_confirm: t("design_collections.archive_confirm") } }) if policy(@design_collection).archive? %>
<% actions << button_to(t("design_collections.restore"), restore_design_collection_path(@design_collection), method: :patch, class: "button-primary") if policy(@design_collection).restore? %>
<% actions << link_to(ui_icon("plus", size: 16) + t("design_collections.add_designs"), new_design_collection_design_collection_item_path(@design_collection), class: "button-primary") if policy(@design_collection).manage_items? %>
<% actions = safe_join(actions, " ") %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("design_collections.visibilities.#{@design_collection.visibility}"), title: @design_collection.name, description: @design_collection.description.presence || t("design_collections.no_description"), action: actions.presence %></div>
<%= render "shared/design_studio_navigation" %>

<% unless @design_collection.active? %><div class="mt-4 rounded-2xl border border-[#fedf89] bg-[#fffcf5] p-4" role="status"><div class="flex items-start gap-3"><span class="mt-0.5 text-[#b54708]"><%= ui_icon("warning", size: 18) %></span><div><p class="text-sm font-semibold text-[#7a2e0e]"><%= t("design_collections.archived_banner") %></p><p class="mt-1 text-xs leading-5 text-[#9c4a1a]"><%= t("design_collections.archived_banner_description", date: l((@design_collection.archived_at || @design_collection.updated_at).to_date)) %></p></div></div></div><% end %>

<div class="mt-4 flex flex-wrap items-center gap-2"><%= status_badge(@design_collection.active? ? "active" : "archived", label: t("design_collections.statuses.#{@design_collection.active? ? 'active' : 'archived'}"), variant: @design_collection.active? ? "success" : "neutral") %><%= status_badge("count", label: t("design_collections.design_count", count: @design_collection.design_collection_items_count), variant: "info") %><span class="text-xs text-ink-muted"><%= t("design_collections.created_by", name: @design_collection.created_by.name, date: l(@design_collection.created_at.to_date)) %></span></div>

<section class="mt-5 overflow-hidden rounded-2xl border border-line bg-surface shadow-card" aria-labelledby="collection-cover-title">
  <div class="relative aspect-[16/9] max-h-[28rem] overflow-hidden bg-surface-muted sm:aspect-[16/7]">
    <%= render "cover_image", cover_design: @cover_design, alt: t("design_collections.cover_alt", collection: @design_collection.name, design: @cover_design&.title || @design_collection.name), loading: "eager" %>
    <span class="absolute bottom-3 left-3 status-badge <%= @design_collection.cover_design_id.present? && @design_collection.cover_design_id == @cover_design&.id ? 'status-warning' : 'status-neutral' %>"><%= t(@design_collection.cover_design_id.present? && @design_collection.cover_design_id == @cover_design&.id ? "design_collections.manual_cover" : "design_collections.automatic_cover") %></span>
  </div>
  <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
    <div><p class="eyebrow"><%= t("design_collections.cover_preview") %></p><h2 id="collection-cover-title" class="mt-1 text-sm font-semibold text-ink"><%= @cover_design&.title || t("design_collections.cover_placeholder") %></h2><p class="mt-1 text-xs leading-5 text-ink-muted"><%= t("design_collections.automatic_cover_hint") %></p></div>
    <% if policy(@design_collection).set_cover? && @design_collection.cover_design_id.present? %><%= button_to t("design_collections.use_automatic_cover"), set_cover_design_collection_path(@design_collection), method: :patch, class: "button-secondary button-sm", form: { class: "shrink-0" } %><% end %>
  </div>
</section>

<%= form_with url: design_collection_path(@design_collection), method: :get, class: "toolbar mt-5 grid gap-2 sm:grid-cols-[minmax(0,1fr)_minmax(10rem,auto)_auto]" do |form| %>
  <div class="relative min-w-0"><%= form.label :query, t("design_collections.search_within"), class: "sr-only" %><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, value: @query, maxlength: SearchQueryNormalization::SEARCH_QUERY_MAX_LENGTH, class: "form-input mt-0 pl-9", placeholder: t("design_collections.search_within") %></div>
  <div class="min-w-0"><%= form.label :garment_type, t("designs.garment_type"), class: "sr-only" %><%= form.select :garment_type, options_from_collection_for_select(@garment_templates, :garment_type, :name, @garment_type), { include_blank: t("designs.all_garments") }, class: "form-input mt-0 min-w-0" %></div>
  <%= form.submit t("designs.apply_filters"), class: "button-secondary" %>
<% end %>

<% if @filters_active %><% selected_garment = @garment_templates.find { |template| template.garment_type == @garment_type } %><div class="mt-3 flex flex-wrap items-center gap-2 text-xs" aria-label="<%= t('design_collections.active_filters') %>"><span class="mr-1 font-semibold text-ink-muted"><%= t("design_collections.active_filters") %></span><% if @query.present? %><%= render "shared/filter_chip", label: @query, path: design_collection_path(@design_collection, @filter_params.except(:query)), remove_label: t("design_collections.remove_filter", filter: @query) %><% end %><% if selected_garment %><%= render "shared/filter_chip", label: selected_garment.name, path: design_collection_path(@design_collection, @filter_params.except(:garment_type)), remove_label: t("design_collections.remove_filter", filter: selected_garment.name) %><% end %><span class="font-semibold text-ink" aria-live="polite"><%= t("design_collections.showing_design_count", count: @filtered_count) %></span><%= link_to t("forms.clear"), design_collection_path(@design_collection), class: "button-ghost button-sm" %></div><% end %>

<% if @designs.any? %><div id="collection-designs" class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5"><% @designs.each do |design| %><%= render "designs/design", design: design, design_collection: @design_collection, collection_item: @collection_items[design.id], cover_design: @cover_design %><% end %></div>
  <% if @pagy.previous || @pagy.next %><nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), design_collection_path(@design_collection, @filter_params.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), design_collection_path(@design_collection, @filter_params.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% end %>
<% else %><div class="mt-5"><%= render "shared/empty_state", title: t(@filters_active ? "design_collections.no_design_results" : "design_collections.empty_collection"), description: t(@filters_active ? "design_collections.no_design_results_description" : "design_collections.empty_collection_description"), icon: "designs", action: (@filters_active ? link_to(t("forms.clear"), design_collection_path(@design_collection), class: "button-secondary") : (link_to(t("design_collections.add_designs"), new_design_collection_design_collection_item_path(@design_collection), class: "button-primary") if policy(@design_collection).manage_items?)) %></div><% end %>
