<% content_for :title, @design_share.title.presence || @design_share.shop.name %>
<header class="flex flex-col gap-5 border-b border-line pb-6 sm:flex-row sm:items-center sm:justify-between"><div class="flex items-center gap-3"><% if @design_share.shop.logo.attached? %><%= image_tag @design_share.shop.logo, alt: "", class: "size-12 rounded-xl object-cover" %><% else %><%= image_tag "/puitei-mark.svg", alt: "", width: 512, height: 512, class: "size-12 rounded-xl object-cover" %><% end %><div><p class="eyebrow"><%= t("public_design_shares.private_preview") %></p><p class="mt-1 text-lg font-semibold text-ink"><%= @design_share.shop.name %></p></div></div><p class="text-xs text-ink-muted"><%= t("public_design_shares.expires_on", date: l(@design_share.expires_at.to_date)) %></p></header>

<section class="py-8 text-center"><p class="eyebrow"><%= @design_share.customer.full_name %></p><h1 class="mx-auto mt-2 max-w-3xl text-3xl font-semibold tracking-tight text-ink sm:text-4xl"><%= @design_share.title.presence || t("public_design_shares.title") %></h1><% if @design_share.message.present? %><p class="mx-auto mt-3 max-w-2xl whitespace-pre-line text-sm leading-6 text-ink-muted"><%= @design_share.message %></p><% end %></section>

<section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3"><% @design_share.design_share_items.each do |item| %><article id="design-<%= item.id %>" class="overflow-hidden rounded-2xl border border-line bg-surface shadow-card"><% if (image = item.design.primary_image_attachment) %><%= image_tag image.variant(:gallery), alt: item.design.title, class: "aspect-[4/5] w-full object-cover", loading: "lazy", width: 960, height: 1200 %><% end %><div class="p-4"><p class="eyebrow"><%= item.design.garment_type.humanize %></p><h2 class="mt-1 text-lg font-semibold text-ink"><%= item.design.title %></h2><p class="mt-2 line-clamp-3 text-xs leading-5 text-ink-muted"><%= item.design.description %></p><% details = [item.design.colour_family, item.design.fabric_type, item.design.occasion].compact_blank %><% if details.any? %><p class="mt-3 text-[11px] font-medium text-ink-muted"><%= details.join(" · ") %></p><% end %>
      <% if @design_share.allow_feedback? %><%= form_with url: public_design_share_feedback_path(token: params[:token]), method: :post, class: "mt-4 border-t border-line pt-4" do |form| %><%= hidden_field_tag :item_token, item.signed_id(purpose: :design_share_feedback, expires_in: 30.days) %><%= fields_for :design_share_item, item do |fields| %><%= fields.label :customer_reaction, t("public_design_shares.your_response"), class: "form-label" %><%= fields.select :customer_reaction, %w[liked shortlisted not_interested].map { |reaction| [t("public_design_shares.reactions.#{reaction}"), reaction] }, { include_blank: t("public_design_shares.choose_response") }, class: "form-input" %><%= fields.label :customer_comment, t("public_design_shares.comment"), class: "form-label mt-3" %><%= fields.text_area :customer_comment, rows: 2, maxlength: 1000, class: "form-input", placeholder: t("public_design_shares.comment_placeholder") %><%= form.submit t("public_design_shares.save_feedback"), class: "button-secondary mt-3 w-full" %><% end %><% end %><% end %>
    </div></article><% end %></section>
<footer class="mt-10 border-t border-line py-6 text-center"><p class="text-[11px] leading-5 text-ink-muted"><%= t("public_design_shares.private_notice") %></p><p class="mt-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-ink-faint"><%= t("app.name") %> · <%= t("app.tagline") %></p></footer>
