<section class="auth-card"><div class="mb-6"><%= render "shared/brand" %></div><p class="eyebrow"><%= t("saas.team_invitation") %></p><h1 class="page-title mt-1"><%= @invitation.shop.name %></h1><p class="supporting-text mt-1.5"><%= t("saas.join_as", role: @invitation.role.humanize) %></p><% if @acceptance_error %><div class="mt-4 rounded-lg border border-[#fecdca] bg-[#fef3f2] p-3 text-xs text-[#b42318]"><%= @acceptance_error %></div><% end %><% if user_signed_in? %><%= form_with url: staff_invitation_acceptance_path, method: :post, class: "mt-6" do |form| %><%= form.hidden_field :token, name: "staff_invitation_acceptance[token]", value: @token %><%= form.submit t("saas.accept_invitation"), class: "button-primary w-full" %><% end %><% else %><%= form_with model: @user, url: staff_invitation_acceptance_path, class: "mt-6 space-y-4" do |form| %><%= hidden_field_tag "staff_invitation_acceptance[token]", @token %><div><%= form.label :name, t("staff.name"), class: "form-label" %><%= form.text_field :name, class: "form-input", required: true %></div><div><%= form.label :email, class: "form-label" %><%= form.email_field :email, value: @invitation.email, class: "form-input", disabled: true %></div><div><%= form.label :password, t("staff.password"), class: "form-label" %><%= form.password_field :password, class: "form-input", required: true, minlength: 12 %></div><div><%= form.label :password_confirmation, t("staff.password_confirmation"), class: "form-label" %><%= form.password_field :password_confirmation, class: "form-input", required: true, minlength: 12 %></div><%= form.submit t("saas.create_account_join"), class: "button-primary w-full" %><% end %><% end %></section>
