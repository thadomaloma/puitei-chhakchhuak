<% content_for :title, t("staff.index_title") %>
<%= render "shared/page_header", eyebrow: t("staff.eyebrow"), title: t("staff.directory"), description: t("staff.description"), action: (link_to(ui_icon("plus", size: 17) + t("staff.new"), new_staff_path, class: "button-primary") if policy(User.new(branch: current_branch)).create?) %>

<section class="mt-5 grid grid-cols-2 gap-2 xl:grid-cols-4"><%= render "shared/stat_card", label: t("staff.active_staff"), value: @active_count, detail: t("staff.authorized_scope"), icon: "staff", tone: "success" %><%= render "shared/stat_card", label: t("staff.checked_in"), value: @checked_in_count, detail: l(Date.current), icon: "check", tone: "info" %><%= render "shared/stat_card", label: t("staff.pending_leave"), value: @pending_leave_count, detail: t("staff.needs_review"), icon: "calendar", tone: (@pending_leave_count.positive? ? "warning" : "neutral") %><%= render "shared/stat_card", label: t("staff.active_tasks"), value: @active_task_count, detail: t("staff.production_workload"), icon: "production", tone: "premium" %></section>

<nav class="mt-4 grid grid-cols-3 gap-2" aria-label="<%= t('staff.workforce_navigation') %>"><%= link_to attendance_records_path, class: "button-secondary button-sm" do %><%= ui_icon("clock", size: 15) %><%= t("attendance.title") %><% end %><%= link_to leave_requests_path, class: "button-secondary button-sm" do %><%= ui_icon("calendar", size: 15) %><%= t("leave_requests.title") %><% end %><%= link_to work_shifts_path, class: "button-secondary button-sm" do %><%= ui_icon("reports", size: 15) %><%= t("work_shifts.title") %><% end %></nav>

<%= form_with url: staff_index_path, method: :get, class: "toolbar mt-4 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_auto_auto]" do |form| %><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("staff.search"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("staff.search"), class: "form-input mt-0 pl-9" %></div><%= form.select :role, User.roles.keys.map { |role| [ t("staff.roles.#{role}"), role ] }, { include_blank: t("staff.all_roles"), selected: params[:role] }, class: "form-select mt-0", aria: { label: t("staff.role") } %><label class="flex min-h-10 items-center gap-2 rounded-lg border border-line px-3 text-xs font-medium text-ink-muted"><%= form.check_box :archived, { checked: params[:archived] == "1", class: "size-4 rounded border-line text-brand" }, "1", "0" %><%= t("staff.include_archived") %></label><%= form.submit t("forms.search"), class: "button-secondary" %><% end %>

<% if @staff_members.any? %><div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("staff.staff_member") %></th><th><%= t("staff.role") %></th><th><%= t("staff.contact") %></th><th><%= t("customers.branch") %></th><th><%= t("staff.status") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><% @staff_members.each do |member| %><% membership = staff_membership(member) %><tr><td><div class="flex items-center gap-3"><%= render "shared/avatar", name: member.name, size: "sm" %><div><%= link_to member.name, staff_path(member), class: "font-semibold text-ink hover:text-brand" %><p class="font-mono text-[10px] text-ink-muted"><%= membership.employee_code %></p></div></div></td><td><p class="font-medium text-ink"><%= t("staff.roles.#{membership.role}") %></p><p class="text-[11px] text-ink-muted"><%= member.job_title.presence || "—" %></p></td><td><p class="text-xs text-ink"><%= member.email %></p><p class="text-[11px] text-ink-muted"><%= member.phone_number.presence || "—" %></p></td><td class="text-ink-muted"><%= membership.branch.name %></td><td><%= status_badge(membership.active? ? "active" : "archived", label: membership.active? ? t("staff.active") : t("staff.archived_label"), variant: membership.active? ? "success" : "neutral") %></td><td class="text-right"><%= link_to staff_path(member), class: "button-ghost button-icon button-sm", aria: { label: t("forms.view") } do %><%= ui_icon("chevron-right", size: 15) %><% end %></td></tr><% end %></tbody></table></div>
<div class="mt-4 grid gap-2 md:grid-cols-2 xl:hidden"><% @staff_members.each do |member| %><% membership = staff_membership(member) %><%= link_to staff_path(member), class: "card block min-w-0 p-3.5" do %><div class="flex items-start gap-3"><%= render "shared/avatar", name: member.name, size: "sm" %><div class="min-w-0 flex-1"><div class="flex items-center justify-between gap-2"><p class="truncate text-sm font-semibold text-ink"><%= member.name %></p><%= status_badge(membership.active? ? "active" : "archived", label: membership.active? ? t("staff.active") : t("staff.archived_label"), variant: membership.active? ? "success" : "neutral") %></div><p class="mt-0.5 truncate text-[11px] text-ink-muted"><%= t("staff.roles.#{membership.role}") %> · <%= member.job_title.presence || membership.employee_code %></p><p class="mt-2 truncate border-t border-line pt-2 text-[11px] text-ink-muted"><%= member.email %></p></div></div><% end %><% end %></div>
<nav class="mt-4 flex items-center justify-between text-xs text-ink-muted"><% if @pagy.previous %><%= link_to t("forms.previous"), staff_index_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), staff_index_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("staff.empty"), description: t("staff.empty_description"), icon: "staff" %></div><% end %>
