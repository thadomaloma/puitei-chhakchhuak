<% content_for :title, @staff.name %>
<div class="flex flex-wrap items-center justify-between gap-3"><%= render "shared/back_link", path: (policy(User).index? ? staff_index_path : root_path), label: policy(User).index? ? t("staff.directory") : t("navigation.dashboard") %><% if policy(@staff).update? %><%= link_to t("staff.edit"), edit_staff_path(@staff), class: "button-primary" %><% end %></div>

<section class="section-card mt-4"><div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between"><div class="flex min-w-0 items-center gap-3"><%= render "shared/avatar", name: @staff.name, size: "lg" %><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><h1 class="truncate text-xl font-semibold tracking-tight text-ink"><%= @staff.name %></h1><%= status_badge(@staff_membership.active? ? "active" : "archived", label: @staff_membership.active? ? t("staff.active") : t("staff.archived_label"), variant: @staff_membership.active? ? "success" : "neutral") %></div><p class="mt-1 text-sm text-ink-muted"><%= t("staff.roles.#{@staff_membership.role}") %><% if @staff.job_title.present? %> · <%= @staff.job_title %><% end %></p><p class="mt-1 font-mono text-[10px] font-semibold text-emerald-refined"><%= @staff_membership.employee_code %></p></div></div><div class="sm:text-right"><p class="text-sm font-semibold text-ink"><%= @staff_membership.branch.name %></p><p class="mt-1 text-xs text-ink-muted"><%= t("staff.joined", date: l(@staff_membership.joined_on)) %></p></div></div>
<dl class="mt-5 grid gap-4 border-t border-line pt-4 sm:grid-cols-3"><div><dt class="detail-label"><%= t("staff.email") %></dt><dd class="detail-value break-all"><%= @staff.email %></dd></div><div><dt class="detail-label"><%= t("staff.phone") %></dt><dd class="detail-value"><%= @staff.phone_number.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("staff.emergency_contact") %></dt><dd class="detail-value"><%= @staff.emergency_contact.presence || "—" %></dd></div></dl>
<% if policy(@staff).compensation? %><div class="mt-4 rounded-lg border border-line bg-surface-muted/55 p-3"><p class="detail-label"><%= t("staff.compensation") %></p><div class="mt-1 flex items-end justify-between gap-3"><p class="text-sm font-medium text-ink"><%= t("staff.pay_bases.#{@staff_membership.pay_basis}") %></p><p class="tabular text-lg font-semibold text-ink"><%= money(@staff_membership.pay_rate, @staff_membership.branch.shop_setting.currency) %></p></div></div><% end %>
</section>

<section class="mt-4 grid grid-cols-2 gap-2 lg:grid-cols-4"><%= render "shared/stat_card", label: t("staff.active_tasks"), value: @active_tasks, detail: t("staff.current_workload"), icon: "production", tone: "info", href: production_path(mine: (@staff == current_user ? "1" : nil)) %><%= render "shared/stat_card", label: t("staff.completed_month"), value: @completed_this_month, detail: l(Date.current, format: "%B %Y"), icon: "check", tone: "success" %><%= render "shared/stat_card", label: t("staff.attendance_hours"), value: number_with_precision(@attendance_hours, precision: 1), detail: t("staff.recent_records"), icon: "clock", tone: "premium", href: attendance_records_path(user_id: @staff.id) %><%= render "shared/stat_card", label: t("staff.upcoming_shifts"), value: @upcoming_shifts.size, detail: t("staff.next_scheduled"), icon: "calendar", tone: "neutral", href: work_shifts_path(user_id: @staff.id) %></section>

<div class="mt-4 grid gap-4 xl:grid-cols-2"><section class="section-card"><div class="flex items-center justify-between"><div><h2 class="section-title"><%= t("attendance.recent") %></h2><p class="supporting-text"><%= t("attendance.recent_description") %></p></div><%= link_to t("dashboard.view_all"), attendance_records_path(user_id: @staff.id), class: "button-ghost button-sm" %></div><% if @attendance_records.any? %><div class="mt-3 divide-y divide-line"><% @attendance_records.each do |record| %><div class="flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0"><div><p class="text-xs font-semibold text-ink"><%= l(record.work_date, format: :long) %></p><p class="mt-0.5 text-[11px] text-ink-muted"><%= l(record.checked_in_at, format: :short) %><% if record.checked_out_at %> → <%= l(record.checked_out_at, format: :short) %><% end %></p></div><span class="tabular text-xs font-semibold text-ink"><%= record.checked_out? ? t("attendance.hours", hours: number_with_precision(record.duration_hours, precision: 1)) : t("attendance.in_progress") %></span></div><% end %></div><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("attendance.empty"), description: t("attendance.empty_description"), icon: "clock" %></div><% end %></section>

<section class="section-card"><div class="flex items-center justify-between"><div><h2 class="section-title"><%= t("work_shifts.upcoming") %></h2><p class="supporting-text"><%= t("work_shifts.upcoming_description") %></p></div><%= link_to t("dashboard.view_all"), work_shifts_path(user_id: @staff.id), class: "button-ghost button-sm" %></div><% if @upcoming_shifts.any? %><div class="mt-3 divide-y divide-line"><% @upcoming_shifts.each do |shift| %><div class="flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0"><div><p class="text-xs font-semibold text-ink"><%= l(shift.starts_at, format: :short) %></p><p class="text-[11px] text-ink-muted"><%= shift.location.presence || @staff_membership.branch.name %></p></div><p class="tabular text-xs text-ink-muted"><%= l(shift.ends_at, format: :short) %></p></div><% end %></div><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("work_shifts.empty_upcoming"), description: t("work_shifts.empty_upcoming_description"), icon: "calendar" %></div><% end %></section></div>

<div class="mt-4 grid gap-4 xl:grid-cols-2"><section class="section-card"><div class="flex items-center justify-between"><div><h2 class="section-title"><%= t("leave_requests.history") %></h2><p class="supporting-text"><%= t("leave_requests.history_description") %></p></div><%= link_to t("dashboard.view_all"), leave_requests_path, class: "button-ghost button-sm" %></div><% if @leave_requests.any? %><div class="mt-3 divide-y divide-line"><% @leave_requests.each do |request| %><div class="flex items-center justify-between gap-3 py-2.5 first:pt-0 last:pb-0"><div><p class="text-xs font-semibold text-ink"><%= t("leave_requests.types.#{request.leave_type}") %></p><p class="text-[11px] text-ink-muted"><%= l(request.starts_on) %> – <%= l(request.ends_on) %></p></div><%= leave_status_badge(request) %></div><% end %></div><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("leave_requests.empty"), description: t("leave_requests.empty_description"), icon: "calendar" %></div><% end %></section>

<section class="section-card"><h2 class="section-title"><%= t("staff.activity_log") %></h2><p class="supporting-text"><%= t("staff.activity_log_description") %></p><% if @staff_events.any? %><ol class="mt-3 space-y-3"><% @staff_events.each do |event| %><li class="flex gap-3"><span class="mt-1.5 size-2 shrink-0 rounded-full bg-gold"></span><div class="min-w-0"><p class="text-xs font-semibold text-ink"><%= t("staff.events.#{event.event_type}") %></p><p class="mt-0.5 text-[11px] text-ink-muted"><%= event.actor.name %> · <%= l(event.happened_at, format: :short) %></p></div></li><% end %></ol><% else %><div class="mt-3"><%= render "shared/empty_state", title: t("staff.no_activity"), description: t("staff.no_activity_description"), icon: "reports" %></div><% end %></section></div>

<% if policy(@staff).archive? %><section class="mt-4 rounded-xl border border-red-100 bg-surface p-4"><h2 class="text-sm font-semibold text-[#b42318]"><%= t("staff.archive_account") %></h2><p class="mt-1 text-xs text-ink-muted"><%= t("staff.archive_description") %></p><%= button_to t("staff.archive"), archive_staff_path(@staff), method: :patch, class: "button-danger mt-3", data: { turbo_confirm: t("staff.archive_confirm") } %></section><% end %>
