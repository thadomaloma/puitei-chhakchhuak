<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="#00142a">
    <meta name="robots" content="noindex,nofollow">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <link rel="icon" href="/puitei-mark.svg?v=1" type="image/svg+xml" sizes="any">
    <link rel="icon" href="/favicon-32.png?v=4" type="image/png" sizes="32x32">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %><%= javascript_importmap_tags %>
  </head>
  <body class="app-canvas min-h-screen">
    <a href="#main-content" class="fixed left-3 top-3 z-[100] -translate-y-20 rounded-lg bg-brand px-3 py-2 text-sm font-semibold text-white focus:translate-y-0"><%= t("forms.skip_to_content") %></a>
    <%= render "shared/flash" %>
    <main id="main-content" class="mx-auto min-h-screen w-full max-w-6xl px-4 py-6 sm:px-6 sm:py-10" tabindex="-1"><%= yield %></main>
  </body>
</html>
