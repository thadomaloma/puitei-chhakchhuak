<% content_for :title, t("saas.staff_invitations") %><%= render "shared/page_header", eyebrow: t("saas.team_access"), title: t("saas.staff_invitations"), description: t("saas.invitations_description"), action: link_to(t("staff.directory"), staff_index_path, class: "button-secondary") %><div class="mt-5 grid gap-4 lg:grid-cols-[22rem_minmax(0,1fr)]"><section class="form-section"><h2 class="section-title"><%= t("saas.invite_staff") %></h2><%= form_with model: @invitation, class: "mt-4 space-y-4" do |form| %><%= render "shared/form_errors", record: @invitation %><div><%= form.label :email, t("saas.work_email"), class: "form-label" %><%= form.email_field :email, class: "form-input", required: true %></div><div><%= form.label :role, t("staff.role"), class: "form-label" %><%= form.select :role, StaffInvitation.roles.keys.map { |role| [t("staff.roles.#{role}"), role] }, {}, class: "form-input" %></div><div><%= form.label :branch_id, t("customers.branch"), class: "form-label" %><%= form.collection_select :branch_id, policy_scope(Branch).active, :id, :name, {}, class: "form-input" %></div><%= form.submit t("saas.send_invitation"), class: "button-primary w-full" %><% end %></section><section class="section-card"><h2 class="section-title"><%= t("saas.invitation_history") %></h2><div class="mt-4 divide-y divide-line"><% @invitations.each do |invitation| %><div class="flex items-center justify-between gap-3 py-3"><div><p class="text-sm font-semibold text-ink"><%= invitation.email %></p><p class="text-[11px] text-ink-muted"><%= invitation.role.humanize %> · <%= invitation.branch.name %> · <%= l(invitation.expires_at.to_date) %></p></div><% if invitation.usable? %><%= button_to t("saas.revoke"), staff_invitation_path(invitation), method: :delete, class: "button-danger button-sm" %><% elsif invitation.accepted_at %><%= status_badge("completed", label: t("saas.accepted"), variant: "success") %><% else %><%= status_badge("expired", label: t("saas.expired"), variant: "neutral") %><% end %></div><% end %></div></section></div>
