<% priority_count = @upcoming_groups.sum { |group| group[:count] } %>
<section class="section-card overflow-hidden p-0 sm:p-0" aria-labelledby="today-priorities-title">
  <header class="flex items-start justify-between gap-4 border-b border-line bg-[linear-gradient(135deg,#fffdf8_0%,#f7f4eb_100%)] px-4 py-4 sm:px-5">
    <div class="flex min-w-0 items-start gap-3">
      <span class="grid size-9 shrink-0 place-items-center rounded-lg border border-[#ead9a8] bg-[#fff9e8] text-[#8b6914]"><%= ui_icon("calendar", size: 17) %></span>
      <div class="min-w-0">
        <h2 id="today-priorities-title" class="section-title"><%= t("dashboard.today_priorities") %></h2>
        <p class="supporting-text mt-0.5"><%= t("dashboard.today_priorities_description") %></p>
      </div>
    </div>
    <span class="shrink-0 rounded-full px-2 py-1 text-[10px] font-semibold tabular <%= priority_count.positive? ? 'bg-[#fff1f0] text-[#b42318]' : 'bg-[#ecfdf3] text-[#067647]' %>"><%= priority_count.positive? ? t("dashboard.priority_items", count: priority_count) : t("dashboard.all_clear") %></span>
  </header>

  <div class="divide-y divide-line px-4 sm:px-5">
    <% @upcoming_groups.each do |group| %>
      <% danger = group[:tone] == :danger %>
      <div class="py-4 first:pt-4 last:pb-4">
        <div class="flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs font-semibold <%= danger ? 'text-[#b42318]' : 'text-ink' %>">
            <span class="<%= danger ? 'text-[#d92d20]' : 'text-emerald-refined' %>"><%= ui_icon(group[:icon], size: 15) %></span>
            <%= t("dashboard.upcoming_groups.#{group[:key]}") %>
          </div>
          <span class="tabular text-[11px] font-semibold <%= danger && group[:count].positive? ? 'text-[#b42318]' : 'text-ink-muted' %>"><%= group[:count] %></span>
        </div>

        <% if group[:orders].any? %>
          <div class="mt-2 space-y-1">
            <% group[:orders].each do |order| %>
              <%= link_to order, class: "group flex min-h-11 items-center justify-between gap-3 rounded-lg border px-3 py-2 transition-colors #{danger ? 'border-[#fee4e2] bg-[#fff8f7] hover:bg-[#fff1f0]' : 'border-transparent bg-surface-muted/55 hover:border-line hover:bg-surface-muted'}" do %>
                <span class="min-w-0">
                  <span class="block truncate text-xs font-semibold text-ink"><%= order.customer.full_name %></span>
                  <span class="mt-0.5 block truncate font-mono text-[10px] text-ink-muted"><%= order.order_number %><% if danger %> · <%= l(order.delivery_date) %><% end %></span>
                </span>
                <%= ui_icon("chevron-right", size: 14, class_name: "text-ink-muted transition-transform group-hover:translate-x-0.5") %>
              <% end %>
            <% end %>
          </div>
          <% if group[:count] > group[:orders].size %>
            <%= link_to orders_path, class: "mt-2 inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-refined hover:text-brand" do %><%= t("dashboard.more_items", count: group[:count] - group[:orders].size) %><%= ui_icon("arrow-right", size: 12) %><% end %>
          <% end %>
        <% else %>
          <p class="mt-2 text-[11px] text-ink-muted"><%= t("dashboard.none_scheduled") %></p>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
