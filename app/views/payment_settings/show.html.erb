<% content_for :title, t("payment_settings.title") %>
<%= render "shared/page_header",
  eyebrow: t("payment_settings.eyebrow"),
  title: t("payment_settings.heading"),
  description: t("payment_settings.description", branch: current_branch.name) %>

<%= form_with model: @shop_setting, url: payment_setting_path, method: :patch, class: "mx-auto mt-5 max-w-3xl space-y-4" do |form| %>
  <%= render "shared/form_errors", record: @shop_setting %>

  <section class="form-section overflow-hidden">
    <div class="flex items-start gap-3">
      <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-surface-muted text-gold ring-1 ring-line"><%= ui_icon("payments", size: 18) %></span>
      <div class="min-w-0">
        <h2 class="section-title"><%= t("payment_settings.receiving_details") %></h2>
        <p class="supporting-text mt-1"><%= t("payment_settings.receiving_details_description") %></p>
      </div>
    </div>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :upi_id, t("payment_settings.upi_id"), class: "form-label" %>
        <%= form.text_field :upi_id,
          class: "form-input font-mono lowercase",
          placeholder: t("payment_settings.upi_placeholder"),
          maxlength: 100,
          autocomplete: "off",
          autocapitalize: "none",
          spellcheck: false,
          inputmode: "email" %>
        <p class="form-hint"><%= t("payment_settings.upi_hint") %></p>
      </div>

      <div>
        <%= form.label :gpay_number, t("payment_settings.gpay_number"), class: "form-label" %>
        <div class="relative">
          <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-xs font-semibold text-ink-muted">+91</span>
          <%= form.telephone_field :gpay_number,
            class: "form-input pl-11 tabular",
            placeholder: t("payment_settings.gpay_placeholder"),
            maxlength: 14,
            autocomplete: "off",
            inputmode: "numeric" %>
        </div>
        <p class="form-hint"><%= t("payment_settings.gpay_hint") %></p>
      </div>
    </div>
  </section>

  <aside class="rounded-xl border border-line bg-surface-muted/55 p-4" aria-label="<%= t('payment_settings.privacy_title') %>">
    <div class="flex items-start gap-3">
      <span class="mt-0.5 text-emerald-refined"><%= ui_icon("check", size: 17) %></span>
      <div><h2 class="text-sm font-semibold text-ink"><%= t("payment_settings.privacy_title") %></h2><p class="mt-1 text-xs leading-5 text-ink-muted"><%= t("payment_settings.privacy_description") %></p></div>
    </div>
  </aside>

  <div class="sticky-actions justify-end">
    <%= link_to t("forms.cancel"), payments_path, class: "button-secondary" %>
    <%= form.submit t("payment_settings.save"), class: "button-primary" %>
  </div>
<% end %>
