<% content_for :title, "#{t('orders.job_card')} · #{@order.order_number}" %>
<main class="mx-auto max-w-5xl p-6 sm:p-10"><div class="print-hidden mb-6 flex justify-between"><%= link_to "← #{@order.order_number}", @order, class: "button-secondary" %><button type="button" data-controller="print" data-action="print#print" class="button-primary"><%= t("orders.print") %></button></div><header class="flex items-start justify-between gap-6 border-b-2 border-stone-900 pb-5"><div><p class="text-sm font-bold uppercase tracking-[0.2em]"><%= @order.branch.shop_setting.shop_name %></p><h1 class="mt-2 text-3xl font-black"><%= t("orders.job_card") %></h1><p class="mt-1 font-mono text-lg font-bold"><%= @order.order_number %></p></div><%= image_tag qr_code_order_path(@order, format: :svg), alt: t("orders.qr_code_alt", number: @order.order_number), class: "size-32" %></header><section class="grid grid-cols-2 gap-5 border-b border-stone-300 py-5 sm:grid-cols-4"><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("customers.customer") %></p><p class="mt-1 font-bold"><%= @order.customer.full_name %></p><p class="text-sm"><%= @order.customer.phone_number %></p></div><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("orders.ordered_on") %></p><p class="mt-1 font-semibold"><%= l(@order.ordered_on) %></p></div><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("orders.trial_date") %></p><p class="mt-1 font-semibold"><%= @order.trial_date ? l(@order.trial_date) : "—" %></p></div><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("orders.delivery_date") %></p><p class="mt-1 font-semibold"><%= l(@order.delivery_date) %></p></div></section><% @order.order_items.each_with_index do |item, index| %><% snapshot = item.readonly_snapshot %><article class="break-inside-avoid border-b border-stone-300 py-6"><h2 class="text-xl font-black"><%= index + 1 %>. <%= item.garment_name %> × <%= item.quantity %></h2><p class="mt-1 text-sm"><%= snapshot[:template_name] %> · <%= snapshot[:profile_name] %> · v<%= snapshot[:version] %> · <%= snapshot[:unit].to_s.humanize %></p><table class="mt-4 w-full border-collapse text-sm"><tbody><% snapshot[:fields].each_slice(3) do |fields| %><tr><% fields.each do |field| %><% value = snapshot.dig(:values, field[:key].to_sym) %><td class="border border-stone-400 p-2"><span class="text-stone-500"><%= field[:label] %></span><br><strong><%= value.presence || "—" %></strong></td><% end %><% (3 - fields.length).times do %><td class="border border-stone-400 p-2"></td><% end %></tr><% end %></tbody></table><% [[t("orders.instructions"), item.special_instructions], [t("measurement_profiles.fitting_notes"), snapshot[:fitting_notes]], [t("measurement_profiles.posture_notes"), snapshot[:posture_notes]], [t("measurement_profiles.preferences"), snapshot[:preferences]]].each do |label, value| %><% if value.present? %><div class="mt-3 text-sm"><strong><%= label %>:</strong> <%= value %></div><% end %><% end %></article><% end %><footer class="mt-10 grid grid-cols-2 gap-10 text-sm"><div class="border-t border-stone-500 pt-2"><%= t("orders.tailor_signature") %></div><div class="border-t border-stone-500 pt-2"><%= t("orders.quality_signature") %></div></footer></main>
