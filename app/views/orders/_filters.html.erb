<div>
  <%= form.label :status, t("orders.status"), for: "order_status_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %>
  <%= form.select :status,
    options_for_select([[t("orders.all_statuses"), ""]] + Order.statuses.keys.map { |status| [t("orders.statuses.#{status}"), status] }, params[:status]),
    {}, id: "order_status_#{suffix}", class: "form-input mt-0" %>
</div>

<div>
  <%= form.label :schedule, t("orders.schedule"), for: "order_schedule_#{suffix}", class: "mb-1.5 block text-xs font-semibold text-ink" %>
  <%= form.select :schedule,
    options_for_select([[t("orders.all_schedules"), ""], [t("orders.schedule_filters.overdue"), "overdue"], [t("orders.schedule_filters.due_soon"), "due_soon"], [t("orders.schedule_filters.upcoming"), "upcoming"]], params[:schedule]),
    {}, id: "order_schedule_#{suffix}", class: "form-input mt-0" %>
</div>
