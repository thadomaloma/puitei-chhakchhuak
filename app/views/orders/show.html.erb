<% content_for :title, @order.order_number %>

<%= render "shared/back_link", path: orders_path, label: t("orders.title") %>
<% order_actions = capture do %><%= link_to t("orders.job_card"), job_card_order_path(@order), class: "button-secondary" %><% if policy(@order).confirm? %><%= button_to t("orders.confirm"), confirm_order_path(@order), method: :patch, class: "button-primary", form: { data: { turbo_confirm: t("orders.confirm_prompt") } } %><% end %><% if @order.delivery&.persisted? %><%= link_to t("deliveries.view_handover"), @order.delivery, class: "button-primary" %><% elsif policy(@delivery_candidate).create? %><%= link_to t("deliveries.complete_handover"), new_order_delivery_path(@order), class: "button-primary" %><% end %><% end %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("orders.workspace"), title: @order.order_number, description: t("orders.workspace_description", customer: @order.customer.full_name, branch: @order.branch.name), action: order_actions %></div>

<section class="section-card mt-5 overflow-hidden p-0">
  <div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:p-5">
    <div class="flex min-w-0 items-start gap-3"><%= render "customers/avatar", customer: @order.customer, size_class: "size-14 sm:size-16" %><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><%= link_to @order.customer.full_name, @order.customer, class: "truncate text-xl font-semibold tracking-[-0.025em] text-ink hover:text-emerald-refined" %><%= order_status_badge(@order) %></div><p class="mt-1 text-sm text-ink-muted"><%= @order.customer.phone_number %><% if @order.customer.whatsapp_number.present? %> · WhatsApp <%= @order.customer.whatsapp_number %><% end %></p><p class="mt-1 font-mono text-[11px] font-semibold uppercase tracking-[0.08em] text-brand"><%= @order.customer.customer_code %></p></div></div>
    <%= image_tag qr_code_order_path(@order, format: :svg), alt: t("orders.qr_code_alt", number: @order.order_number), class: "size-20 rounded-xl border border-line bg-white p-1.5 shadow-sm sm:size-24" %>
  </div>
  <dl class="grid gap-px border-t border-line bg-line sm:grid-cols-3"><div class="bg-surface p-4"><dt class="detail-label"><%= t("orders.ordered_on") %></dt><dd class="detail-value"><%= l(@order.ordered_on, format: :long) %></dd></div><div class="bg-surface p-4"><dt class="detail-label"><%= t("orders.trial_date") %></dt><dd class="detail-value"><%= @order.trial_date ? l(@order.trial_date, format: :long) : t("orders.no_trial") %></dd></div><div class="bg-surface p-4"><dt class="detail-label"><%= t("orders.delivery_date") %></dt><dd class="detail-value"><%= l(@order.delivery_date, format: :long) %></dd><p class="mt-1 text-[11px] <%= order_delivery_state(@order) == 'overdue' ? 'font-semibold text-[#b42318]' : 'text-ink-muted' %>"><%= order_delivery_label(@order) %></p></div></dl>
  <% if @order.notes.present? %><div class="border-t border-line bg-surface p-4"><h2 class="detail-label"><%= t("customers.notes") %></h2><p class="mt-1 whitespace-pre-line text-sm leading-6 text-ink-muted"><%= @order.notes %></p></div><% end %>
</section>

<div class="mt-4 grid grid-cols-2 gap-3 xl:grid-cols-5">
  <%= render "shared/stat_card", label: t("orders.metrics.garments"), value: @order.order_items.sum(&:quantity), detail: t("orders.metrics.garments_detail"), icon: "needle" %>
  <%= render "shared/stat_card", label: (@order.billable? ? t("payments.total") : t("orders.estimated_final_total")), value: money(order_display_total(@order), @order.currency), detail: (@order.billable? ? t("orders.pricing_locked") : t("orders.draft_pricing")), icon: "payments", tone: "premium" %>
  <%= render "shared/stat_card", label: t("payments.paid"), value: money(@order.paid_amount, @order.currency), detail: t("orders.active_receipts"), icon: "check", tone: "success" %>
  <%= render "shared/stat_card", label: t("payments.balance"), value: money(@order.balance_due, @order.currency), detail: t("orders.balance_detail"), icon: "warning", tone: (@order.balance_due.positive? ? "warning" : "success") %>
  <%= render "shared/stat_card", label: t("orders.production_progress"), value: "#{@order.production_progress}%", detail: t("orders.production_detail"), icon: "production", tone: "info" %>
</div>

<% if @order.delivery&.persisted? %><section class="section-card mt-4 border-[#abefc6]"><div class="flex flex-wrap items-start justify-between gap-3"><div><p class="eyebrow"><%= t("deliveries.completed_eyebrow") %></p><h2 class="mt-1 section-title"><%= @order.delivery.delivery_number %></h2><p class="supporting-text"><%= t("deliveries.handed_to", name: @order.delivery.recipient_name, date: l(@order.delivery.handed_over_at, format: :long)) %></p></div><%= link_to @order.delivery, class: "button-secondary button-sm" do %><%= t("deliveries.view_handover") %><%= ui_icon("arrow-right", size: 14) %><% end %></div></section><% end %>

<section class="mt-5">
  <h2 class="section-title"><%= t("orders.items") %></h2>
  <div class="mt-3 space-y-3">
    <% @order.order_items.each_with_index do |item, index| %>
      <% snapshot = item.readonly_snapshot %>
      <article class="form-section">
        <div class="flex flex-wrap items-start justify-between gap-3"><div><p class="eyebrow"><%= t("orders.garment_number", number: index + 1) %></p><h3 class="mt-0.5 text-base font-semibold text-ink"><%= item.garment_name %> × <%= item.quantity %></h3><p class="mt-1 tabular text-sm font-semibold text-ink"><%= money(item.line_total, @order.currency) %> <span class="text-xs font-normal text-ink-muted">· <%= money(item.unit_price, @order.currency) %> × <%= item.quantity %></span></p></div><span class="rounded-md bg-surface-muted px-2 py-1 text-[11px] font-medium text-ink-muted"><%= snapshot[:profile_name] %> · v<%= snapshot[:version] %> · <%= t("orders.snapshot_locked") %></span></div>
        <% if item.design_selection.present? %><% design = item.design_selection.design %><div class="mt-3 flex items-center gap-3 rounded-lg border border-line bg-surface-muted/45 p-2.5"><% if (attachment = design.primary_image_attachment) %><%= image_tag attachment.variant(:thumb), alt: "", class: "size-12 shrink-0 rounded-lg border border-line object-cover" %><% end %><div class="min-w-0"><% if policy(design).show? %><%= link_to design.title, design, class: "truncate text-xs font-semibold text-ink hover:text-emerald-refined" %><% else %><p class="truncate text-xs font-semibold text-ink"><%= design.title %></p><% end %><p class="text-[10px] text-ink-muted"><%= t("orders.design_selection") %> · <%= t("design_selections.statuses.#{item.design_selection.status}") %></p></div></div><% end %>
        <dl class="mt-4 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5"><% snapshot[:fields].each do |field| %><% value = snapshot.dig(:values, field[:key].to_sym) %><% if value.present? %><div class="rounded-lg border border-line bg-surface-muted/45 p-2.5"><dt class="text-[11px] text-ink-muted"><%= field[:label] %></dt><dd class="mt-0.5 tabular text-sm font-semibold text-ink"><%= value %> <span class="text-[10px] font-medium text-ink-muted"><%= snapshot[:unit] == "inches" ? "in" : "cm" %></span></dd></div><% end %><% end %></dl>
        <% if item.special_instructions.present? %><div class="mt-4"><h4 class="detail-label"><%= t("orders.instructions") %></h4><p class="mt-1 whitespace-pre-line text-sm leading-5 text-ink-muted"><%= item.special_instructions %></p></div><% end %>
        <% if item.fabric_photos.any? || item.design_references.any? %><div class="mt-4 grid gap-4 border-t border-line pt-4 sm:grid-cols-2"><% [[t("orders.fabric_photos"), item.fabric_photos], [t("orders.design_references"), item.design_references]].each do |label, images| %><% if images.any? %><div><h4 class="detail-label"><%= label %></h4><div class="mt-2 grid grid-cols-3 gap-2"><% images.each do |image| %><%= image_tag image.variant(:thumb), alt: "", class: "aspect-square w-full rounded-lg border border-line object-cover" %><% end %></div></div><% end %><% end %></div><% end %>
        <% if @order.confirmed? %>
          <% reservations = item.active_inventory_reservations %><% consumed = item.consumed_inventory %>
          <div class="mt-4 border-t border-line pt-4"><div class="flex items-center justify-between gap-3"><div><h4 class="text-xs font-semibold text-ink"><%= t("inventory.material_allocation") %></h4><p class="text-[11px] text-ink-muted"><%= t("inventory.material_allocation_description") %></p></div><%= link_to inventory_items_path, class: "button-ghost button-sm" do %><%= t("inventory.view_inventory") %><%= ui_icon("arrow-right", size: 13) %><% end %></div>
            <% if reservations.any? || consumed.any? %><div class="mt-3 divide-y divide-line overflow-hidden rounded-lg border border-line"><% (reservations.keys | consumed.keys).each do |inventory_item| %><% reserved_quantity = reservations.fetch(inventory_item, 0.to_d) %><% consumed_quantity = consumed.fetch(inventory_item, 0.to_d) %><div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2.5"><div><%= link_to inventory_item.name, inventory_item, class: "text-xs font-semibold text-ink hover:text-emerald-refined" %><p class="text-[10px] text-ink-muted"><%= inventory_item.sku %><% if reserved_quantity.positive? %> · <%= t("inventory.reserved_quantity", quantity: stock_quantity(reserved_quantity, inventory_item.unit)) %><% end %><% if consumed_quantity.positive? %> · <%= t("inventory.consumed_quantity", quantity: stock_quantity(consumed_quantity, inventory_item.unit)) %><% end %></p></div><% if reserved_quantity.positive? %><div class="flex gap-1.5"><% release = StockMovement.new(inventory_item: inventory_item, order_item: item, movement_type: :release) %><% consume = StockMovement.new(inventory_item: inventory_item, order_item: item, movement_type: :consumption) %><% if policy(release).create? %><%= button_to t("inventory.release"), stock_movements_path, method: :post, params: { stock_movement: { inventory_item_id: inventory_item.id, order_item_id: item.id, movement_type: "release", quantity: reserved_quantity, happened_on: Date.current, return_to: "order" } }, class: "button-ghost button-sm" %><% end %><% if policy(consume).create? %><%= button_to t("inventory.consume"), stock_movements_path, method: :post, params: { stock_movement: { inventory_item_id: inventory_item.id, order_item_id: item.id, movement_type: "consumption", quantity: reserved_quantity, happened_on: Date.current, return_to: "order" } }, class: "button-secondary button-sm" %><% end %></div><% end %></div><% end %></div><% end %>
            <% reservation = StockMovement.new(order_item: item, movement_type: :reservation) %><% reservation.inventory_item = @inventory_items.first %><% if @inventory_items.any? && policy(reservation).create? %><%= form_with url: stock_movements_path, scope: :stock_movement, class: "mt-3 grid gap-2 rounded-lg bg-surface-muted/55 p-2.5 sm:grid-cols-[minmax(0,1fr)_8rem_auto]" do |form| %><%= form.hidden_field :movement_type, value: "reservation" %><%= form.hidden_field :order_item_id, value: item.id %><%= form.hidden_field :happened_on, value: Date.current %><%= form.hidden_field :return_to, value: "order" %><div><%= form.label :inventory_item_id, t("inventory.item"), class: "sr-only" %><%= form.select :inventory_item_id, @inventory_items.map { |stock| ["#{stock.name} · #{stock_quantity(stock.available_quantity, stock.unit)}", stock.id] }, { include_blank: t("inventory.choose_item") }, class: "form-input mt-0", required: true %></div><div><%= form.label :quantity, t("inventory.quantity"), class: "sr-only" %><%= form.number_field :quantity, min: 0.001, step: "0.001", class: "form-input mt-0 tabular", placeholder: t("inventory.quantity"), inputmode: "decimal", required: true %></div><%= form.submit t("inventory.reserve"), class: "button-secondary" %><% end %><% end %>
          </div>
        <% end %>
      </article>
    <% end %>
  </div>
</section>

<% if policy(Payment).index? %>
  <section class="section-card mt-5">
    <div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="section-title"><%= t("payments.billing") %></h2><p class="supporting-text"><%= t("payments.billing_description") %></p></div><%= link_to t("payments.dashboard"), payments_path, class: "button-secondary button-sm" %></div>
    <dl class="mt-4 grid grid-cols-2 gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-3 lg:grid-cols-6"><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.subtotal") %></dt><dd class="detail-value tabular"><%= money(@order.billable? ? @order.subtotal_amount : @order.estimated_subtotal, @order.currency) %></dd></div><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.discount") %></dt><dd class="detail-value tabular"><%= money(@order.discount_amount, @order.currency) %></dd></div><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.tax") %></dt><dd class="detail-value tabular"><%= money(@order.tax_amount, @order.currency) %></dd></div><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.total") %></dt><dd class="detail-value tabular font-semibold"><%= money(@order.total_amount, @order.currency) %></dd></div><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.paid") %></dt><dd class="detail-value tabular text-emerald-refined"><%= money(@order.paid_amount, @order.currency) %></dd></div><div class="bg-surface p-3"><dt class="detail-label"><%= t("payments.balance") %></dt><dd class="detail-value tabular text-[#b42318]"><%= money(@order.balance_due, @order.currency) %></dd></div></dl>

    <% if @order.payments.any? %><div class="mt-4 divide-y divide-line overflow-hidden rounded-lg border border-line"><% @order.payments.each do |payment| %><%= link_to payment, class: "flex flex-wrap items-center justify-between gap-3 px-3 py-2.5 hover:bg-surface-muted" do %><div><p class="font-mono text-xs font-semibold text-ink"><%= payment.payment_number %></p><p class="text-[10px] text-ink-muted"><%= l(payment.paid_on) %> · <%= t("payments.methods.#{payment.payment_method}") %> · <%= payment.received_by.name %></p></div><div class="text-right"><p class="tabular text-sm font-semibold <%= payment.voided? ? 'line-through text-ink-muted' : 'text-emerald-refined' %>"><%= money(payment.amount, @order.currency) %></p><% if payment.voided? %><%= status_badge("void", label: t("payments.void_label"), variant: "danger") %><% end %></div><% end %><% end %></div><% end %>

    <% payment = Payment.new(order: @order, branch: @order.branch) %>
    <% if @order.billable? && @order.balance_due.positive? && policy(payment).create? %><div class="mt-4 flex flex-col gap-3 rounded-xl border border-[#abefc6] bg-[#ecfdf3]/60 p-4 sm:flex-row sm:items-center sm:justify-between"><div><p class="text-sm font-semibold text-[#067647]"><%= t("payments.balance_ready", amount: money(@order.balance_due, @order.currency)) %></p><p class="mt-1 text-xs text-ink-muted"><%= t("payments.collection_workspace_hint") %></p></div><%= link_to t("payments.collect_payment"), new_order_payment_path(@order), class: "button-primary shrink-0" %></div><% end %>
  </section>
<% end %>

<% if @order.billable? %>
  <section class="mt-5"><div class="flex flex-wrap items-center justify-between gap-3"><div><h2 class="section-title"><%= t("production.order_title") %></h2><p class="supporting-text"><%= t("production.order_progress", percent: @order.production_progress) %></p></div><%= link_to t("production.open_queue"), production_path, class: "button-secondary button-sm" %></div><div class="mt-3 h-1.5 overflow-hidden rounded-full bg-surface-muted"><progress class="progress-bar" value="<%= @order.production_progress %>" max="100" aria-hidden="true"></progress></div><div class="mt-3 space-y-3"><% @order.order_items.each do |item| %><% item.production_tasks.each do |task| %><%= render "production_tasks/task", task: task, show_order: false, assignees: @production_staff %><% end %><% end %></div></section>
<% end %>
