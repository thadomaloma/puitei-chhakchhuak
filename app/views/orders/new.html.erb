<% content_for :title, t("orders.new") %>
<%= render "shared/back_link", path: orders_path, label: t("orders.title") %>
<div class="mt-3 max-w-7xl"><%= render "shared/page_header", eyebrow: t("orders.eyebrow"), title: t("orders.new"), description: t("orders.new_description") %></div>

<div class="mt-5 flex flex-wrap gap-2" aria-label="<%= t('orders.workflow_steps') %>"><% [t("orders.steps.customer"), t("orders.steps.schedule"), t("orders.steps.garments"), t("orders.steps.review")].each_with_index do |step, index| %><span class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1.5 text-xs font-semibold text-ink-muted"><span class="grid size-5 place-items-center rounded-full bg-brand text-[10px] text-white"><%= index + 1 %></span><%= step %></span><% end %></div>

<%= form_with model: @order, class: "mt-5 max-w-7xl", data: { controller: "order-form", order_form_new_measurement_url_template_value: new_customer_measurement_profile_path("__CUSTOMER_ID__") } do |form| %>
  <%= render "shared/form_errors", record: @order %>
  <div class="grid gap-5 xl:grid-cols-[minmax(0,1fr)_21rem] xl:items-start">
    <div class="space-y-5">
      <section class="form-section">
        <div><p class="eyebrow"><%= t("orders.step_label", number: 1) %></p><h2 class="section-title mt-1"><%= t("orders.customer_and_schedule") %></h2><p class="supporting-text mt-1"><%= t("orders.customer_and_schedule_description") %></p></div>
        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <%= form.label :customer_id, t("customers.customer"), class: "text-sm font-semibold" %>
            <% customer_options = @customers.map { |customer| ["#{customer.full_name} · #{customer.phone_number} · #{customer.branch.code}", customer.id, { data: { tax_rate: customer.branch.shop_setting.tax_rate, currency: customer.branch.shop_setting.currency, name: customer.full_name, phone: customer.phone_number } }] } %>
            <%= form.select :customer_id, options_for_select(customer_options, @order.customer_id), { prompt: t("orders.choose_customer") }, class: "form-input", required: true, data: { order_form_target: "customer", action: "change->order-form#customerChanged" } %>
          </div>
          <div><%= form.label :ordered_on, t("orders.ordered_on"), class: "text-sm font-semibold" %><%= form.date_field :ordered_on, class: "form-input", required: true %></div>
          <div><%= form.label :trial_date, t("orders.trial_date"), class: "text-sm font-semibold" %><%= form.date_field :trial_date, class: "form-input" %><p class="mt-1 text-[11px] text-ink-muted"><%= t("orders.trial_date_hint") %></p></div>
          <div><%= form.label :delivery_date, t("orders.delivery_date"), class: "text-sm font-semibold" %><%= form.date_field :delivery_date, class: "form-input", required: true %></div>
          <div><%= form.label :discount_amount, t("payments.discount"), class: "text-sm font-semibold" %><%= form.number_field :discount_amount, min: 0, step: "0.01", class: "form-input tabular", placeholder: "0.00", inputmode: "decimal", data: { order_form_target: "discount", action: "input->order-form#recalculate" } %><p class="mt-1 text-[11px] text-ink-muted"><%= t("orders.discount_hint") %></p></div>
        </div>
      </section>

      <section>
        <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("orders.step_label", number: 2) %></p><h2 class="section-title mt-1"><%= t("orders.items") %></h2><p class="supporting-text mt-1"><%= t("orders.items_description") %></p></div><button type="button" class="button-secondary" data-action="order-form#addItem"><%= ui_icon("plus", size: 16) %><%= t("orders.add_garment") %></button></div>
        <div class="mt-4 hidden rounded-xl border border-[#fedf89] bg-[#fffaeb] p-3 text-sm text-[#93370d]" data-order-form-target="measurementNotice"><p class="font-semibold"><%= t("orders.no_measurements") %></p><p class="mt-1 text-xs"><%= t("orders.no_measurements_description") %></p><%= link_to t("orders.create_measurement_profile"), "#", class: "mt-2 inline-flex font-semibold underline", data: { order_form_target: "measurementLink" } %></div>
        <div class="mt-4 space-y-4" data-order-form-target="itemsContainer"><%= form.fields_for :order_items do |item_form| %><%= render "order_item_fields", item_form: item_form %><% end %></div>
        <div class="empty-state mt-4 hidden" data-order-form-target="emptyItems"><span class="empty-state-mark"><%= ui_icon("needle", size: 22) %></span><h3 class="mt-3 text-sm font-semibold text-ink"><%= t("orders.no_garments") %></h3><p class="mt-1 supporting-text"><%= t("orders.no_garments_description") %></p><button type="button" class="button-secondary mt-4" data-action="order-form#addItem"><%= ui_icon("plus", size: 16) %><%= t("orders.add_garment") %></button></div>
      </section>

      <section class="form-section"><p class="eyebrow"><%= t("orders.step_label", number: 3) %></p><h2 class="section-title mt-1"><%= t("orders.final_notes") %></h2><p class="supporting-text mt-1"><%= t("orders.final_notes_description") %></p><div class="mt-4"><%= form.label :notes, t("customers.notes"), class: "text-sm font-semibold" %><%= form.text_area :notes, rows: 4, class: "form-input", placeholder: t("orders.notes_placeholder") %></div></section>
    </div>

    <aside class="space-y-4 xl:sticky xl:top-6">
      <section class="section-card overflow-hidden p-0"><div class="border-b border-line bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4"><p class="eyebrow"><%= t("orders.live_summary") %></p><h2 class="mt-1 text-lg font-semibold tracking-[-0.02em] text-ink"><%= t("orders.review_total") %></h2><p class="mt-1 text-xs text-ink-muted" data-order-form-target="customerSummary"><%= t("orders.select_customer_summary") %></p></div><dl class="space-y-3 p-4"><div class="flex items-center justify-between gap-4"><dt class="text-sm text-ink-muted"><%= t("payments.subtotal") %></dt><dd class="tabular text-sm font-semibold text-ink" data-order-form-target="subtotal">INR 0.00</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-sm text-ink-muted"><%= t("payments.discount") %></dt><dd class="tabular text-sm font-semibold text-ink" data-order-form-target="discountTotal">INR 0.00</dd></div><div class="flex items-center justify-between gap-4"><dt class="text-sm text-ink-muted"><%= t("orders.tax_preview") %> <span data-order-form-target="taxRate">0%</span></dt><dd class="tabular text-sm font-semibold text-ink" data-order-form-target="tax">INR 0.00</dd></div><div class="flex items-end justify-between gap-4 border-t border-line pt-3"><dt><span class="block text-sm font-semibold text-ink"><%= t("orders.estimated_final_total") %></span><span class="text-[11px] text-ink-muted"><%= t("orders.finalized_on_confirmation") %></span></dt><dd class="tabular text-xl font-semibold tracking-[-0.02em] text-ink" data-order-form-target="total">INR 0.00</dd></div></dl></section>
      <section class="section-card"><div class="flex gap-3"><span class="grid size-9 shrink-0 place-items-center rounded-xl bg-[#ecfdf3] text-[#067647]"><%= ui_icon("check", size: 18) %></span><div><h2 class="text-sm font-semibold text-ink"><%= t("orders.snapshot_protection") %></h2><p class="mt-1 text-xs leading-5 text-ink-muted"><%= t("orders.snapshot_protection_description") %></p></div></div></section>
    </aside>
  </div>

  <template data-order-form-target="template"><%= form.fields_for :order_items, OrderItem.new, child_index: "NEW_RECORD" do |item_form| %><%= render "order_item_fields", item_form: item_form %><% end %></template>
  <div class="sticky-actions mt-5 justify-end"><%= link_to t("forms.cancel"), orders_path, class: "button-secondary flex-1 sm:flex-none" %><%= form.submit t("orders.save_draft"), class: "button-primary flex-1 sm:flex-none" %></div>
<% end %>
