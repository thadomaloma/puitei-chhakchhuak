<article class="form-section relative" data-order-form-target="item">
  <div class="flex items-start justify-between gap-3">
    <div><p class="eyebrow"><%= t("orders.garment_step") %></p><h3 class="mt-1 text-base font-semibold tracking-[-0.01em] text-ink" data-order-form-target="itemNumber"><%= t("orders.garment_number", number: item_form.index.to_i + 1) %></h3></div>
    <button type="button" class="button-ghost button-icon button-sm" aria-label="<%= t('orders.remove_garment') %>" data-action="order-form#removeItem"><%= ui_icon("x", size: 15) %></button>
  </div>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div class="sm:col-span-2"><%= item_form.label :garment_name, t("orders.garment_name"), class: "text-sm font-semibold" %><%= item_form.text_field :garment_name, class: "form-input", placeholder: t("orders.garment_placeholder"), autocomplete: "off" %></div>
    <div><%= item_form.label :quantity, t("orders.quantity"), class: "text-sm font-semibold" %><%= item_form.number_field :quantity, min: 1, max: 100, value: item_form.object.quantity || 1, class: "form-input tabular", inputmode: "numeric", data: { action: "input->order-form#recalculate" } %></div>
    <div><%= item_form.label :unit_price, t("payments.unit_price"), class: "text-sm font-semibold" %><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xs font-semibold text-ink-muted" data-order-form-target="currency">INR</span><%= item_form.number_field :unit_price, min: 0, step: "0.01", class: "form-input tabular pl-12", placeholder: "0.00", inputmode: "decimal", data: { action: "input->order-form#recalculate" } %></div></div>
    <div class="sm:col-span-2">
      <div class="flex items-end justify-between gap-3"><%= item_form.label :measurement_id, t("orders.measurement_version"), class: "text-sm font-semibold" %><span class="text-[11px] font-medium text-ink-muted"><%= t("orders.snapshot_hint") %></span></div>
      <select name="<%= item_form.field_name(:measurement_id) %>" id="<%= item_form.field_id(:measurement_id) %>" class="form-input" data-order-form-target="measurement">
        <option value=""><%= t("orders.choose_measurement") %></option>
        <% @measurements_by_customer.each do |customer_id, measurements| %>
          <% measurements.each do |measurement| %><option value="<%= measurement.id %>" data-customer-id="<%= customer_id %>" <%= "selected" if item_form.object.measurement_id == measurement.id %>><%= measurement.measurement_profile.name %> · v<%= measurement.version %> · <%= l(measurement.measured_on) %> · <%= measurement.unit.humanize %></option><% end %>
        <% end %>
      </select>
    </div>
    <div class="sm:col-span-2">
      <%= item_form.label :design_selection_id, t("orders.design_selection"), class: "text-sm font-semibold" %>
      <select name="<%= item_form.field_name(:design_selection_id) %>" id="<%= item_form.field_id(:design_selection_id) %>" class="form-input" data-order-form-target="designSelection">
        <option value=""><%= t("orders.no_design_selected") %></option>
        <% @design_selections_by_customer.each do |customer_id, selections| %>
          <% selections.each do |selection| %><option value="<%= selection.id %>" data-customer-id="<%= customer_id %>" <%= "selected" if item_form.object.design_selection_id == selection.id %>><%= selection.design.title %> · <%= t("design_selections.statuses.#{selection.status}") %></option><% end %>
        <% end %>
      </select>
    </div>
    <div class="sm:col-span-2"><%= item_form.label :special_instructions, t("orders.instructions"), class: "text-sm font-semibold" %><%= item_form.text_area :special_instructions, rows: 3, class: "form-input", placeholder: t("orders.instructions_placeholder") %></div>
    <label class="sm:col-span-2 flex min-h-12 items-center gap-3 rounded-xl border border-line bg-surface-muted/55 px-4 py-2.5 text-sm font-semibold text-ink"><%= item_form.check_box :requires_embroidery, class: "size-5 rounded border-line text-brand" %><span><%= t("production.requires_embroidery") %><span class="block text-xs font-normal text-ink-muted"><%= t("production.requires_embroidery_hint") %></span></span></label>
    <div data-controller="image-preview"><%= item_form.label :fabric_photos, t("orders.fabric_photos"), class: "text-sm font-semibold" %><p class="mt-0.5 text-[11px] text-ink-muted"><%= t("orders.fabric_photos_hint") %></p><%= item_form.file_field :fabric_photos, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "file-input", data: { image_preview_target: "input", action: "change->image-preview#preview" } %><div class="mt-2 hidden grid-cols-3 gap-2" data-image-preview-target="gallery"></div></div>
    <div data-controller="image-preview"><%= item_form.label :design_references, t("orders.design_references"), class: "text-sm font-semibold" %><p class="mt-0.5 text-[11px] text-ink-muted"><%= t("orders.design_references_hint") %></p><%= item_form.file_field :design_references, multiple: true, accept: "image/jpeg,image/png,image/webp", class: "file-input", data: { image_preview_target: "input", action: "change->image-preview#preview" } %><div class="mt-2 hidden grid-cols-3 gap-2" data-image-preview-target="gallery"></div></div>
  </div>

  <div class="mt-4 flex items-center justify-between rounded-xl border border-line bg-surface-muted/55 px-3 py-2.5"><span class="text-xs font-medium text-ink-muted"><%= t("orders.garment_total") %></span><strong class="tabular text-sm text-ink" data-order-form-target="itemTotal">INR 0.00</strong></div>
</article>
