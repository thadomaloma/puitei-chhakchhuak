<% content_for :title, t("orders.index_title") %>

<%= render "shared/page_header",
  eyebrow: t("orders.eyebrow"),
  title: t("orders.title"),
  description: t("orders.directory_description", count: @order_metrics[:total]),
  action: (link_to(ui_icon("plus", size: 17) + t("orders.new"), new_order_path, class: "button-primary") if policy(Order).create?) %>

<div class="mt-5 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <%= render "shared/stat_card", label: t("orders.metrics.total"), value: @order_metrics[:total], detail: t("orders.metrics.total_detail"), icon: "orders" %>
  <%= render "shared/stat_card", label: t("orders.metrics.active"), value: @order_metrics[:active], detail: t("orders.metrics.active_detail"), icon: "clock", tone: "info", href: orders_path(status: "confirmed") %>
  <%= render "shared/stat_card", label: t("orders.metrics.due_soon"), value: @order_metrics[:due_soon], detail: t("orders.metrics.due_soon_detail"), icon: "calendar", tone: "warning", href: orders_path(schedule: "due_soon") %>
  <%= render "shared/stat_card", label: t("orders.metrics.outstanding"), value: money(@order_metrics[:outstanding]), detail: t("orders.metrics.outstanding_detail"), icon: "payments", tone: "premium" %>
</div>

<%= form_with url: orders_path, method: :get, class: "toolbar mt-5", data: { turbo_frame: "_top", controller: "mobile-menu", action: "keydown.esc@window->mobile-menu#close" } do |form| %>
  <div class="grid gap-3 xl:grid-cols-[minmax(18rem,1fr)_12rem_12rem_auto] xl:items-end">
    <div><%= form.label :query, t("orders.search"), class: "mb-1.5 block text-xs font-semibold text-ink" %><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, value: params[:query], placeholder: t("orders.search"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div></div>
    <div class="hidden xl:contents"><%= render "filters", form: form, suffix: "desktop" %></div>
    <div class="grid grid-cols-2 gap-2 xl:block"><button type="button" class="button-secondary xl:hidden" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="order-filter-panel" aria-expanded="false"><%= ui_icon("more", size: 16) %><%= t("orders.filters") %></button><%= form.submit t("forms.search"), class: "button-primary w-full" %></div>
  </div>

  <div id="order-filter-panel" class="hidden xl:hidden" data-mobile-menu-target="panel" hidden aria-hidden="true">
    <button type="button" class="fixed inset-0 z-40 bg-ink/30 backdrop-blur-[2px]" aria-label="<%= t('forms.close') %>" data-action="click->mobile-menu#close"></button>
    <section role="dialog" aria-modal="true" aria-label="<%= t('orders.filters') %>" class="fixed inset-x-0 bottom-0 z-50 rounded-t-2xl border border-line bg-surface p-4 shadow-2xl">
      <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong"></div>
      <div class="flex items-center justify-between"><div><p class="eyebrow"><%= t("orders.eyebrow") %></p><h2 class="mt-1 text-lg font-semibold text-ink"><%= t("orders.filters") %></h2></div><button type="button" class="button-secondary button-icon" aria-label="<%= t('forms.close') %>" data-mobile-menu-target="close" data-action="mobile-menu#close"><%= ui_icon("x", size: 17) %></button></div>
      <div class="mt-5 space-y-4"><%= render "filters", form: form, suffix: "mobile" %></div>
      <div class="mt-5 grid grid-cols-2 gap-2"><%= link_to t("forms.clear"), orders_path, class: "button-secondary" %><%= form.submit t("orders.apply_filters"), class: "button-primary" %></div>
    </section>
  </div>
<% end %>

<% if @filters_active %><div class="mt-3 flex flex-wrap items-center gap-2 text-xs"><span class="font-semibold text-ink"><%= t("orders.active_filters") %></span><% if params[:query].present? %><span class="status-badge status-neutral"><%= params[:query] %></span><% end %><% if params[:status].present? %><span class="status-badge status-info"><%= t("orders.statuses.#{params[:status]}") %></span><% end %><% if params[:schedule].present? %><span class="status-badge status-warning"><%= t("orders.schedule_filters.#{params[:schedule]}") %></span><% end %><%= link_to t("forms.clear"), orders_path, class: "font-semibold text-brand hover:text-brand-hover" %></div><% end %>

<% if @orders.any? %>
  <div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "directory_card", collection: @orders, as: :order %></div>
  <div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("dashboard.order") %></th><th><%= t("customers.customer") %></th><th><%= t("orders.items") %></th><th><%= t("payments.total") %></th><th><%= t("orders.delivery") %></th><th><%= t("orders.status") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><%= render partial: "directory_row", collection: @orders, as: :order %></tbody></table></div>
  <nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), orders_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), orders_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav>
<% else %>
  <div class="mt-4"><%= render "shared/empty_state", title: (@order_metrics[:total].zero? ? t("orders.empty_first") : t("orders.empty")), description: (@order_metrics[:total].zero? ? t("orders.empty_first_description") : t("orders.empty_description")), icon: "orders", action: ((link_to t("orders.new"), new_order_path, class: "button-primary") if @order_metrics[:total].zero? && policy(Order).create?) %></div>
<% end %>
