<% incoming = movement.stock_in? || movement.adjustment_in? %>
<% reservation_only = movement.reservation? || movement.release? %>
<article class="py-4 first:pt-0 last:pb-0" data-movement-type="<%= movement.movement_type %>">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><%= stock_movement_badge(movement) %><span class="tabular text-sm font-semibold <%= incoming ? 'text-[#067647]' : (reservation_only ? 'text-[#175cd3]' : 'text-[#b42318]') %>"><%= incoming ? '+' : (movement.release? ? '−' : (reservation_only ? '' : '−')) %><%= stock_quantity(movement.quantity, item.unit) %></span></div><p class="mt-1.5 text-[11px] text-ink-muted"><%= l(movement.happened_on, format: :long) %> · <%= movement.actor.name %><% if movement.reference.present? %> · <span class="font-mono"><%= movement.reference %></span><% end %></p><% if movement.order_item %><%= link_to "#{movement.order_item.order.order_number} · #{movement.order_item.garment_name}", movement.order_item.order, class: "mt-1.5 inline-flex text-xs font-semibold text-emerald-refined" %><% end %><% if movement.notes.present? %><p class="mt-1.5 text-xs leading-5 text-ink-muted"><%= movement.notes %></p><% end %></div>
    <dl class="grid shrink-0 grid-cols-2 gap-2 sm:min-w-60"><div class="rounded-lg bg-surface-muted/55 p-2.5"><dt class="detail-label"><%= t("inventory.on_hand") %></dt><dd class="mt-1 tabular text-xs font-semibold text-ink"><%= stock_quantity(movement.on_hand_before) %> → <%= stock_quantity(movement.on_hand_after) %></dd></div><div class="rounded-lg bg-surface-muted/55 p-2.5"><dt class="detail-label"><%= t("inventory.reserved") %></dt><dd class="mt-1 tabular text-xs font-semibold text-ink"><%= stock_quantity(movement.reserved_before) %> → <%= stock_quantity(movement.reserved_after) %></dd></div></dl>
  </div>
</article>
