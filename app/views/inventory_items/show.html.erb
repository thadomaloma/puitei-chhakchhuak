<% content_for :title, @inventory_item.name %>
<%= render "shared/back_link", path: inventory_items_path, label: t("inventory.title") %>
<% item_actions = capture do %><% if policy(@inventory_item).edit? %><%= link_to t("forms.edit"), edit_inventory_item_path(@inventory_item), class: "button-secondary" %><% end %><% if policy(@inventory_item).archive? %><%= button_to t("inventory.archive"), archive_inventory_item_path(@inventory_item), method: :patch, class: "button-ghost text-[#b42318]", form: { data: { turbo_confirm: t("inventory.archive_confirm") } } %><% end %><% end %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: @inventory_item.sku, title: @inventory_item.name, description: t("inventory.workspace_description", category: t("inventory.categories.#{@inventory_item.category}"), branch: @inventory_item.branch.name), action: item_actions %></div>

<section class="section-card mt-5 overflow-hidden p-0">
  <div class="grid gap-4 bg-[linear-gradient(135deg,#fffdf8_0%,#f8f5ec_100%)] p-4 sm:grid-cols-[auto_minmax(0,1fr)] sm:items-center sm:p-5"><% if @inventory_item.image.attached? %><%= image_tag @inventory_item.image.variant(:thumb), alt: @inventory_item.name, class: "size-20 rounded-2xl border border-line object-cover shadow-sm sm:size-24" %><% else %><span class="grid size-20 place-items-center rounded-2xl border border-line bg-surface text-ink-muted shadow-sm sm:size-24"><%= ui_icon("inventory", size: 30) %></span><% end %><div class="min-w-0"><div class="flex flex-wrap items-center gap-2"><% if @inventory_item.active? %><%= inventory_stock_badge(@inventory_item) %><% else %><%= status_badge("archived", label: t("inventory.archived_label")) %><% end %><span class="status-badge status-neutral"><%= t("inventory.unit_names.#{@inventory_item.unit}") %></span></div><p class="mt-3 text-sm text-ink-muted"><%= @inventory_item.color.presence || t("inventory.no_colour") %><% if @inventory_item.supplier_name.present? %> · <%= @inventory_item.supplier_name %><% end %></p><p class="mt-1 text-xs text-ink-muted"><%= t("inventory.ledger_protected") %></p></div></div>
  <% reserved_percentage = @inventory_item.quantity_on_hand.positive? ? ((@inventory_item.quantity_reserved / @inventory_item.quantity_on_hand) * 100).round(1) : 0 %>
  <div class="border-t border-line bg-surface p-4"><div class="flex items-center justify-between gap-3"><p class="text-xs font-semibold text-ink"><%= t("inventory.stock_composition") %></p><p class="text-[11px] text-ink-muted"><%= t("inventory.reserved_percentage", percent: reserved_percentage) %></p></div><div class="mt-2 h-2 overflow-hidden rounded-full"><progress class="progress-bar progress-warning progress-composition" value="<%= reserved_percentage %>" max="100" aria-hidden="true"></progress></div><div class="mt-2 flex justify-between text-[10px] text-ink-muted"><span><%= t("inventory.reserved") %></span><span><%= t("inventory.available") %></span></div></div>
</section>

<div class="mt-4 grid grid-cols-2 gap-3 xl:grid-cols-5">
  <%= render "shared/stat_card", label: t("inventory.on_hand"), value: stock_quantity(@inventory_item.quantity_on_hand, @inventory_item.unit), detail: t("inventory.ledger_balance"), icon: "inventory" %>
  <%= render "shared/stat_card", label: t("inventory.reserved"), value: stock_quantity(@inventory_item.quantity_reserved, @inventory_item.unit), detail: t("inventory.linked_orders"), icon: "orders", tone: "warning" %>
  <%= render "shared/stat_card", label: t("inventory.available"), value: stock_quantity(@inventory_item.available_quantity, @inventory_item.unit), detail: t("inventory.ready_to_allocate"), icon: "check", tone: "success" %>
  <%= render "shared/stat_card", label: t("inventory.reorder_level"), value: stock_quantity(@inventory_item.reorder_level, @inventory_item.unit), detail: t("inventory.reorder_threshold"), icon: "warning", tone: "warning" %>
  <%= render "shared/stat_card", label: t("inventory.stock_value"), value: money(@inventory_item.quantity_on_hand * @inventory_item.cost_price), detail: t("inventory.at_cost"), icon: "reports", tone: "premium" %>
</div>

<div class="mt-5 grid gap-5 xl:grid-cols-[minmax(0,1fr)_21rem] xl:items-start">
  <div class="space-y-5">
    <% if @active_reservations.any? %><section class="section-card"><div><p class="eyebrow"><%= t("inventory.allocations") %></p><h2 class="section-title mt-1"><%= t("inventory.active_reservations") %></h2><p class="supporting-text mt-1"><%= t("inventory.active_reservations_description") %></p></div><div class="mt-4 divide-y divide-line overflow-hidden rounded-xl border border-line"><% @active_reservations.each do |order_item, quantity| %><%= link_to order_item.order, class: "flex flex-wrap items-center justify-between gap-3 px-3.5 py-3 hover:bg-surface-muted/50" do %><div><p class="text-sm font-semibold text-ink"><%= order_item.garment_name %></p><p class="mt-0.5 font-mono text-[10px] text-ink-muted"><%= order_item.order.order_number %> · <%= order_item.order.customer.full_name %></p></div><div class="text-right"><p class="tabular text-sm font-semibold text-[#b54708]"><%= stock_quantity(quantity, @inventory_item.unit) %></p><p class="mt-0.5 text-[10px] text-ink-muted"><%= t("production.due", date: l(order_item.order.delivery_date)) %></p></div><% end %><% end %></div></section><% end %>

    <section class="section-card">
      <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("inventory.immutable_ledger") %></p><h2 class="section-title mt-1"><%= t("inventory.movement_history") %></h2><p class="supporting-text mt-1"><%= t("inventory.movement_results", count: @movement_count) %></p></div><%= form_with url: inventory_item_path(@inventory_item), method: :get, class: "flex w-full gap-2 sm:w-auto" do |form| %><div class="min-w-0 flex-1 sm:w-48"><%= form.label :movement_type, t("inventory.movement_type"), class: "sr-only" %><%= form.select :movement_type, options_for_select([[t("inventory.all_movements"), ""]] + StockMovement.movement_types.keys.map { |type| [t("inventory.movement_types.#{type}"), type] }, params[:movement_type]), {}, class: "form-input mt-0" %></div><%= form.submit t("production.filter"), class: "button-secondary" %><% end %></div>
      <% if @stock_movements.any? %><div class="mt-4 divide-y divide-line"><%= render partial: "movement_row", collection: @stock_movements, as: :movement, locals: { item: @inventory_item } %></div><% else %><div class="mt-4"><%= render "shared/empty_state", title: t("inventory.no_movements"), description: t("inventory.no_movements_description"), icon: "reports" %></div><% end %>
      <% if @pagy.pages > 1 %><nav class="mt-4 flex items-center justify-between border-t border-line pt-3 text-xs text-ink-muted"><% if @pagy.previous %><%= link_to t("forms.previous"), inventory_item_path(@inventory_item, request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), inventory_item_path(@inventory_item, request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% end %>
    </section>
  </div>

  <aside class="space-y-4 xl:sticky xl:top-6">
    <section class="section-card"><h2 class="section-title"><%= t("inventory.item_details") %></h2><dl class="mt-4 space-y-3"><div class="flex items-start justify-between gap-3"><dt class="detail-label"><%= t("inventory.cost_price") %></dt><dd class="detail-value tabular text-right"><%= money(@inventory_item.cost_price) %></dd></div><div class="flex items-start justify-between gap-3"><dt class="detail-label"><%= t("inventory.selling_price") %></dt><dd class="detail-value tabular text-right"><%= money(@inventory_item.selling_price) %></dd></div><div class="flex items-start justify-between gap-3"><dt class="detail-label"><%= t("inventory.supplier") %></dt><dd class="detail-value text-right"><%= @inventory_item.supplier_name.presence || "—" %></dd></div><div class="flex items-start justify-between gap-3"><dt class="detail-label"><%= t("inventory.supplier_contact") %></dt><dd class="detail-value text-right"><%= @inventory_item.supplier_contact.presence || "—" %></dd></div></dl><% if @inventory_item.notes.present? %><div class="mt-4 border-t border-line pt-4"><p class="detail-label"><%= t("inventory.notes") %></p><p class="mt-1 whitespace-pre-line text-xs leading-5 text-ink-muted"><%= @inventory_item.notes %></p></div><% end %></section>

    <% if @movement_types.any? %><section class="form-section" data-controller="inventory-movement" data-inventory-movement-on-hand-value="<%= @inventory_item.quantity_on_hand %>" data-inventory-movement-reserved-value="<%= @inventory_item.quantity_reserved %>" data-inventory-movement-unit-value="<%= t("inventory.units.#{@inventory_item.unit}") %>"><p class="eyebrow"><%= t("inventory.ledger_entry") %></p><h2 class="section-title mt-1"><%= t("inventory.record_movement") %></h2><p class="supporting-text mt-1"><%= t("inventory.record_movement_description") %></p><%= form_with url: stock_movements_path, scope: :stock_movement, class: "mt-4 space-y-3" do |form| %><%= form.hidden_field :inventory_item_id, value: @inventory_item.id %><div><%= form.label :movement_type, t("inventory.movement_type"), class: "text-xs font-semibold text-ink" %><% movement_options = @movement_types.map { |type| [t("inventory.movement_types.#{type}"), type, { data: { direction: (type.in?(%w[stock_in adjustment_in]) ? "in" : "out"), description: t("inventory.movement_descriptions.#{type}") } }] } %><%= form.select :movement_type, options_for_select(movement_options), { prompt: t("inventory.choose_movement_type") }, class: "form-input", required: true, data: { inventory_movement_target: "type", action: "change->inventory-movement#preview" } %></div><div><%= form.label :quantity, t("inventory.quantity"), class: "text-xs font-semibold text-ink" %><div class="relative"><%= form.number_field :quantity, min: 0.001, step: "0.001", class: "form-input pr-16 tabular", inputmode: "decimal", required: true, data: { inventory_movement_target: "quantity", action: "input->inventory-movement#preview" } %><span class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-xs text-ink-muted"><%= t("inventory.units.#{@inventory_item.unit}") %></span></div></div><p class="rounded-lg bg-surface-muted/55 p-2.5 text-[11px] leading-4 text-ink-muted" data-inventory-movement-target="description"></p><div class="grid grid-cols-2 gap-2 rounded-xl border border-line p-3"><div><p class="detail-label"><%= t("inventory.current_on_hand") %></p><p class="mt-1 tabular text-xs font-semibold text-ink" data-inventory-movement-target="onHand"></p></div><div><p class="detail-label"><%= t("inventory.projected_on_hand") %></p><p class="mt-1 tabular text-xs font-semibold text-ink" data-inventory-movement-target="projectedOnHand"></p></div><div><p class="detail-label"><%= t("inventory.current_available") %></p><p class="mt-1 tabular text-xs font-semibold text-ink" data-inventory-movement-target="available"></p></div><div><p class="detail-label"><%= t("inventory.projected_available") %></p><p class="mt-1 tabular text-xs font-semibold text-ink" data-inventory-movement-target="projectedAvailable"></p></div><span class="hidden" data-inventory-movement-target="reserved"></span></div><p class="hidden rounded-lg border border-[#fecdca] bg-[#fef3f2] p-2.5 text-xs font-semibold text-[#b42318]" data-inventory-movement-target="warning"><%= t("inventory.insufficient_available") %></p><div><%= form.label :happened_on, t("inventory.movement_date"), class: "text-xs font-semibold text-ink" %><%= form.date_field :happened_on, value: Date.current, max: Date.current, class: "form-input", required: true %></div><div><%= form.label :reference, t("inventory.reference"), class: "text-xs font-semibold text-ink" %><%= form.text_field :reference, class: "form-input", placeholder: t("inventory.reference_placeholder") %></div><div><%= form.label :notes, t("inventory.notes"), class: "text-xs font-semibold text-ink" %><%= form.text_area :notes, rows: 3, class: "form-input" %></div><%= form.submit t("inventory.record_movement"), class: "button-primary w-full", data: { inventory_movement_target: "submit" } %><% end %></section><% end %>
  </aside>
</div>
