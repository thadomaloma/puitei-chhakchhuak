<% content_for :title, t("inventory.index_title") %>

<%= render "shared/page_header", eyebrow: t("inventory.eyebrow"), title: t("inventory.title"), description: t("inventory.directory_description", count: @item_count), action: (link_to(ui_icon("plus", size: 17) + t("inventory.new"), new_inventory_item_path, class: "button-primary") if policy(InventoryItem).create?) %>

<section class="mt-5 grid grid-cols-2 gap-3 xl:grid-cols-4">
  <%= render "shared/stat_card", label: t("inventory.active_items"), value: @item_count, detail: t("inventory.catalogued_items"), icon: "inventory", tone: "neutral" %>
  <%= render "shared/stat_card", label: t("inventory.low_stock"), value: @low_stock_count, detail: t("inventory.out_of_stock_detail", count: @out_of_stock_count), icon: "warning", tone: (@low_stock_count.positive? ? "warning" : "success"), href: inventory_items_path(stock: "low") %>
  <%= render "shared/stat_card", label: t("inventory.reserved_items"), value: @reserved_count, detail: t("inventory.linked_orders"), icon: "orders", tone: "info", href: inventory_items_path(stock: "reserved") %>
  <%= render "shared/stat_card", label: t("inventory.stock_value"), value: money(@stock_value), detail: t("inventory.at_cost"), icon: "reports", tone: "premium" %>
</section>

<%= form_with url: inventory_items_path, method: :get, class: "toolbar mt-5", data: { controller: "mobile-menu", action: "keydown.esc@window->mobile-menu#close" } do |form| %>
  <div class="grid gap-3 xl:grid-cols-[minmax(18rem,1fr)_11rem_11rem_12rem_auto] xl:items-end">
    <div><%= form.label :query, t("inventory.search"), class: "mb-1.5 block text-xs font-semibold text-ink" %><div class="relative"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, value: params[:query], placeholder: t("inventory.search"), class: "form-input mt-0 pl-9", autocomplete: "off" %></div></div>
    <div class="hidden xl:contents"><%= render "filters", form: form, suffix: "desktop" %></div>
    <div class="grid grid-cols-2 gap-2 xl:block"><button type="button" class="button-secondary xl:hidden" data-mobile-menu-target="button" data-action="mobile-menu#open" aria-controls="inventory-filter-panel" aria-expanded="false"><%= ui_icon("more", size: 16) %><%= t("inventory.filters") %></button><%= form.submit t("production.filter"), class: "button-primary w-full" %></div>
  </div>
  <div id="inventory-filter-panel" class="hidden xl:hidden" data-mobile-menu-target="panel" hidden aria-hidden="true"><button type="button" class="fixed inset-0 z-40 bg-ink/30 backdrop-blur-[2px]" aria-label="<%= t('forms.close') %>" data-action="mobile-menu#close"></button><section role="dialog" aria-modal="true" aria-label="<%= t('inventory.filters') %>" class="fixed inset-x-0 bottom-0 z-50 rounded-t-2xl border border-line bg-surface p-4 shadow-2xl"><div class="mx-auto mb-4 h-1 w-10 rounded-full bg-line-strong"></div><div class="flex items-center justify-between"><div><p class="eyebrow"><%= t("inventory.eyebrow") %></p><h2 class="mt-1 text-lg font-semibold text-ink"><%= t("inventory.filters") %></h2></div><button type="button" class="button-secondary button-icon" aria-label="<%= t('forms.close') %>" data-mobile-menu-target="close" data-action="mobile-menu#close"><%= ui_icon("x", size: 17) %></button></div><div class="mt-5 space-y-4"><%= render "filters", form: form, suffix: "mobile" %></div><div class="mt-5 grid grid-cols-2 gap-2"><%= link_to t("forms.clear"), inventory_items_path, class: "button-secondary" %><%= form.submit t("inventory.apply_filters"), class: "button-primary" %></div></section></div>
<% end %>

<% if @filters_active %><div class="mt-3 flex flex-wrap items-center gap-2 text-xs"><span class="font-semibold text-ink"><%= t("inventory.active_filters") %></span><% if params[:query].present? %><span class="status-badge status-neutral"><%= params[:query] %></span><% end %><% if params[:category].present? %><span class="status-badge status-info"><%= t("inventory.categories.#{params[:category]}") %></span><% end %><% if params[:stock].present? %><span class="status-badge status-warning"><%= params[:stock] == "reserved" ? t("inventory.reserved_items") : t("inventory.stock_filters.#{params[:stock]}") %></span><% end %><% if params[:archived] == "1" %><span class="status-badge status-neutral"><%= t("inventory.include_archived") %></span><% end %><%= link_to t("forms.clear"), inventory_items_path, class: "font-semibold text-brand hover:text-brand-hover" %></div><% end %>

<div class="mt-5 flex flex-wrap items-end justify-between gap-3"><div><p class="eyebrow"><%= t("inventory.catalogue") %></p><h2 class="section-title mt-1"><%= t("inventory.materials") %></h2><p class="supporting-text mt-1"><%= t("inventory.results", count: @filtered_count) %></p></div></div>

<% if @inventory_items.any? %>
  <div class="mt-4 grid gap-3 md:grid-cols-2 xl:hidden"><%= render partial: "directory_card", collection: @inventory_items, as: :item %></div>
  <div class="table-shell mt-4 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("inventory.item") %></th><th><%= t("inventory.category") %></th><th><%= t("inventory.on_hand") %></th><th><%= t("inventory.reserved") %></th><th><%= t("inventory.available") %></th><th><%= t("inventory.status") %></th><th class="text-right"><%= t("inventory.cost_value") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody><%= render partial: "directory_row", collection: @inventory_items, as: :item %></tbody></table></div>
  <nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), inventory_items_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), inventory_items_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav>
<% else %>
  <div class="mt-4"><%= render "shared/empty_state", title: (@item_count.zero? ? t("inventory.empty_first") : t("inventory.empty")), description: (@item_count.zero? ? t("inventory.empty_first_description") : t("inventory.empty_description")), icon: "inventory", action: ((link_to t("inventory.new"), new_inventory_item_path, class: "button-primary") if @item_count.zero? && policy(InventoryItem).create?) %></div>
<% end %>
