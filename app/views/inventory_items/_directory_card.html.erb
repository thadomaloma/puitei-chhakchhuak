<article class="card min-w-0 p-4">
  <div class="flex min-w-0 items-start gap-3"><% if item.image.attached? %><%= image_tag item.image.variant(:thumb), alt: "", class: "size-12 shrink-0 rounded-xl border border-line object-cover" %><% else %><span class="grid size-12 shrink-0 place-items-center rounded-xl bg-surface-muted text-ink-muted"><%= ui_icon("inventory", size: 19) %></span><% end %><div class="min-w-0 flex-1"><div class="flex items-start justify-between gap-2"><div class="min-w-0"><h2 class="truncate text-sm font-semibold text-ink"><%= item.name %></h2><p class="mt-0.5 truncate font-mono text-[10px] text-ink-muted"><%= item.sku %> · <%= t("inventory.categories.#{item.category}") %></p></div><% if item.active? %><%= inventory_stock_badge(item) %><% else %><%= status_badge("archived", label: t("inventory.archived_label")) %><% end %></div></div></div>
  <dl class="mt-4 grid grid-cols-3 gap-2 border-y border-line py-3"><div><dt class="detail-label"><%= t("inventory.on_hand") %></dt><dd class="mt-1 tabular text-sm font-semibold text-ink"><%= stock_quantity(item.quantity_on_hand) %></dd></div><div><dt class="detail-label"><%= t("inventory.reserved") %></dt><dd class="mt-1 tabular text-sm font-semibold text-ink-muted"><%= stock_quantity(item.quantity_reserved) %></dd></div><div><dt class="detail-label"><%= t("inventory.available") %></dt><dd class="mt-1 truncate tabular text-sm font-semibold text-ink"><%= stock_quantity(item.available_quantity, item.unit) %></dd></div></dl>
  <div class="mt-3 flex items-center justify-between gap-3"><div><p class="detail-label"><%= t("inventory.cost_value") %></p><p class="mt-0.5 tabular text-sm font-semibold text-ink"><%= money(item.quantity_on_hand * item.cost_price) %></p></div><%= link_to t("inventory.view_item"), item, class: "button-secondary button-sm" %></div>
</article>
