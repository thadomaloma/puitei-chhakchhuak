<% content_for :title, t("saas.onboarding") %><%= render "shared/page_header", eyebrow: t("saas.setup_eyebrow"), title: t("saas.setup_shop"), description: t("saas.setup_description") %><%= form_with scope: :shop, url: onboarding_path, method: :patch, class: "mx-auto mt-5 max-w-5xl space-y-4" do |form| %><%= render "shared/form_errors", record: @shop %><section class="form-section"><h2 class="section-title"><%= t("saas.shop_profile") %></h2><div class="mt-4 grid gap-4 sm:grid-cols-2"><div><%= form.label :name, t("saas.shop_name"), class: "form-label" %><%= form.text_field :name, value: @shop.name, class: "form-input", required: true %></div><div><%= form.label :country, t("saas.country"), class: "form-label" %><%= form.text_field :country, value: @shop.country, class: "form-input", required: true %></div><div><%= form.label :phone, t("customers.phone_number"), class: "form-label" %><%= form.telephone_field :phone, value: @branch.phone, class: "form-input" %></div><div><%= form.label :whatsapp_number, t("customers.whatsapp_number"), class: "form-label" %><%= form.telephone_field :whatsapp_number, value: @settings.whatsapp_number, class: "form-input" %></div><div class="sm:col-span-2"><%= form.label :address, t("customers.address"), class: "form-label" %><%= form.text_area :address, value: @branch.address, rows: 3, class: "form-input" %></div></div></section><section class="form-section"><h2 class="section-title"><%= t("saas.business_preferences") %></h2><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><div><%= form.label :currency, t("saas.currency"), class: "form-label" %><%= form.select :currency, [["INR", "INR"]], { selected: @settings.currency }, class: "form-input" %></div><div><%= form.label :time_zone, t("saas.timezone"), class: "form-label" %><%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, { default: @branch.time_zone }, class: "form-input" %></div><div><%= form.label :measurement_unit, t("saas.measurement_unit"), class: "form-label" %><%= form.select :measurement_unit, ShopSetting::MEASUREMENT_UNITS.map { |unit| [unit.humanize, unit] }, { selected: @settings.measurement_unit }, class: "form-input" %></div><div><%= form.label :invoice_prefix, t("saas.invoice_prefix"), class: "form-label" %><%= form.text_field :invoice_prefix, value: @settings.invoice_prefix, class: "form-input uppercase" %></div><div><%= form.label :default_delivery_days, t("saas.default_delivery_days"), class: "form-label" %><%= form.number_field :default_delivery_days, value: @settings.default_delivery_days, min: 1, class: "form-input" %></div></div></section><div class="sticky-actions"><%= link_to t("saas.finish_later"), root_path, class: "button-secondary" %><%= form.submit t("saas.complete_setup"), class: "button-primary" %></div><% end %>
