<% content_for :title, t("design_collections.add_designs_title", name: @design_collection.name) %>
<%= render "shared/back_link", path: design_collection_path(@design_collection), label: @design_collection.name %>
<div class="mt-3"><%= render "shared/page_header", eyebrow: t("design_collections.picker_eyebrow"), title: t("design_collections.add_designs"), description: t("design_collections.picker_description", name: @design_collection.name) %></div>

<%= form_with url: new_design_collection_design_collection_item_path(@design_collection), method: :get, class: "toolbar mt-5" do |form| %>
  <div class="relative min-w-0 flex-1"><span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.search_field :query, value: params[:query], class: "form-input mt-0 pl-9", placeholder: t("designs.search_placeholder"), aria: { label: t("designs.search") } %></div>
  <%= form.select :garment_type, options_from_collection_for_select(@garment_templates, :garment_type, :name, params[:garment_type]), { include_blank: t("designs.all_garments") }, class: "form-input mt-0 w-auto min-w-40" %>
  <label class="flex min-h-10 items-center gap-2 rounded-xl border border-line bg-surface px-3 text-xs font-semibold text-ink"><%= form.check_box :favourites, { checked: params[:favourites] == "1", class: "size-4 rounded border-line text-brand" }, "1", "0" %><%= t("design_collections.favourite_filter") %></label>
  <%= form.select :tag, options_for_select(@tag_options, params[:tag]), { include_blank: t("design_collections.all_tags") }, class: "form-input mt-0 w-auto min-w-36" %>
  <%= form.submit t("designs.apply_filters"), class: "button-secondary" %>
<% end %>

<% if @designs.any? %><%= form_with url: design_collection_design_collection_items_path(@design_collection), method: :post do |form| %><fieldset><legend class="sr-only"><%= t("design_collections.select_designs") %></legend><div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 2xl:grid-cols-5"><% @designs.each do |design| %><label class="group relative cursor-pointer overflow-hidden rounded-2xl border border-line bg-surface shadow-card transition has-[:checked]:border-brand has-[:checked]:ring-2 has-[:checked]:ring-brand/15"><span class="absolute right-3 top-3 z-10 grid size-8 place-items-center rounded-full border border-white/70 bg-white/95 shadow-sm"><%= check_box_tag "design_ids[]", design.id, false, class: "size-4 rounded border-line text-brand focus:ring-brand", aria: { label: t("design_collections.select_design", name: design.title) } %></span><div class="aspect-[4/5] overflow-hidden bg-surface-muted"><% if (image = design.primary_image_attachment) %><%= image_tag image.variant(:thumb), alt: "", class: "size-full object-cover", loading: "lazy", width: 480, height: 600 %><% else %><span class="grid size-full place-items-center text-ink-muted"><%= ui_icon("designs", size: 34) %></span><% end %></div><span class="block p-3.5"><span class="line-clamp-2 block text-sm font-semibold text-ink"><%= design.title %></span><span class="mt-1 block text-[11px] text-ink-muted"><%= design.garment_type.humanize %></span></span></label><% end %></div></fieldset><div class="sticky bottom-[calc(4.5rem+env(safe-area-inset-bottom))] z-20 mt-5 flex flex-col gap-2 rounded-2xl border border-line bg-surface/95 p-3 shadow-xl backdrop-blur sm:bottom-4 sm:flex-row sm:items-center sm:justify-between"><p class="text-xs text-ink-muted"><%= t("design_collections.multi_select_hint") %></p><div class="flex gap-2"><%= link_to t("forms.cancel"), @design_collection, class: "button-secondary flex-1 sm:flex-none" %><%= form.submit t("design_collections.add_selected"), class: "button-primary flex-1 sm:flex-none" %></div></div><% end %>
  <% if @pagy.previous || @pagy.next %><nav class="mt-5 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), new_design_collection_design_collection_item_path(@design_collection, request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), new_design_collection_design_collection_item_path(@design_collection, request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav><% end %>
<% else %><div class="mt-5"><%= render "shared/empty_state", title: t("design_collections.no_available_designs"), description: t("design_collections.no_available_designs_description"), icon: "designs", action: link_to(t("designs.upload"), new_design_path, class: "button-secondary") %></div><% end %>
