<% content_for :title, @profile.name %>
<%= render "shared/back_link", path: @customer, label: @customer.full_name %>

<div class="mt-3"><%= render "shared/page_header", eyebrow: @profile.measurement_template.name, title: @profile.name, description: "#{@customer.full_name} · #{@profile.unit.humanize}", action: (link_to(t("measurements.new_version"), new_customer_measurement_profile_measurement_path(@customer, @profile), class: "button-primary") if policy(@profile).create? && @profile.active?), secondary_action: (button_to(t("measurement_profiles.archive"), customer_measurement_profile_path(@customer, @profile), method: :delete, class: "button-danger", form: { data: { turbo_confirm: t("measurement_profiles.archive_confirm") } }) if policy(@profile).destroy? && @profile.active?) %></div>

<section class="section-card mt-4">
  <div class="flex flex-wrap items-start justify-between gap-3"><div><h2 class="section-title"><%= t("measurement_profiles.profile_details") %></h2><p class="supporting-text"><%= t("measurement_profiles.profile_details_description") %></p></div><%= status_badge(@profile.active? ? "active" : "archived", label: @profile.active? ? t("measurements.active") : t("measurements.archived"), variant: @profile.active? ? "success" : "neutral") %></div>
  <dl class="mt-4 grid gap-4 border-t border-line pt-4 sm:grid-cols-2 lg:grid-cols-4"><div><dt class="detail-label"><%= t("measurements.garment") %></dt><dd class="detail-value"><%= @profile.measurement_template.name %></dd></div><div><dt class="detail-label"><%= t("measurements.active_unit_label") %></dt><dd class="detail-value"><%= @profile.unit.humanize %></dd></div><div><dt class="detail-label"><%= t("measurements.saved_versions") %></dt><dd class="detail-value tabular"><%= @pagy.count %></dd></div><div><dt class="detail-label"><%= t("measurements.latest_version") %></dt><dd class="detail-value"><%= @profile.latest_measurement ? t("measurements.version", version: @profile.latest_measurement.version) : "—" %></dd></div></dl>
  <dl class="mt-5 grid gap-4 border-t border-line pt-4 md:grid-cols-3"><div><dt class="detail-label"><%= t("measurement_profiles.fitting_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.fitting_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.posture_notes") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.posture_notes.presence || "—" %></dd></div><div><dt class="detail-label"><%= t("measurement_profiles.preferences") %></dt><dd class="detail-value whitespace-pre-line"><%= @profile.preferences.presence || "—" %></dd></div></dl>
</section>

<section class="mt-5">
  <div><p class="eyebrow"><%= t("measurements.permanent_history") %></p><h2 class="section-title mt-1"><%= t("measurements.history") %></h2><p class="supporting-text"><%= t("measurements.history_description") %></p></div>
  <% if @measurements.any? %>
    <div class="mt-3 space-y-3"><% @measurements.each do |measurement| %><% previous = @previous_measurements_by_version[measurement.version - 1] %><% changes = measurement_value_changes(measurement, previous) %><article class="section-card"><div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between"><div><div class="flex flex-wrap items-center gap-2"><h3 class="text-sm font-semibold text-ink"><%= t("measurements.version", version: measurement.version) %></h3><% if measurement.order_items.any? %><%= status_badge("used", label: t("measurements.used_in_orders", count: measurement.order_items.size), variant: "info") %><% end %></div><p class="mt-1 text-xs text-ink-muted"><%= l(measurement.measured_on, format: :long) %> · <%= measurement.created_by.name %><% if measurement.copied_from %> · <%= t("measurements.copied_source_short", version: measurement.copied_from.version) %><% end %></p></div><div class="flex flex-wrap justify-end gap-2"><%= link_to t("forms.view"), customer_measurement_profile_measurement_path(@customer, @profile, measurement), class: "button-secondary button-sm" %><% if policy(@profile).create? && @profile.active? %><%= link_to t("measurements.copy"), new_customer_measurement_profile_measurement_path(@customer, @profile, copy_from_id: measurement.id), class: "button-ghost button-sm" %><% end %></div></div>
      <dl class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-6"><% measurement.values.first(6).each do |key, value| %><div class="rounded-lg bg-surface-muted/60 p-2.5"><dt class="text-[10px] text-ink-muted"><%= key.humanize %></dt><dd class="mt-0.5 tabular text-sm font-semibold text-ink"><%= value %> <span class="text-[9px] font-medium text-ink-muted"><%= @profile.unit == "inches" ? "in" : "cm" %></span></dd></div><% end %></dl>
      <% if changes.any? %><p class="mt-3 text-[11px] text-ink-muted"><span class="font-semibold text-ink"><%= t("measurements.changed_fields") %>:</span> <%= changes.first(4).map { |change| change[:label] }.join(", ") %><% if changes.size > 4 %> +<%= changes.size - 4 %><% end %></p><% end %>
      <% if measurement.notes.present? %><p class="mt-3 line-clamp-2 text-xs leading-5 text-ink-muted"><%= measurement.notes %></p><% end %></article><% end %></div>
    <% if @pagy.previous || @pagy.next %><nav class="mt-4 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), customer_measurement_profile_path(@customer, @profile, page: @pagy.previous), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), customer_measurement_profile_path(@customer, @profile, page: @pagy.next), class: "button-secondary button-sm" %><% end %></nav><% end %>
  <% else %><div class="mt-3"><%= render "shared/empty_state", title: t("measurements.empty"), description: t("measurement_profiles.no_measurement"), icon: "ruler", action: (link_to(t("measurements.record_first"), new_customer_measurement_profile_measurement_path(@customer, @profile), class: "button-primary") if @profile.active? && policy(@profile).create?) %></div><% end %>
</section>
