<% content_for :title, t("measurement_profiles.new") %>
<%= render "shared/back_link", path: @customer, label: @customer.full_name %>
<div class="mb-5 mt-3 max-w-5xl"><%= render "shared/page_header", eyebrow: @customer.customer_code, title: t("measurement_profiles.new"), description: t("measurement_profiles.new_description") %></div>

<%= form_with model: [@customer, @profile], class: "max-w-5xl space-y-5" do |form| %>
  <%= render "shared/form_errors", record: @profile %>
  <section class="form-section">
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="sm:col-span-2"><%= form.label :measurement_template_id, t("measurement_profiles.garment_template"), class: "block text-sm font-semibold" %><%= form.collection_select :measurement_template_id, @templates, :id, :name, { prompt: t("measurement_profiles.choose_template") }, { required: true, class: "form-input" } %></div>
      <div><%= form.label :name, class: "block text-sm font-semibold" %><%= form.text_field :name, required: true, class: "form-input" %></div>
      <div><%= form.label :unit, class: "block text-sm font-semibold" %><%= form.select :unit, MeasurementProfile::UNITS.map { |unit| [unit.humanize, unit] }, {}, class: "form-input" %></div>
      <div class="sm:col-span-2"><%= form.label :fitting_notes, class: "block text-sm font-semibold" %><%= form.text_area :fitting_notes, rows: 3, class: "form-input", placeholder: t("measurement_profiles.fitting_placeholder") %></div>
      <div class="sm:col-span-2"><%= form.label :posture_notes, class: "block text-sm font-semibold" %><%= form.text_area :posture_notes, rows: 3, class: "form-input" %></div>
      <div class="sm:col-span-2"><%= form.label :preferences, class: "block text-sm font-semibold" %><%= form.text_area :preferences, rows: 3, class: "form-input" %></div>
    </div>
  </section>
  <div class="sticky-actions"><%= link_to t("forms.cancel"), @customer, class: "button-secondary flex-1" %><%= form.submit t("measurement_profiles.continue"), class: "button-primary flex-1" %></div>
<% end %>
