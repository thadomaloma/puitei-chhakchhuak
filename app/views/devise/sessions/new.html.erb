<section class="auth-card">
  <div class="mb-7"><%= render "shared/brand", full: true %></div>
  <h1 class="page-title"><%= t("sessions.title") %></h1>
  <p class="supporting-text mt-1.5"><%= t("sessions.subtitle") %></p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-6 space-y-4" }) do |f| %>
    <div><%= f.label :email, class: "block text-xs font-semibold text-ink" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, inputmode: "email", class: "form-input" %></div>
    <div><div class="flex items-center justify-between"><%= f.label :password, class: "block text-xs font-semibold text-ink" %><%= link_to t("sessions.forgot_password"), new_password_path(resource_name), class: "text-xs font-semibold text-emerald-refined hover:underline" %></div><%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-input" %></div>
    <% if devise_mapping.rememberable? %><label class="flex min-h-10 items-center gap-2.5 text-xs font-medium text-ink-muted"><%= f.check_box :remember_me, class: "size-4 rounded border-line text-brand" %><%= t("sessions.remember_me") %></label><% end %>
    <%= f.submit t("sessions.sign_in"), class: "button-primary w-full" %>
  <% end %>
</section>
