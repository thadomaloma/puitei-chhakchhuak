<section class="auth-card">
  <div class="mb-7"><%= render "shared/brand", full: true %></div>
  <h1 class="page-title">Forgot your password?</h1>
  <p class="supporting-text mt-1.5">Enter your email and we’ll send you secure reset instructions.</p>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6 space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <div><%= f.label :email, class: "block text-xs font-semibold text-ink" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-input" %></div>
    <%= f.submit "Send reset instructions", class: "button-primary w-full" %>
  <% end %>
  <div class="mt-4"><%= link_to new_session_path(resource_name), class: "back-link" do %><%= ui_icon("arrow-left", size: 14) %>Back to sign in<% end %></div>
</section>
