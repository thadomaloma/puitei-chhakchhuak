<% content_for :title, t("expenses.index_title") %>

<%= render "shared/page_header", eyebrow: t("expenses.eyebrow"), title: t("expenses.dashboard"), description: t("expenses.description"), action: (link_to(ui_icon("plus", size: 17) + t("expenses.new"), new_expense_path, class: "button-primary") if policy(Expense).create?) %>

<section class="mt-5 grid grid-cols-2 gap-2 xl:grid-cols-4">
  <%= render "shared/stat_card", label: t("expenses.today"), value: money(@spent_today), detail: l(Date.current), icon: "calendar", tone: "neutral" %>
  <%= render "shared/stat_card", label: t("expenses.this_month"), value: money(@spent_this_month), detail: t("expenses.approved_active"), icon: "expenses", tone: "premium" %>
  <%= render "shared/stat_card", label: t("expenses.pending_review"), value: @pending_count, detail: t("expenses.needs_approval"), icon: "clock", tone: (@pending_count.positive? ? "warning" : "neutral") %>
  <%= render "shared/stat_card", label: t("expenses.recurring"), value: @recurring_count, detail: t("expenses.active_schedules"), icon: "reports", tone: "success" %>
</section>

<%= form_with url: expenses_path, method: :get, class: "toolbar mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-[minmax(13rem,1fr)_auto_auto_auto_auto_auto]" do |form| %>
  <div class="relative sm:col-span-2 xl:col-span-1"><span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted"><%= ui_icon("search", size: 16) %></span><%= form.label :query, t("expenses.search"), class: "sr-only" %><%= form.search_field :query, value: params[:query], placeholder: t("expenses.search"), class: "form-input mt-0 pl-9" %></div>
  <div><%= form.label :category, t("expenses.category"), class: "sr-only" %><%= form.select :category, Expense.categories.keys.map { |key| [ t("expenses.categories.#{key}"), key ] }, { include_blank: t("expenses.all_categories"), selected: params[:category] }, class: "form-select mt-0" %></div>
  <div><%= form.label :status, t("expenses.status"), class: "sr-only" %><%= form.select :status, [[t("expenses.statuses.pending"), "pending"], [t("expenses.statuses.approved"), "approved"], [t("expenses.statuses.voided"), "voided"]], { include_blank: t("expenses.all_statuses"), selected: params[:status] }, class: "form-select mt-0" %></div>
  <div><%= form.label :from, t("expenses.from"), class: "sr-only" %><%= form.date_field :from, value: params[:from], class: "form-input mt-0", aria: { label: t("expenses.from") } %></div>
  <div><%= form.label :to, t("expenses.to"), class: "sr-only" %><%= form.date_field :to, value: params[:to], class: "form-input mt-0", aria: { label: t("expenses.to") } %></div>
  <%= form.submit t("forms.search"), class: "button-secondary" %>
<% end %>

<div class="mt-3 flex justify-end"><%= link_to export_expenses_path(request.query_parameters), class: "button-ghost button-sm" do %><%= ui_icon("reports", size: 15) %><%= t("expenses.export_csv") %><% end %></div>

<% if @expenses.any? %>
  <div class="table-shell mt-3 hidden xl:block"><table class="data-table"><thead><tr><th><%= t("expenses.expense") %></th><th><%= t("expenses.category") %></th><th><%= t("expenses.vendor") %></th><th><%= t("expenses.incurred_on") %></th><th><%= t("expenses.status") %></th><th class="text-right"><%= t("expenses.amount") %></th><th><span class="sr-only"><%= t("forms.actions") %></span></th></tr></thead><tbody>
    <% @expenses.each do |expense| %><tr><td><%= link_to expense.expense_number, expense, class: "font-mono text-xs font-semibold text-brand" %><p class="mt-0.5 max-w-64 truncate text-[11px] text-ink-muted"><%= expense.description %></p></td><td class="text-ink-muted"><%= t("expenses.categories.#{expense.category}") %></td><td><p class="max-w-44 truncate font-medium text-ink"><%= expense.vendor.presence || "—" %></p><p class="text-[11px] text-ink-muted"><%= expense.branch.name %></p></td><td class="tabular whitespace-nowrap text-ink-muted"><%= l(expense.incurred_on) %></td><td><%= expense_status_badge(expense) %></td><td class="tabular whitespace-nowrap text-right font-semibold <%= expense.voided? ? 'text-ink-muted line-through' : 'text-ink' %>"><%= money(expense.amount, expense.currency) %></td><td class="text-right"><%= link_to expense, class: "button-ghost button-icon button-sm", aria: { label: t("forms.view") } do %><%= ui_icon("chevron-right", size: 15) %><% end %></td></tr><% end %>
  </tbody></table></div>

  <div class="mt-3 space-y-2 xl:hidden"><% @expenses.each do |expense| %><%= link_to expense, class: "card block min-w-0 p-3.5" do %><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="truncate font-mono text-[11px] font-semibold text-brand"><%= expense.expense_number %></p><p class="mt-0.5 truncate text-sm font-semibold text-ink"><%= expense.description %></p><p class="mt-1 truncate text-[11px] text-ink-muted"><%= t("expenses.categories.#{expense.category}") %> · <%= expense.vendor.presence || t("expenses.no_vendor") %></p></div><div class="shrink-0 text-right"><p class="tabular text-sm font-semibold <%= expense.voided? ? 'text-ink-muted line-through' : 'text-ink' %>"><%= money(expense.amount, expense.currency) %></p><div class="mt-1"><%= expense_status_badge(expense) %></div></div></div><div class="mt-2.5 flex items-center justify-between border-t border-line pt-2.5 text-[11px] text-ink-muted"><span><%= t("payments.methods.#{expense.payment_method}") %></span><span class="tabular"><%= l(expense.incurred_on) %></span></div><% end %><% end %></div>

  <nav class="mt-4 flex items-center justify-between text-xs text-ink-muted" aria-label="Pagination"><% if @pagy.previous %><%= link_to t("forms.previous"), expenses_path(request.query_parameters.merge(page: @pagy.previous)), class: "button-secondary button-sm" %><% else %><span></span><% end %><span><%= t("forms.page", page: @pagy.page) %></span><% if @pagy.next %><%= link_to t("forms.next"), expenses_path(request.query_parameters.merge(page: @pagy.next)), class: "button-secondary button-sm" %><% end %></nav>
<% else %>
  <div class="mt-4"><%= render "shared/empty_state", title: t("expenses.empty"), description: t("expenses.empty_description"), icon: "expenses" %></div>
<% end %>
