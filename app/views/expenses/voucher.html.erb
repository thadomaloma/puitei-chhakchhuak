<% content_for :title, "#{t('expenses.expense_voucher')} · #{@expense.expense_number}" %>
<main class="mx-auto max-w-2xl p-6 sm:p-10">
  <div class="print-hidden mb-6 flex justify-between"><%= link_to "← #{@expense.expense_number}", @expense, class: "button-secondary" %><button type="button" data-controller="print" data-action="print#print" class="button-primary"><%= t("expenses.print_voucher") %></button></div>
  <header class="border-b-2 border-stone-900 pb-5 text-center"><p class="text-sm font-bold uppercase tracking-[0.2em]"><%= @expense.branch.shop_setting.shop_name %></p><p class="mt-1 whitespace-pre-line text-xs text-stone-600"><%= @expense.branch.shop_setting.address %></p><h1 class="mt-5 text-3xl font-black"><%= t("expenses.expense_voucher") %></h1><p class="mt-1 font-mono font-bold"><%= @expense.expense_number %></p></header>
  <% if @expense.voided? %><div class="mt-5 border-4 border-red-700 p-3 text-center text-2xl font-black uppercase text-red-700"><%= t("expenses.statuses.voided") %></div><% elsif @expense.approval_pending? %><div class="mt-5 border-2 border-amber-700 p-3 text-center text-lg font-black uppercase text-amber-800"><%= t("expenses.statuses.pending") %></div><% end %>
  <section class="grid grid-cols-2 gap-5 border-b border-stone-300 py-5 text-sm"><div><p class="text-xs font-bold uppercase text-stone-500"><%= t("expenses.description") %></p><p class="mt-1 font-bold"><%= @expense.description %></p><p><%= t("expenses.categories.#{@expense.category}") %></p></div><div class="text-right"><p class="text-xs font-bold uppercase text-stone-500"><%= t("expenses.incurred_on") %></p><p class="mt-1 font-bold"><%= l(@expense.incurred_on, format: :long) %></p><p><%= @expense.vendor.presence || t("expenses.no_vendor") %></p></div></section>
  <section class="py-8 text-center"><p class="text-sm font-bold uppercase text-stone-500"><%= t("expenses.amount_paid") %></p><p class="mt-2 text-4xl font-black"><%= money(@expense.amount, @expense.currency) %></p><p class="mt-2 font-semibold"><%= t("payments.methods.#{@expense.payment_method}") %><% if @expense.reference_number.present? %> · <%= @expense.reference_number %><% end %></p></section>
  <dl class="border-y border-stone-300 py-4 text-sm"><div class="flex justify-between"><dt><%= t("expenses.recorded_by") %></dt><dd class="font-bold"><%= @expense.recorded_by.name %></dd></div><div class="mt-2 flex justify-between"><dt><%= t("expenses.approved_by") %></dt><dd class="font-bold"><%= @expense.approved_by&.name || t("expenses.awaiting_approval") %></dd></div><div class="mt-2 flex justify-between"><dt><%= t("expenses.recurrence") %></dt><dd class="font-bold"><%= t("expenses.recurrences.#{@expense.recurrence_interval}") %></dd></div></dl>
  <% if @expense.notes.present? %><section class="mt-5 text-sm"><p class="text-xs font-bold uppercase text-stone-500"><%= t("customers.notes") %></p><p class="mt-1 whitespace-pre-line"><%= @expense.notes %></p></section><% end %>
  <footer class="mt-8 flex justify-between text-xs text-stone-500"><span><%= @expense.branch.name %></span><span><%= l(@expense.created_at, format: :short) %></span></footer>
</main>
