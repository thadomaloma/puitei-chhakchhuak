# Paste this into the Puitei Chhakchhuak service's Railway Variables raw editor.
# Service reference names assume the database is named Postgres and the bucket
# is named Uploads. Rename the namespaces below if your Railway services differ.

RAILS_ENV=production
RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=1
JOB_CONCURRENCY=1
SOLID_QUEUE_IN_PUMA=true
HTTP_PORT=8080

APP_HOST=${{RAILWAY_PUBLIC_DOMAIN}}
MAILER_FROM=notifications@example.com
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_STARTTLS=true

DATABASE_URL=${{Postgres.DATABASE_URL}}

ACTIVE_STORAGE_SERVICE=railway
AWS_ENDPOINT_URL=${{Uploads.ENDPOINT}}
AWS_ACCESS_KEY_ID=${{Uploads.ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{Uploads.SECRET_ACCESS_KEY}}
AWS_S3_BUCKET_NAME=${{Uploads.BUCKET}}
AWS_DEFAULT_REGION=${{Uploads.REGION}}
AWS_S3_URL_STYLE=virtual

# Add RAILS_MASTER_KEY separately as a sealed variable. Never commit its value.
